    -- Tween Function
    local function DoTween()
        if not currentTargetPos then return end
        local character = LocalPlayer.Character
        if not character or not character:FindFirstChild("HumanoidRootPart") then return end

        local hrp = character.HumanoidRootPart
        local distance = (hrp.Position - currentTargetPos).Magnitude
        local speed = 120
        local tweenTime = distance / speed

        local tweenInfo = TweenInfo.new(math.clamp(tweenTime, 0.5, 10), Enum.EasingStyle.Linear)
        local tween = TweenService:Create(hrp, tweenInfo, {CFrame = CFrame.new(currentTargetPos + Vector3.new(0, 3, 0))})
        
        tween:Play()
    end

    TweenBtn1.MouseButton1Click:Connect(DoTween)
    WorldTweenBtn.MouseButton1Click:Connect(DoTween)

