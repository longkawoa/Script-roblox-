    local function IsCompleteObject(obj)
        if obj:IsA("BasePart") or obj:IsA("Tool") or obj:IsA("Accoutrement") then
            return true
        end
        if obj:IsA("Model") and obj:FindFirstChildOfClass("Humanoid") then
            return true
        end
        if obj:IsA("Model") then
            if obj.PrimaryPart then return true end
            for _, child in pairs(obj:GetChildren()) do
                if child:IsA("BasePart") then return true end
            end
        end
        return false
    end

    local function IsCategoryContainer(obj)
        if IsCompleteObject(obj) then return false end
        if obj:IsA("Folder") or obj:IsA("ServiceProvider") then return true end
        if obj:IsA("Model") and #obj:GetChildren() > 0 then return true end
        return false
    end

    local function GetCategoryForObject(obj)
        if obj == LocalPlayer.Character or obj:IsDescendantOf(LocalPlayer.Character) or obj.Name == "MakeScript_NhatLong" then
            return nil
        end
        if obj:IsA("ServiceProvider") or (obj.Parent == game and obj ~= workspace) then
            return "Services", "⚙️"
        end
        if Players:GetPlayerFromCharacter(obj) then
            return "Players", "👤"
        end

        local rootAncestor = obj
        while rootAncestor.Parent and rootAncestor.Parent ~= workspace and rootAncestor.Parent ~= game do
            rootAncestor = rootAncestor.Parent
        end

        local rootNameLower = string.lower(rootAncestor.Name)

        -- Quét thông minh hỗ trợ tất cả Game Roblox (Blox Fruits, MM2, Pet Sim, King Legacy,...)
        if string.find(rootNameLower, "island") or string.find(rootNameLower, "map") or string.find(rootNameLower, "dao") or string.find(rootNameLower, "location") or string.find(rootNameLower, "world") then
            return "Đảo / Bản đồ", "🏝️"
        elseif string.find(rootNameLower, "enemy") or string.find(rootNameLower, "enemies") or string.find(rootNameLower, "mob") or string.find(rootNameLower, "boss") or string.find(rootNameLower, "monster") then
            return "Quái / Enemies", "⚔️"
        elseif string.find(rootNameLower, "npc") or string.find(rootNameLower, "quest") or string.find(rootNameLower, "dialogue") then
            return "NPCs / Giao tiếp", "🤖"
        elseif string.find(rootNameLower, "chest") or string.find(rootNameLower, "box") or string.find(rootNameLower, "crate") or string.find(rootNameLower, "loot") then
            return "Rương / Chests", "🎁"
        elseif string.find(rootNameLower, "fruit") or string.find(rootNameLower, "item") or string.find(rootNameLower, "drop") or string.find(rootNameLower, "weapon") or string.find(rootNameLower, "coin") then
            return "Vật phẩm / Items", "🍎"
        elseif string.find(rootNameLower, "tree") or string.find(rootNameLower, "foliage") or string.find(rootNameLower, "prop") then
            return "Cảnh quan / Props", "🌲"
        elseif obj:IsA("Model") and obj:FindFirstChildOfClass("Humanoid") then
            return "Nhân vật / Mobs", "👾"
        elseif rootAncestor:IsA("Folder") or rootAncestor:IsA("Model") then
            return rootAncestor.Name, "📁"
        end

        return "Khác (Other)", "📦"
    end

    RenderItemList = function(containerObj, parentName, onBackToParent)
        for _, child in pairs(GroupScroll:GetChildren()) do
            if child:IsA("TextButton") then child:Destroy() end
        end

        local backBtn = Instance.new("TextButton")
