    -- Camera 3D Orbit Render Functions
    local function UpdateCamera1()
        if not PreviewModelTab1 then return end
        local radX, radY = math.rad(cam1AngleX), math.rad(cam1AngleY)
        local x = cam1Dist * math.sin(radX) * math.cos(radY)
        local y = cam1Dist * math.sin(radY)
        local z = cam1Dist * math.cos(radX) * math.cos(radY)
        Camera1.CFrame = CFrame.new(cam1TargetCenter + Vector3.new(x, y, z), cam1TargetCenter)
    end

    local function UpdateCamera2()
        if not PreviewModelTab2 then return end
        local radX, radY = math.rad(cam2AngleX), math.rad(cam2AngleY)
        local x = cam2Dist * math.sin(radX) * math.cos(radY)
        local y = cam2Dist * math.sin(radY)
        local z = cam2Dist * math.cos(radX) * math.cos(radY)
        Camera2.CFrame = CFrame.new(cam2TargetCenter + Vector3.new(x, y, z), cam2TargetCenter)
    end

    ----------------------------------------------------
    -- SMART 3D PREVIEW
    ----------------------------------------------------
    local function Render3DPreview(target, tabIndex)
        pcall(function()
            if tabIndex == 1 and PreviewModelTab1 then PreviewModelTab1:Destroy() PreviewModelTab1 = nil end
            if tabIndex == 2 and PreviewModelTab2 then PreviewModelTab2:Destroy() PreviewModelTab2 = nil end

            local descendants = target:GetDescendants()
            local isHuge = #descendants > 1200
            
            local cf = CFrame.new()
            local size = Vector3.new(4, 4, 4)

            if target:IsA("BasePart") then
                cf = target.CFrame
                size = target.Size
            elseif target:IsA("Model") then
                cf, size = target:GetBoundingBox()
            end

            local maxDim = math.max(size.X, size.Y, size.Z)
            
            local wrapper = Instance.new("Model")
            local previewObj

            if isHuge or maxDim > 300 or target:IsA("Terrain") then
                local repPart = Instance.new("Part")
                repPart.Size = Vector3.new(math.clamp(size.X, 5, 50), math.clamp(size.Y, 5, 50), math.clamp(size.Z, 5, 50))
                repPart.CFrame = cf
                repPart.Material = Enum.Material.ForceField
                repPart.Color = Color3.fromRGB(0, 255, 170)
                repPart.Anchored = true
                previewObj = repPart
            else
                target.Archivable = true
                previewObj = target:Clone()
                
                for _, v in pairs(previewObj:GetDescendants()) do
                    if v:IsA("LuaSourceContainer") or v:IsA("Sound") or v:IsA("Camera") or v:IsA("ParticleEmitter") then
                        v:Destroy()
                    end
                end
            end

            if tabIndex == 1 then
                wrapper.Parent = Viewport1
                previewObj.Parent = wrapper
                PreviewModelTab1 = wrapper
            else
                wrapper.Parent = Viewport2
                previewObj.Parent = wrapper
                PreviewModelTab2 = wrapper
            end

            local center = cf.Position
            local dist = math.clamp(maxDim * 1.4, 6, 250)

            if tabIndex == 1 then
                cam1TargetCenter = center
                cam1Dist = dist
                cam1AngleX, cam1AngleY = 45, 20
                UpdateCamera1()
            else
                cam2TargetCenter = center
                cam2Dist = dist
                cam2AngleX, cam2AngleY = 45, 20
                UpdateCamera2()
            end
        end)
    end

    -- Orbit Controls Listeners
    Viewport1.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            isDraggingTab1 = true
            lastInputPos = input.Position
        end
    end)

    Viewport2.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            isDraggingTab2 = true
            lastInputPos = input.Position
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if not (isDraggingTab1 or isDraggingTab2) then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            local delta = input.Position - lastInputPos
            lastInputPos = input.Position
            local sensitivity = 0.6
            
            if isDraggingTab1 then
                cam1AngleX = cam1AngleX - (delta.X * sensitivity)
                cam1AngleY = math.clamp(cam1AngleY + (delta.Y * sensitivity), -80, 80)
                UpdateCamera1()
            elseif isDraggingTab2 then
                cam2AngleX = cam2AngleX - (delta.X * sensitivity)
                cam2AngleY = math.clamp(cam2AngleY + (delta.Y * sensitivity), -80, 80)
                UpdateCamera2()
            end
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            isDraggingTab1 = false
            isDraggingTab2 = false
        end
    end)

