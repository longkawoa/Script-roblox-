    local worldCategories = {}
    local RenderItemList

    local function IsCompleteObject(obj)
        if obj:IsA("BasePart") or obj:IsA("Tool") or obj:IsA("Accoutrement") then
            return true
        end
        if obj:IsA("Model") and obj:FindFirstChildOfClass("Humanoid") then
            return true
        end
        if obj:IsA("Model") then
            if obj.PrimaryPart then return true end
            for _, child in pairs(obj:GetChildren()) do
                if child:IsA("BasePart") then return true end
            end
        end
        return false
    end

    local function IsCategoryContainer(obj)
        if IsCompleteObject(obj) then return false end
        if obj:IsA("Folder") or obj:IsA("ServiceProvider") then return true end
        if obj:IsA("Model") and #obj:GetChildren() > 0 then return true end
        return false
    end

    local function GetCategoryForObject(obj)
        if obj == LocalPlayer.Character or obj:IsDescendantOf(LocalPlayer.Character) or obj.Name == "MakeScript_NhatLong" then
            return nil
        end
        if obj:IsA("ServiceProvider") or (obj.Parent == game and obj ~= workspace) then
            return "Services", "⚙️"
        end
        if Players:GetPlayerFromCharacter(obj) then
            return "Players", "👤"
        end

        local rootAncestor = obj
        while rootAncestor.Parent and rootAncestor.Parent ~= workspace and rootAncestor.Parent ~= game do
            rootAncestor = rootAncestor.Parent
        end

        local rootNameLower = string.lower(rootAncestor.Name)

        if string.find(rootNameLower, "island") or string.find(rootNameLower, "map") or string.find(rootNameLower, "dao") or string.find(rootNameLower, "location") then
            return "Đảo / Map", "🏝️"
        elseif string.find(rootNameLower, "enemy") or string.find(rootNameLower, "enemies") or string.find(rootNameLower, "mob") or string.find(rootNameLower, "boss") then
            return "Quái / Enemies", "⚔️"
        elseif string.find(rootNameLower, "npc") or string.find(rootNameLower, "quest") then
            return "NPCs", "🤖"
        elseif string.find(rootNameLower, "chest") or string.find(rootNameLower, "box") then
            return "Rương / Chests", "🎁"
        elseif string.find(rootNameLower, "fruit") or string.find(rootNameLower, "item") or string.find(rootNameLower, "drop") then
            return "Trái / Items", "🍎"
        elseif string.find(rootNameLower, "tree") or string.find(rootNameLower, "cay") or string.find(rootNameLower, "foliage") then
            return "Cây / Thực vật", "🌲"
        elseif obj:IsA("Model") and obj:FindFirstChildOfClass("Humanoid") then
            return "NPCs & Mobs", "👾"
        elseif rootAncestor:IsA("Folder") or rootAncestor:IsA("Model") then
            return rootAncestor.Name, "📁"
        end

        return "Khác (Other)", "📦"
    end

    RenderItemList = function(containerObj, parentName, onBackToParent)
        for _, child in pairs(GroupScroll:GetChildren()) do
            if child:IsA("TextButton") then child:Destroy() end
        end

        local backBtn = Instance.new("TextButton")
        backBtn.Size = UDim2.new(1, -4, 0, 24)
        backBtn.BackgroundColor3 = Color3.fromRGB(80, 40, 45)
        backBtn.Text = " ⬅ Trở về danh mục"
        backBtn.TextColor3 = Color3.fromRGB(255, 200, 200)
        backBtn.Font = Enum.Font.GothamBold
        backBtn.TextSize = 10
        backBtn.TextXAlignment = Enum.TextXAlignment.Left
        backBtn.Parent = GroupScroll

        local backCorner = Instance.new("UICorner")
        backCorner.CornerRadius = UDim.new(0, 5)
        backCorner.Parent = backBtn

        backBtn.MouseButton1Click:Connect(function()
            onBackToParent()
        end)

        local children = containerObj:GetChildren()
        for idx, item in ipairs(children) do
            local isSubCategory = IsCategoryContainer(item)
            local itemBtn = Instance.new("TextButton")
            itemBtn.Size = UDim2.new(1, -4, 0, 24)
            itemBtn.BackgroundColor3 = isSubCategory and Color3.fromRGB(45, 55, 75) or Color3.fromRGB(32, 48, 60)
            
            local prefix = isSubCategory and "📁 " or string.format("#%d: ", idx)
            itemBtn.Text = string.format(" %s%s", prefix, item.Name)
            itemBtn.TextColor3 = isSubCategory and Color3.fromRGB(255, 215, 0) or Color3.fromRGB(0, 220, 180)
            itemBtn.Font = Enum.Font.Gotham
            itemBtn.TextSize = 10
            itemBtn.TextXAlignment = Enum.TextXAlignment.Left
            itemBtn.Parent = GroupScroll

            local itemCorner = Instance.new("UICorner")
            itemCorner.CornerRadius = UDim.new(0, 5)
            itemCorner.Parent = itemBtn

            itemBtn.MouseButton1Click:Connect(function()
                if IsCategoryContainer(item) then
                    RenderItemList(item, item.Name, function()
                        RenderItemList(containerObj, parentName, onBackToParent)
                    end)
                else
                    local cf = CFrame.new()
                    if item:IsA("BasePart") then
                        cf = item.CFrame
                    elseif item:IsA("Model") then
                        cf = item:GetPivot()
                    end
                    
                    currentTargetPos = cf.Position

                    WorldInfoBox.Text = string.format(
                        "• Tên: %s\n• Danh mục: %s\n\n• Code Path:\n%s\n\n• Vector3:\n%.2f, %.2f, %.2f\n\n• CFrame:\n%s",
                        item.Name,
                        parentName,
                        item:GetFullName(),
                        currentTargetPos.X, currentTargetPos.Y, currentTargetPos.Z,
                        tostring(cf)
                    )

                    HighlightObject(item, parentName)
                    Render3DPreview(item, 2)
                end
            end)
        end
    end

    local function ScanWorldObjects()
        RefreshBtn.Text = "⏳ Loading..."
        RefreshBtn.BackgroundColor3 = Color3.fromRGB(150, 100, 30)

        for _, child in pairs(GroupScroll:GetChildren()) do
            if child:IsA("TextButton") then child:Destroy() end
        end
        
        worldCategories = {}

        task.delay(0.1, function()
            worldCategories["Services"] = {Icon = "⚙️", Items = {}}
            local servicesToScan = {ReplicatedStorage, Lighting, workspace, Players, game:GetService("ReplicatedFirst"), game:GetService("MaterialService")}
            for _, srv in pairs(servicesToScan) do
                if srv then
                    table.insert(worldCategories["Services"].Items, srv)
                end
            end

            for _, obj in pairs(workspace:GetChildren()) do
                if obj ~= LocalPlayer.Character and obj.Name ~= "MakeScript_NhatLong" then
                    local isContainer = IsCategoryContainer(obj)
                    
                    if isContainer then
                        for _, subObj in pairs(obj:GetChildren()) do
                            local catName, icon = GetCategoryForObject(subObj)
                            if catName then
                                if not worldCategories[catName] then
                                    worldCategories[catName] = {Icon = icon, Items = {}}
                                end
                                table.insert(worldCategories[catName].Items, subObj)
                            end
                        end
                    else
                        local catName, icon = GetCategoryForObject(obj)
                        if catName then
                            if not worldCategories[catName] then
                                worldCategories[catName] = {Icon = icon, Items = {}}
                            end
                            table.insert(worldCategories[catName].Items, obj)
                        end
                    end
                end
            end

            for catName, catData in pairs(worldCategories) do
                if #catData.Items > 0 then
                    local btn = Instance.new("TextButton")
                    btn.Size = UDim2.new(1, -4, 0, 26)
                    btn.BackgroundColor3 = Color3.fromRGB(38, 42, 54)
                    btn.Text = string.format(" %s %s (%d)", catData.Icon, catName, #catData.Items)
                    btn.TextColor3 = Color3.fromRGB(220, 225, 235)
                    btn.Font = Enum.Font.GothamBold
                    btn.TextSize = 10
                    btn.TextXAlignment = Enum.TextXAlignment.Left
                    btn.Parent = GroupScroll
                    
                    local btnCorner = Instance.new("UICorner")
                    btnCorner.CornerRadius = UDim.new(0, 5)
                    btnCorner.Parent = btn
                    
                    btn.MouseButton1Click:Connect(function()
                        local virtualRoot = {
                            GetChildren = function() return catData.Items end
                        }
                        RenderItemList(virtualRoot, catName, ScanWorldObjects)
                    end)
                end
            end

            RefreshBtn.Text = "🔄 Scan World"
            RefreshBtn.BackgroundColor3 = Color3.fromRGB(45, 90, 180)
        end)
    end

