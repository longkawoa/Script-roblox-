    ------------------------------------------------------------
    -- NOTIFICATION SYSTEM
    ------------------------------------------------------------

    function window:Notify(title, message, duration)
        if not Library.Settings.Notifications then
            return
        end

        duration = duration or 3

        local holder = New("Frame", {
            Name = "Notification",

            Size = UDim2.fromOffset(
                280,
                70
            ),

            Position = UDim2.new(
                1,
                20,
                1,
                -90
            ),

            AnchorPoint = Vector2.new(
                0,
                1
            ),

            BackgroundColor3 =
                Library.Theme.Secondary,

            BackgroundTransparency =
                getTransparency("Secondary"),

            BorderSizePixel = 0,

            ZIndex = 200,
        }, ScreenGui)

        Corner(
            holder,
            Library.Settings.CornerRadius
        )

        Stroke(
            holder,
            Library.Theme.Border,
            1
        )

        window:RegisterTheme(
            holder,
            "Secondary"
        )

        local accentBar = New("Frame", {
            Size = UDim2.new(
                0,
                4,
                1,
                0
            ),

            BackgroundColor3 =
                Library.Theme.Accent,

            BorderSizePixel = 0,

            ZIndex = 201,
        }, holder)

        Corner(
            accentBar,
            Library.Settings.CornerRadius
        )

        window:RegisterTheme(
            accentBar,
            "Accent"
        )

        local titleLabel = New("TextLabel", {
            Size = UDim2.new(
                1,
                -30,
                0,
                25
            ),

            Position = UDim2.fromOffset(
                16,
                8
            ),

            BackgroundTransparency = 1,

            Font = Enum.Font.GothamBold,

            Text = tostring(title),

            TextColor3 =
                Library.Theme.Text,

            TextSize = 13,

            TextXAlignment =
                Enum.TextXAlignment.Left,

            ZIndex = 202,
        }, holder)

        window:RegisterTheme(
            titleLabel,
            "Text"
        )

        local messageLabel = New("TextLabel", {
            Size = UDim2.new(
                1,
                -30,
                0,
                25
            ),

            Position = UDim2.fromOffset(
                16,
                34
            ),

            BackgroundTransparency = 1,

            Font = Enum.Font.Gotham,

            Text = tostring(message or ""),

            TextColor3 =
                Library.Theme.SubText,

            TextSize = 11,

            TextXAlignment =
                Enum.TextXAlignment.Left,

            TextTruncate =
                Enum.TextTruncate.AtEnd,

            ZIndex = 202,
        }, holder)

        window:RegisterTheme(
            messageLabel,
            "SubText"
        )

        Tween(
            holder,
            {
                Position = UDim2.new(
                    1,
                    -15,
                    1,
                    -90
                ),
            },
            0.25
        )

        task.delay(
            duration,
            function()
                if holder and holder.Parent then
                    Tween(
                        holder,
                        {
                            Position =
                                UDim2.new(
                                    1,
                                    20,
                                    1,
                                    -90
                                )
                        },
                        0.2
                    )

                    task.wait(0.25)

                    if holder then
                        holder:Destroy()
                    end
                end
            end
        )
    end

    ------------------------------------------------------------
    -- LANGUAGE UPDATE SUPPORT
    ------------------------------------------------------------

    local originalRefreshLanguage =
        window.RefreshLanguage

    function window:RefreshLanguage()
        if self.SearchBox then
            self.SearchBox.PlaceholderText =
                self:T("Search")
        end

        -- Update built-in setting tab.
        if self.SettingTab then
            self.SettingTab.Button.Text =
                "⚙   "
                .. self:T("Setting")
        end

        -- Update Setting section titles.
        if self.SettingTab then
            for _, section in ipairs(
                self.SettingTab.Sections
            ) do
                local page = section

                for _, child in ipairs(
                    self.SettingTab.Page:GetChildren()
                ) do
                    if child:IsA("Frame") then
                        local title =
                            child:FindFirstChild(
                                "SectionTitle"
                            )

                        if title then
                            local name =
                                child.Name

                            if string.find(
                                name,
                                "Theme"
                            ) then
                                title.Text =
                                    self:T("Theme")
                            elseif string.find(
                                name,
                                "Menu"
                            ) then
                                title.Text =
                                    self:T("MenuSize")
                            elseif string.find(
                                name,
                                "Behavior"
                            ) then
                                title.Text =
                                    self:T("Behavior")
                            elseif string.find(
                                name,
                                "Performance"
                            ) then
                                title.Text =
                                    self:T("Performance")
                            end
                        end
                    end
                end
            end
        end

        self:RefreshStats()
    end

    ------------------------------------------------------------
    -- INITIAL TAB SELECTION
    ------------------------------------------------------------

    local hasNormalTab = false

    for _, tab in ipairs(window.Tabs) do
        if not tab.IsSetting then
            hasNormalTab = true
            break
        end
    end

    if not hasNormalTab then
        window:SelectTab(settingTab)
    end

    ------------------------------------------------------------
    -- DEFAULT FIRST USER TAB
    ------------------------------------------------------------

    function window:_AutoSelectFirstUserTab()
        for _, tab in ipairs(self.Tabs) do
            if not tab.IsSetting then
                self:SelectTab(tab)
                return
            end
        end

        self:SelectTab(self.SettingTab)
    end

    ------------------------------------------------------------
    -- REORDER SETTING
    ------------------------------------------------------------

    function window:KeepSettingLast()
        if self.SettingTab then
            self.SettingTab.Button.LayoutOrder =
                1000000

            self.SettingTab.LayoutOrder =
                1000000
        end

        local order = 1

        for _, tab in ipairs(self.Tabs) do
            if not tab.IsSetting then
                tab.LayoutOrder = order
                tab.Button.LayoutOrder = order
                order += 1
            end
        end
    end

    ------------------------------------------------------------
    -- OVERRIDE CREATE TAB TO KEEP SETTING LAST
    ------------------------------------------------------------

    local originalCreateTab = window.CreateTab

    window.CreateTab = function(selfWindow, ...)
        local tab = originalCreateTab(
            selfWindow,
            ...
        )

        selfWindow:KeepSettingLast()

        if not tab.IsSetting
            and not selfWindow.ActiveTab then

            selfWindow:SelectTab(tab)
        end

        return tab
    end

    window:KeepSettingLast()

    ------------------------------------------------------------
    -- FIX SETTING TAB LABEL AFTER LANGUAGE
    ------------------------------------------------------------

    function window:SetLanguage(language)
        Library:SetLanguage(language)
    end

    ------------------------------------------------------------
    -- REFRESH
    ------------------------------------------------------------

    function window:Refresh()
        self:FitToScreen()
        self:RefreshTheme()
        self:RefreshLanguage()
    end

    ------------------------------------------------------------
    -- DESTROY
    ------------------------------------------------------------

    function window:Destroy()
        if self.Destroyed then
            return
        end

        self.Destroyed = true

        for _, connection in ipairs(
            self.Connections
        ) do
            pcall(function()
                connection:Disconnect()
            end)
        end

        self.Connections = {}

        if self.ScreenGui then
            self.ScreenGui:Destroy()
        end

        for index, item in ipairs(
            Library.Windows
        ) do
            if item == self then
                table.remove(
                    Library.Windows,
                    index
                )

                break
            end
        end
    end

    ------------------------------------------------------------
    -- INITIAL FIT
    ------------------------------------------------------------

    window:FitToScreen()

    -- Main centered exactly like reference layout.
    Main.Position = UDim2.fromScale(
        0.5,
        0.5
    )

    Main.AnchorPoint =
        Vector2.new(0.5, 0.5)

    ------------------------------------------------------------
    -- INITIAL TAB
    ------------------------------------------------------------

    -- Setting is last.
    -- If user creates a normal tab later, it automatically
    -- becomes the first active tab.
    window:SelectTab(settingTab)

    return window
end

----------------------------------------------------------------
-- GLOBAL REFRESH
----------------------------------------------------------------

function Library:RefreshAll()
    for _, window in ipairs(self.Windows) do
        if window and not window.Destroyed then
            window:Refresh()
        end
    end
end

----------------------------------------------------------------
-- VALUE SYSTEM
----------------------------------------------------------------

function Library:SetValue(key, value)
    self.Values[key] = value
end

function Library:GetValue(key, default)
    if self.Values[key] == nil then
        return default
    end

    return self.Values[key]
end

----------------------------------------------------------------
-- WINDOW CONTROL
----------------------------------------------------------------

function Library:GetWindow()
    for _, window in ipairs(self.Windows) do
        if window and not window.Destroyed then
            return window
        end
    end

    return nil
end

function Library:Toggle()
    local window = self:GetWindow()

    if window then
        window:Toggle()
    end
end

function Library:Show()
    local window = self:GetWindow()

    if window then
        window:Show()
    end
end

function Library:Hide()
    local window = self:GetWindow()

    if window then
        window:Hide()
    end
end

----------------------------------------------------------------
-- GLOBAL KEYBIND
-- Default: RightShift
----------------------------------------------------------------

Library.ToggleKey = Enum.KeyCode.RightShift

local globalKeyConnection

globalKeyConnection = UserInputService.InputBegan:Connect(
    function(input, processed)
        if processed then
            return
        end

        if input.UserInputType
            == Enum.UserInputType.Keyboard
            and input.KeyCode == Library.ToggleKey then

            Library:Toggle()
        end
    end
)

table.insert(
    Library._connections,
    globalKeyConnection
)

----------------------------------------------------------------
-- DESTROY / UNLOAD
----------------------------------------------------------------

function Library:Destroy()
    for _, window in ipairs(
        table.clone(self.Windows)
    ) do
        if window then
            window:Destroy()
        end
    end

    self.Windows = {}

    for _, connection in ipairs(
        self._connections
    ) do
        pcall(function()
            connection:Disconnect()
        end)
    end

    self._connections = {}
end

function Library:Unload()
    self:Destroy()
end

----------------------------------------------------------------
-- OPTIONAL QUICK CONFIG API
----------------------------------------------------------------

function Library:SetMenuSize(width, height)
    self.Settings.MenuWidth =
        clamp(
            safeNumber(width, self.Settings.MenuWidth),
            300,
            1600
        )

    self.Settings.MenuHeight =
        clamp(
            safeNumber(height, self.Settings.MenuHeight),
            260,
            1000
        )

    self:RefreshAll()
end

function Library:SetCornerRadius(radius)
    self.Settings.CornerRadius =
        clamp(
            safeNumber(radius, 10),
            0,
            30
        )

    self:RefreshAll()
end

function Library:SetScale(scale)
    self.Settings.UIScale =
        clamp(
            safeNumber(scale, 100),
            60,
            150
        )

    for _, window in ipairs(self.Windows) do
        if window and not window.Destroyed then
            window:SetScale(
                self.Settings.UIScale
            )
        end
    end
end

function Library:SetToggleKey(key)
    if typeof(key) == "EnumItem"
        and key.EnumType == Enum.KeyCode then

        self.ToggleKey = key
    end
end

----------------------------------------------------------------
-- RETURN
----------------------------------------------------------------

return Library
