            function section:CreateSlider(text, min, max, default, callback)
                min = safeNumber(min, 0)
                max = safeNumber(max, 100)

                if max <= min then
                    max = min + 1
                end

                local value = clamp(
                    safeNumber(default, min),
                    min,
                    max
                )

                local holder = New("Frame", {
                    Name = "Slider",

                    Size = UDim2.new(
                        1,
                        0,
                        0,
                        62
                    ),

