----------------------------------------------------------------
-- INTERNAL
----------------------------------------------------------------

Library.Windows = {}
Library.Values = {}
Library._connections = {}

local function clamp(v, min, max)
    return math.max(min, math.min(max, v))
end

local function safeNumber(v, fallback)
    v = tonumber(v)
    if not v then
        return fallback
    end
    return v
end

local function safeColor(r, g, b)
    return Color3.fromRGB(
        clamp(math.floor(r or 0), 0, 255),
        clamp(math.floor(g or 0), 0, 255),
        clamp(math.floor(b or 0), 0, 255)
    )
end

local function getText(obj)
    if obj:IsA("TextLabel")
        or obj:IsA("TextButton")
        or obj:IsA("TextBox") then
        return obj.Text
    end

    return ""
end

----------------------------------------------------------------
-- TRANSLATION
----------------------------------------------------------------

function Library:Translate(key)
    local lang = self.Settings.Language
    local data = self.Languages[lang]

    if data and data[key] then
        return data[key]
    end

    if self.Languages.English[key] then
        return self.Languages.English[key]
    end

    return key
end

function Library:SetLanguage(language)
    if not self.Languages[language] then
        return false
    end

    self.Settings.Language = language

    for _, window in ipairs(self.Windows) do
        if window and not window.Destroyed then
            window:RefreshLanguage()
        end
    end

    return true
end

----------------------------------------------------------------
-- THEME
----------------------------------------------------------------

function Library:SetTheme(themeName)
    local preset = self.ThemePresets[themeName]

    if not preset then
        return false
    end

    self.Settings.ThemePreset = themeName

    for key, value in pairs(preset) do
        self.Theme[key] = value
    end

    -- Keep manually selected accent color
    local accent = self.AccentPresets[self.Settings.AccentPreset]

    if accent then
        self.Theme.Accent = accent
    end

    self:RefreshAll()

    return true
end

function Library:SetAccentColor(colorName)
    local color = self.AccentPresets[colorName]

    if not color then
        return false
    end

    self.Settings.AccentPreset = colorName
    self.Theme.Accent = color

    self:RefreshAll()

    return true
end

function Library:SetGlassMode(enabled, transparency)
    self.Settings.GlassMode = enabled == true

    if transparency then
        self.Settings.GlassTransparency = clamp(
            tonumber(transparency) or 0.18,
            0,
            0.8
        )
    end

    self:RefreshAll()
end

----------------------------------------------------------------
-- UI HELPERS
----------------------------------------------------------------

local function New(className, properties, parent)
    local object = Instance.new(className)

    for property, value in pairs(properties or {}) do
        pcall(function()
            object[property] = value
        end)
    end

    if parent then
        object.Parent = parent
    end

    return object
end

local function Corner(object, radius)
    local corner = object:FindFirstChildOfClass("UICorner")

    if not corner then
        corner = Instance.new("UICorner")
        corner.Parent = object
    end

    corner.CornerRadius = UDim.new(0, radius)

    return corner
end

local function Stroke(object, color, thickness, transparency)
    local stroke = object:FindFirstChildOfClass("UIStroke")

    if not stroke then
        stroke = Instance.new("UIStroke")
        stroke.Parent = object
    end

    stroke.Color = color
    stroke.Thickness = thickness or 1
    stroke.Transparency = transparency or 0

    return stroke
end

local function Tween(object, properties, duration)
    if not object then
        return
    end

    duration = duration or Library.Settings.AnimationSpeed

    if duration <= 0 then
        for property, value in pairs(properties) do
            pcall(function()
                object[property] = value
            end)
        end

        return
    end

    local tween = TweenService:Create(
        object,
        TweenInfo.new(
            duration,
            Enum.EasingStyle.Quart,
            Enum.EasingDirection.Out
        ),
        properties
    )

    tween:Play()

    return tween
end

local function getTransparency(role)
    if not Library.Settings.GlassMode then
        return 0
    end

    local value = Library.Settings.GlassTransparency

    if role == "Background" then
        return value
    elseif role == "Secondary" then
        return math.min(value + 0.08, 0.85)
    elseif role == "Tertiary" then
        return math.min(value + 0.04, 0.85)
    end

    return 0
end

