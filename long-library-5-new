local WindowObject = {}
WindowObject.__index = WindowObject

function WindowObject:T(key)
    return Library:Translate(key)
end

function WindowObject:RegisterTheme(object, role)
    if not object then
        return
    end

    object:SetAttribute("LONGThemeRole", role)

    table.insert(self.ThemeObjects, {
        Object = object,
        Role = role,
    })

    self:ApplyThemeObject(object, role)
end

function WindowObject:ApplyThemeObject(object, role)
    if not object or not object.Parent then
        return
    end

    local color = Library.Theme[role]

    if not color then
        return
    end

    if object:IsA("Frame")
        or object:IsA("ScrollingFrame")
        or object:IsA("TextButton")
        or object:IsA("TextBox") then

        object.BackgroundColor3 = color
        object.BackgroundTransparency = getTransparency(role)
    end

    if object:IsA("TextLabel")
        or object:IsA("TextButton")
        or object:IsA("TextBox") then

        if role == "Text" then
            object.TextColor3 = Library.Theme.Text
        elseif role == "SubText" then
            object.TextColor3 = Library.Theme.SubText
        elseif role == "Accent" then
            object.TextColor3 = Library.Theme.Accent
        end
    end

    local stroke = object:FindFirstChildOfClass("UIStroke")

    if stroke then
        if role == "Border" then
            stroke.Color = Library.Theme.Border
        else
            stroke.Color = Library.Theme.Border
        end
    end
end

function WindowObject:RefreshTheme()
    for i = #self.ThemeObjects, 1, -1 do
        local data = self.ThemeObjects[i]

        if data.Object and data.Object.Parent then
            self:ApplyThemeObject(data.Object, data.Role)
        else
            table.remove(self.ThemeObjects, i)
        end
    end

    for _, corner in ipairs(self.Main:GetDescendants()) do
        if corner:IsA("UICorner") then
            corner.CornerRadius = UDim.new(
                0,
                Library.Settings.CornerRadius
            )
        end
    end
end

function WindowObject:RefreshLanguage()
    if self.SearchBox then
        self.SearchBox.PlaceholderText = self:T("Search")
    end

    if self.SettingTabButton then
        self.SettingTabButton.Text = "⚙  " .. self:T("Setting")
    end

    for _, item in ipairs(self.LanguageLabels) do
        if item.Update then
            pcall(item.Update)
        end
    end

    self:RefreshStats()
end

function WindowObject:RefreshStats()
    if not self.StatsLabel then
        return
    end

    local pieces = {}

    if Library.Settings.ShowFPS then
        table.insert(
            pieces,
            self:T("FPS") .. ": " .. tostring(self.FPS or 0)
        )
    end

    if Library.Settings.ShowPing then
        local ping = 0

        pcall(function()
            ping = math.floor(
                Stats.Network.ServerStatsItem[
                    "Data Ping"
                ]:GetValue()
            )
        end)

        table.insert(
            pieces,
            self:T("Ping") .. ": " .. tostring(ping) .. "ms"
        )
    end

    if Library.Settings.ShowClock then
        table.insert(
            pieces,
            os.date("%H:%M:%S")
        )
    end

    self.StatsLabel.Text = table.concat(pieces, "   •   ")
end

function WindowObject:ClampPosition()
    if not self.Main or not self.Main.Parent then
        return
    end

    local camera = workspace.CurrentCamera

    if not camera then
        return
    end

    local viewport = camera.ViewportSize
    local absolute = self.Main.AbsoluteSize

    local x = self.Main.Position.X.Offset
    local y = self.Main.Position.Y.Offset

    local maxX = math.max(
        10,
        viewport.X - absolute.X / math.max(self.UIScale.Scale, 0.01) - 10
    )

    local maxY = math.max(
        10,
        viewport.Y - absolute.Y / math.max(self.UIScale.Scale, 0.01) - 10
    )

    if self.Main.AnchorPoint == Vector2.new(0.5, 0.5) then
        self.Main.Position = UDim2.fromScale(0.5, 0.5)
        return
    end

    self.Main.Position = UDim2.new(
        0,
        clamp(x, 10, maxX),
        0,
        clamp(y, 10, maxY)
    )
end

function WindowObject:FitToScreen()
    if not self.Main then
        return
    end

    local camera = workspace.CurrentCamera

    if not camera then
        return
    end

    local viewport = camera.ViewportSize

    local maxWidth = math.max(
        300,
        viewport.X - 30
    )

    local maxHeight = math.max(
        260,
        viewport.Y - 30
    )

    local width = math.min(
        Library.Settings.MenuWidth,
        maxWidth
    )

    local height = math.min(
        Library.Settings.MenuHeight,
        maxHeight
    )

    local sidebar = math.min(
        Library.Settings.SidebarWidth,
        width * 0.35
    )

    self.Main.Size = UDim2.fromOffset(
        width,
        height
    )

    self.Sidebar.Size = UDim2.new(
        0,
        sidebar,
        1,
        0
    )

    self.Content.Position = UDim2.new(
        0,
        sidebar,
        0,
        44
    )

    self.Content.Size = UDim2.new(
        1,
        -sidebar,
        1,
        -44
    )

    self:ClampPosition()
end

function WindowObject:SetSize(width, height)
    width = clamp(
        safeNumber(width, Library.Settings.MenuWidth),
        300,
        1600
    )

    height = clamp(
        safeNumber(height, Library.Settings.MenuHeight),
        260,
        1000
    )

    Library.Settings.MenuWidth = width
    Library.Settings.MenuHeight = height

    self:FitToScreen()
end

function WindowObject:SetScale(scale)
    scale = clamp(
        safeNumber(scale, 100),
        60,
        150
    )

    Library.Settings.UIScale = scale
    self.UIScale.Scale = scale / 100

    task.defer(function()
        self:ClampPosition()
    end)
end

function WindowObject:SetSidebarWidth(width)
    width = clamp(
        safeNumber(width, Library.Settings.SidebarWidth),
        100,
        300
    )

    Library.Settings.SidebarWidth = width
    self:FitToScreen()
end

function WindowObject:Show()
    self.Main.Visible = true

    if self.FloatingButton then
        self.FloatingButton.Visible = false
    end
end

function WindowObject:Hide()
    self.Main.Visible = false

    if self.FloatingButton
        and Library.Settings.FloatingButton then

        self.FloatingButton.Visible = true
    end
end

function WindowObject:Toggle()
    if self.Main.Visible then
        self:Hide()
    else
        self:Show()
    end
end

function WindowObject:Restore()
    self.Minimized = false
    self.Content.Visible = true

    self.Main.Size = UDim2.fromOffset(
        Library.Settings.MenuWidth,
        Library.Settings.MenuHeight
    )

    self:FitToScreen()
end

function WindowObject:Minimize()
    if self.Minimized then
        self:Restore()
        return
    end

    self.Minimized = true
    self.Content.Visible = false

    self.Main.Size = UDim2.fromOffset(
        Library.Settings.MenuWidth,
        44
    )
end

