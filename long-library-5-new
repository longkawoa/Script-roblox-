                )

                local label = New("TextLabel", {
                    Size = UDim2.new(
                        1,
                        -80,
                        0,
                        25
                    ),

                    Position = UDim2.fromOffset(12, 4),

                    BackgroundTransparency = 1,

                    Font = Enum.Font.GothamMedium,

                    Text = tostring(text or "Slider"),

                    TextColor3 = Library.Theme.Text,
                    TextSize = 13,

                    TextXAlignment = Enum.TextXAlignment.Left,
                }, holder)

                window:RegisterTheme(
                    label,
                    "Text"
                )

                local valueLabel = New("TextLabel", {
                    Size = UDim2.fromOffset(
                        65,
                        25
                    ),

                    Position = UDim2.new(
                        1,
                        -70,
                        0,
                        4
                    ),

                    BackgroundTransparency = 1,

                    Font = Enum.Font.GothamBold,

                    Text = tostring(value),

                    TextColor3 = Library.Theme.Accent,
                    TextSize = 13,

                    TextXAlignment = Enum.TextXAlignment.Right,
                }, holder)

                window:RegisterTheme(
                    valueLabel,
                    "Accent"
                )

                local bar = New("Frame", {
                    Size = UDim2.new(
                        1,
                        -24,
                        0,
                        6
                    ),

                    Position = UDim2.new(
                        0,
                        12,
                        0,
                        43
                    ),

                    BackgroundColor3 = Library.Theme.SliderBackground,

                    BorderSizePixel = 0,
                }, holder)

                Corner(bar, 6)

                window:RegisterTheme(
                    bar,
                    "SliderBackground"
                )

                local fill = New("Frame", {
                    Size = UDim2.new(
                        (value - min) / (max - min),
                        0,
                        1,
                        0
                    ),

                    BackgroundColor3 = Library.Theme.Accent,

                    BorderSizePixel = 0,
                }, bar)

                Corner(fill, 6)

                window:RegisterTheme(
                    fill,
                    "Accent"
                )

                local hitbox = New("TextButton", {
                    Size = UDim2.new(
                        1,
                        0,
                        0,
                        25
                    ),

                    Position = UDim2.new(
                        0,
                        0,
                        0,
                        33
                    ),

                    BackgroundTransparency = 1,

                    Text = "",
                }, holder)

                local dragging = false

                local function setValue(inputX)
                    local relative = clamp(
                        inputX - bar.AbsolutePosition.X,
                        0,
                        bar.AbsoluteSize.X
                    )

                    local percent = 0

                    if bar.AbsoluteSize.X > 0 then
                        percent = relative / bar.AbsoluteSize.X
                    end

                    value = min + (max - min) * percent

                    if math.abs(max - min) <= 1000 then
                        value = math.floor(value + 0.5)
                    else
                        value = math.floor(value * 100) / 100
                    end

                    fill.Size = UDim2.new(
                        percent,
                        0,
                        1,
                        0
                    )

                    valueLabel.Text = tostring(value)

                    if callback then
                        task.spawn(function()
                            pcall(callback, value)
                        end)
                    end
                end

                hitbox.InputBegan:Connect(function(input)
                    if input.UserInputType
                        == Enum.UserInputType.MouseButton1
                        or input.UserInputType
                        == Enum.UserInputType.Touch then

                        dragging = true
                        setValue(input.Position.X)
                    end
                end)

                hitbox.InputEnded:Connect(function(input)
                    if input.UserInputType
                        == Enum.UserInputType.MouseButton1
                        or input.UserInputType
                        == Enum.UserInputType.Touch then

                        dragging = false
                    end
                end)

                UserInputService.InputChanged:Connect(function(input)
                    if dragging then
                        if input.UserInputType
                            == Enum.UserInputType.MouseMovement
                            or input.UserInputType
                            == Enum.UserInputType.Touch then

                            setValue(input.Position.X)
                        end
                    end
                end)

                return {
                    Set = function(_, newValue)
                        value = clamp(
                            safeNumber(newValue, min),
                            min,
                            max
                        )

                        local percent =
                            (value - min) / (max - min)

                        fill.Size = UDim2.new(
                            percent,
                            0,
                            1,
                            0
                        )

                        valueLabel.Text = tostring(value)

                        if callback then
                            task.spawn(function()
                                pcall(callback, value)
                            end)
                        end
                    end,

                    Get = function()
                        return value
                    end,
                }
            end

