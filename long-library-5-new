                        Library.Theme.Tertiary,

                    BorderSizePixel = 0,

                    AutoButtonColor = false,

                    Font = Enum.Font.GothamMedium,

                    Text =
                        tostring(text)
                        .. ": "
                        .. currentKey.Name,

                    TextColor3 = Library.Theme.Text,
                    TextSize = 13,

                    TextXAlignment =
                        Enum.TextXAlignment.Left,

                    LayoutOrder = 80,
                }, Frame)

                Corner(
                    button,
                    Library.Settings.CornerRadius
                )

                window:RegisterTheme(
                    button,
                    "Tertiary"
                )

                New("UIPadding", {
                    PaddingLeft = UDim.new(0, 12),
                    PaddingRight = UDim.new(0, 12),
                }, button)

                local listening = false

                button.MouseButton1Click:Connect(function()
                    listening = true

                    button.Text =
                        tostring(text)
                        .. ": ..."
                end)

                local connection = UserInputService.InputBegan:Connect(
                    function(input, processed)
                        if processed then
                            return
                        end

                        if listening then
                            if input.UserInputType
                                == Enum.UserInputType.Keyboard then

                                currentKey = input.KeyCode
                                listening = false

                                button.Text =
                                    tostring(text)
                                    .. ": "
                                    .. currentKey.Name

                                if callback then
                                    task.spawn(function()
                                        pcall(
                                            callback,
                                            currentKey
                                        )
                                    end)
                                end
                            end

                            return
                        end

                        if input.UserInputType
                            == Enum.UserInputType.Keyboard
                            and input.KeyCode == currentKey then

                            if callback then
                                task.spawn(function()
                                    pcall(
                                        callback,
                                        currentKey
                                    )
                                end)
                            end
                        end
                    end
                )

                table.insert(
                    window.Connections,
                    connection
                )

                return {
                    Set = function(_, key)
                        if typeof(key) == "EnumItem" then
                            currentKey = key

                            button.Text =
                                tostring(text)
                                .. ": "
                                .. currentKey.Name
                        end
                    end,

                    Get = function()
                        return currentKey
                    end,
                }
            end

