    function window:SelectTab(tab)
        for _, item in ipairs(self.Tabs) do
            local active = item == tab

            item.Page.Visible = active

            if active then
                item.Button.BackgroundColor3 =
                    Library.Theme.Accent

                item.Button.TextColor3 =
                    Color3.new(1, 1, 1)
            else
                item.Button.BackgroundColor3 =
                    Library.Theme.Tertiary

                item.Button.TextColor3 =
                    Library.Theme.Text
            end
        end

        self.ActiveTab = tab
    end

