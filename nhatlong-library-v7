        local function AddRGB(
            themeKey,
            translationKey
        )

            ColorSection:CreateTextbox(
                Library:GetText(
                    translationKey
                ),
                Library:GetText(
                    "RGBPlaceholder"
                ),
                function(text)

                    local r, g, b =
                        string.match(
                            text,
                            "(%d+)%s*,%s*(%d+)%s*,%s*(%d+)"
                        )

                    if r and g and b then

                        Library:SetColor(
                            themeKey,
                            tonumber(r),
                            tonumber(g),
                            tonumber(b)
                        )
                    end
                end
            )
        end

