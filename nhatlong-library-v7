        --==================================================
        -- NOTIFICATIONS
        --==================================================

        function WindowObject:Notify(
            title,
            message,
            duration
        )

            if not Library.Settings.Notifications then
                return
            end

            duration =
                duration or 3

            local Holder =
                ScreenGui:FindFirstChild(
                    "Notifications"
                )

            if not Holder then

                Holder = New(
                    "Frame",
                    {
                        Name = "Notifications",

                        Position =
                            UDim2.new(
                                1,
                                -20,
                                0,
                                20
                            ),

                        AnchorPoint =
                            Vector2.new(1, 0),

                        Size =
                            UDim2.fromOffset(
                                320,
                                450
                            ),

                        BackgroundTransparency = 1
                    },
                    ScreenGui
                )

                New(
                    "UIListLayout",
                    {
                        Padding =
                            UDim.new(0, 8),

                        HorizontalAlignment =
                            Enum.HorizontalAlignment.Right,

                        VerticalAlignment =
                            Enum.VerticalAlignment.Top
                    },
                    Holder
                )
            end

            local Notification = New(
                "Frame",
                {
                    Size =
                        UDim2.fromOffset(
                            300,
                            72
                        ),

                    BackgroundColor3 =
                        Library.Theme.Secondary,

                    BackgroundTransparency =
                        Library.Theme.Transparency,

                    BorderSizePixel = 0
                },
                Holder
            )

            Corner(Notification, 9)

            Stroke(
                Notification,
                Library.Theme.Border
            )

            local TitleLabel = New(
                "TextLabel",
                {
                    Position =
                        UDim2.fromOffset(12, 8),

                    Size =
                        UDim2.new(
                            1,
                            -24,
                            0,
                            20
                        ),

                    BackgroundTransparency = 1,

                    Text = title,

                    Font =
                        Enum.Font.GothamBold,

                    TextSize = 13,

                    TextColor3 =
                        Library.Theme.Accent,

                    TextXAlignment =
                        Enum.TextXAlignment.Left
                },
                Notification
            )

            local MessageLabel = New(
                "TextLabel",
                {
                    Position =
                        UDim2.fromOffset(12, 29),

                    Size =
                        UDim2.new(
                            1,
                            -24,
                            0,
                            35
                        ),

                    BackgroundTransparency = 1,

                    Text = message,

                    Font =
                        Enum.Font.Gotham,

                    TextSize = 11,

                    TextColor3 =
                        Library.Theme.Text,

                    TextWrapped = true,

                    TextXAlignment =
                        Enum.TextXAlignment.Left,

                    TextYAlignment =
                        Enum.TextYAlignment.Top
                },
                Notification
            )

            task.delay(
                duration,
                function()

                    if Notification
                        and Notification.Parent then

                        Tween(
                            Notification,
                            {
                                BackgroundTransparency = 1
                            },
                            0.2
                        )

                        task.wait(0.22)

                        if Notification then
                            Notification:Destroy()
                        end
                    end
                end
            )
        end

        --==================================================
        -- WINDOW API
        --==================================================

        function WindowObject:SetTitle(title)

            WindowObject.Title = title
            Title.Text = title
            Watermark.Text = title
        end

        function WindowObject:SetSubtitle(subtitle)

            WindowObject.Subtitle = subtitle
            Subtitle.Text = subtitle
        end

        function WindowObject:SetSize(width, height)

            Library.Settings.MenuWidth =
                math.clamp(
                    tonumber(width) or 507,
                    400,
                    1200
                )

            Library.Settings.MenuHeight =
                math.clamp(
                    tonumber(height) or 384,
                    280,
                    900
                )

            WindowObject:Refresh()
        end

        function WindowObject:SetSidebarWidth(width)

            Library.Settings.SidebarWidth =
                math.clamp(
                    tonumber(width) or 145,
                    100,
                    300
                )

            WindowObject:Refresh()
        end

        function WindowObject:SetScale(scale)

            Library.Settings.UIScale =
                math.clamp(
                    tonumber(scale) or 100,
                    70,
                    130
                )

            WindowObject:Refresh()
        end

        function WindowObject:SetTransparency(value)

            value =
                math.clamp(
                    tonumber(value) or 57,
                    0,
                    90
                )

            Library.Settings.GlassTransparency =
                value

            Library.Settings.GlassMode =
                true

            Library.Theme.Transparency =
                value / 100

            WindowObject:Refresh()
        end

        function WindowObject:SetTheme(theme)

            Library:SetTheme(theme)
        end

        function WindowObject:SetAccent(accent)

            Library:SetAccent(accent)
        end

        function WindowObject:SetLanguage(language)

            Library:SetLanguage(language)
        end

        function WindowObject:Show()

            Main.Visible = true
            FloatingButton.Visible = false
        end

        function WindowObject:Hide()

            Main.Visible = false

            if Library.Settings.FloatingButton then
                FloatingButton.Visible = true
            end
        end

        function WindowObject:Toggle()

            if Main.Visible then
                self:Hide()
            else
                self:Show()
            end
        end

        function WindowObject:GetCurrentTab()

            return WindowObject.CurrentTab
        end

        --==================================================
        -- INITIAL REFRESH
        --==================================================

        table.insert(
            Library.Windows,
            WindowObject
        )

        WindowObject:Refresh()

        --==================================================
        -- FIRST NORMAL TAB
        --==================================================

        local firstTab

        for _, tab in ipairs(
            WindowObject.Tabs
        ) do

            if not tab.IsSetting then
                firstTab = tab
                break
            end
        end

        if firstTab then
            firstTab:Activate()
        else
            SettingTab:Activate()
        end

        return WindowObject
    end

--==========================================================
-- GLOBAL VALUE SYSTEM
--==========================================================

function Library:SetValue(name, value)

    Library.Values[name] = value
end

function Library:GetValue(name)

    return Library.Values[name]
end

--==========================================================
-- DESTROY
--==========================================================

function Library:Destroy()

    if Library.Unloaded then
        return
    end

    Library.Unloaded = true

    for _, window in ipairs(
        Library.Windows
    ) do

        if window.ScreenGui then

            pcall(function()
                window.ScreenGui:Destroy()
            end)

        end
    end

    table.clear(
        Library.Windows
    )
end

--==========================================================
-- UNLOAD
--==========================================================

Library.Unload = function()

    Library:Destroy()
end

--==========================================================
-- RETURN
--==========================================================

return Library
