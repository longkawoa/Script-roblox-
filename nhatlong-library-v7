--==========================================================

function Library:CreateWindow(options)

    options = options or {}

    local WindowObject = {}

    WindowObject.Title =
        options.Title or "LONG"

    WindowObject.Subtitle =
        options.Subtitle or "UI Library"

    WindowObject.Tabs = {}
    WindowObject.CurrentTab = nil
    WindowObject.SettingElements = {}

    --======================================================
    -- SCREEN GUI
    --======================================================

    local ScreenGui = New(
        "ScreenGui",
        {
            Name = "LONG_UI",
            ResetOnSpawn = false,
            IgnoreGuiInset = true,
            ZIndexBehavior =
                Enum.ZIndexBehavior.Sibling
        },
        LocalPlayer:WaitForChild("PlayerGui")
    )

    WindowObject.ScreenGui = ScreenGui

    --======================================================
    -- MAIN
    --======================================================

    local Main = New(
        "Frame",
        {
            Name = "Main",

            Size = UDim2.fromOffset(
                Library.Settings.MenuWidth,
                Library.Settings.MenuHeight
            ),

            Position = UDim2.fromScale(0.5, 0.5),

            AnchorPoint =
                Vector2.new(0.5, 0.5),

            BackgroundColor3 =
                Library.Theme.Background,

            BackgroundTransparency =
                Library.Theme.Transparency,

            BorderSizePixel = 0,

            ClipsDescendants = true
        },
        ScreenGui
    )

    Corner(
        Main,
        Library.Settings.CornerRadius
    )

    local MainStroke =
        Stroke(Main)

    WindowObject.Main = Main

    --======================================================
    -- UI SCALE
    --======================================================

    local Scale = New(
        "UIScale",
        {
            Scale =
                Library.Settings.UIScale / 100
        },
        Main
    )

    WindowObject.Scale = Scale

    --======================================================
    -- TOPBAR
    --======================================================

    local Topbar = New(
        "Frame",
        {
            Name = "Topbar",

            Size =
                UDim2.new(1, 0, 0, 58),

            BackgroundColor3 =
                Library.Theme.Secondary,

            BackgroundTransparency =
                Library.Theme.Transparency,

            BorderSizePixel = 0
        },
        Main
    )

    Corner(
        Topbar,
        Library.Settings.CornerRadius
    )

    WindowObject.Topbar = Topbar

    --======================================================
    -- TITLE
    --======================================================

    local Title = New(
        "TextLabel",
        {
            Position =
                UDim2.fromOffset(18, 7),

            Size =
                UDim2.new(1, -120, 0, 25),

            BackgroundTransparency = 1,

            Text =
                WindowObject.Title,

            Font =
                Enum.Font.GothamBold,

            TextSize = 17,

            TextColor3 =
                Library.Theme.Text,

            TextXAlignment =
                Enum.TextXAlignment.Left
        },
        Topbar
    )

    local Subtitle = New(
        "TextLabel",
        {
            Position =
                UDim2.fromOffset(18, 32),

            Size =
                UDim2.new(1, -120, 0, 18),

            BackgroundTransparency = 1,

            Text =
                WindowObject.Subtitle,

            Font =
                Enum.Font.Gotham,

            TextSize = 11,

            TextColor3 =
                Library.Theme.SubText,

            TextXAlignment =
                Enum.TextXAlignment.Left
        },
        Topbar
    )

    WindowObject.TitleLabel = Title
    WindowObject.SubtitleLabel = Subtitle

    --======================================================
    -- FPS / CLOCK
    --======================================================

    local InfoLabel = New(
        "TextLabel",
        {
            Position =
                UDim2.new(1, -180, 0, 7),

            Size =
                UDim2.fromOffset(95, 18),

            BackgroundTransparency = 1,

            Text = "",

            Font =
                Enum.Font.GothamMedium,

            TextSize = 9,

            TextColor3 =
                Library.Theme.SubText,

            TextXAlignment =
                Enum.TextXAlignment.Right
        },
        Topbar
    )

    WindowObject.InfoLabel = InfoLabel

    --======================================================
    -- MINIMIZE
    --======================================================

    local Minimize = New(
        "TextButton",
        {
            Position =
                UDim2.new(1, -72, 0, 13),

            Size =
                UDim2.fromOffset(28, 28),

            BackgroundColor3 =
                Library.Theme.Tertiary,

            Text = "—",

            Font =
                Enum.Font.GothamBold,

            TextSize = 16,

            TextColor3 =
                Library.Theme.Text,

            AutoButtonColor = false,

            BorderSizePixel = 0
        },
        Topbar
    )

    Corner(Minimize, 7)

    --======================================================
    -- CLOSE
    --======================================================

    local Close = New(
        "TextButton",
        {
            Position =
                UDim2.new(1, -38, 0, 13),

            Size =
                UDim2.fromOffset(28, 28),

            BackgroundColor3 =
                Library.Theme.Danger,

            Text = "×",

            Font =
                Enum.Font.GothamBold,

            TextSize = 17,

            TextColor3 =
                Color3.new(1, 1, 1),

            AutoButtonColor = false,

            BorderSizePixel = 0
        },
        Topbar
    )

    Corner(Close, 7)

    --======================================================
    -- SIDEBAR
    --======================================================

    local Sidebar = New(
        "Frame",
        {
            Position =
                UDim2.fromOffset(0, 58),

            Size =
                UDim2.new(
                    0,
                    Library.Settings.SidebarWidth,
                    1,
                    -58
                ),

            BackgroundColor3 =
                Library.Theme.Secondary,

            BackgroundTransparency =
                Library.Theme.Transparency,

            BorderSizePixel = 0
        },
        Main
    )

    WindowObject.Sidebar = Sidebar

    --======================================================
    -- SEARCH
    --======================================================

    local Search = New(
        "TextBox",
        {
            Position =
                UDim2.fromOffset(9, 9),

            Size =
                UDim2.new(1, -18, 0, 34),

            BackgroundColor3 =
                Library.Theme.Tertiary,

            BackgroundTransparency =
                Library.Theme.Transparency,

            PlaceholderText =
                Library:GetText(
                    "SearchPlaceholder"
                ),

            PlaceholderColor3 =
                Library.Theme.SubText,

            Text = "",

            Font =
                Enum.Font.Gotham,

            TextSize = 11,

            TextColor3 =
                Library.Theme.Text,

            ClearTextOnFocus = false,

            BorderSizePixel = 0
        },
        Sidebar
    )

    Corner(Search, 8)

    WindowObject.Search = Search

    --======================================================
    -- TAB LIST
    --======================================================

    local TabList = New(
        "ScrollingFrame",
        {
            Position =
                UDim2.fromOffset(8, 51),

            Size =
                UDim2.new(1, -16, 1, -59),

            BackgroundTransparency = 1,

            BorderSizePixel = 0,

            ScrollBarThickness = 2,

            ScrollBarImageColor3 =
                Library.Theme.Accent,

            CanvasSize =
                UDim2.new(0, 0, 0, 0),

            AutomaticCanvasSize =
                Enum.AutomaticSize.Y
        },
        Sidebar
    )

    New(
        "UIListLayout",
        {
            Padding =
                UDim.new(0, 5),

            SortOrder =
                Enum.SortOrder.LayoutOrder
        },
        TabList
    )

    WindowObject.TabList = TabList

    --======================================================
    -- CONTENT
    --======================================================

    local Content = New(
        "Frame",
        {
            Position =
                UDim2.new(
                    0,
                    Library.Settings.SidebarWidth,
                    0,
                    58
                ),

            Size =
                UDim2.new(
                    1,
                    -Library.Settings.SidebarWidth,
                    1,
                    -58
                ),

            BackgroundColor3 =
                Library.Theme.Background,

            BackgroundTransparency =
                Library.Theme.Transparency,

            BorderSizePixel = 0
        },
        Main
    )

    WindowObject.Content = Content

    --======================================================
    -- FLOATING BUTTON
    --======================================================

    local FloatingButton = New(
        "TextButton",
        {
            Size =
                UDim2.fromOffset(48, 48),

            Position =
                UDim2.new(0, 20, 0.5, 0),

            AnchorPoint =
                Vector2.new(0, 0.5),

            BackgroundColor3 =
                Library.Theme.Accent,

            Text = "L",

            Font =
                Enum.Font.GothamBold,

            TextSize = 18,

            TextColor3 =
                Color3.new(1, 1, 1),

            Visible = false,

            AutoButtonColor = false,

            BorderSizePixel = 0
        },
        ScreenGui
    )

    Corner(FloatingButton, 14)

    WindowObject.FloatingButton =
        FloatingButton

    --======================================================
    -- WATERMARK
    --======================================================

    local Watermark = New(
        "TextLabel",
        {
            Position =
                UDim2.new(1, -130, 1, -30),

            Size =
                UDim2.fromOffset(115, 20),

            BackgroundTransparency = 1,

            Text =
                WindowObject.Title,

            Font =
                Enum.Font.GothamBold,

            TextSize = 9,

            TextColor3 =
                Library.Theme.SubText,

            TextTransparency = 0.15,

            TextXAlignment =
                Enum.TextXAlignment.Right
        },
        ScreenGui
    )

    WindowObject.Watermark = Watermark

    --======================================================
    -- DRAG
    --======================================================

    BindDrag(Topbar, Main)

    --======================================================
    -- MINIMIZE
    --======================================================

    local minimized = false

    Minimize.MouseButton1Click:Connect(function()

        minimized = not minimized

        if minimized then

            Tween(
                Main,
                {
                    Size =
                        UDim2.fromOffset(
                            Library.Settings.MenuWidth,
                            58
                        )
                }
            )

            Minimize.Text = "+"

            Sidebar.Visible = false
            Content.Visible = false

        else

            Tween(
                Main,
                {
                    Size =
                        UDim2.fromOffset(
                            Library.Settings.MenuWidth,
                            Library.Settings.MenuHeight
                        )
                }
            )

            Minimize.Text = "—"

            Sidebar.Visible = true
            Content.Visible = true
        end
    end)

    --======================================================
    -- CLOSE
    --======================================================

    Close.MouseButton1Click:Connect(function()

        Main.Visible = false

        if Library.Settings.FloatingButton then
            FloatingButton.Visible = true
        end
    end)

    FloatingButton.MouseButton1Click:Connect(function()

        Main.Visible = true
        FloatingButton.Visible = false
    end)

    --======================================================
    -- SEARCH
    --======================================================

    Search:GetPropertyChangedSignal("Text"):Connect(function()

        if not Library.Settings.TabSearch then
            return
        end

        local query =
            string.lower(Search.Text)

        for _, tab in ipairs(WindowObject.Tabs) do

            local visible =
                query == ""
                or string.find(
                    string.lower(tab.Name),
                    query,
                    1,
                    true
                ) ~= nil

            tab.Button.Visible = visible
        end
    end)

    --======================================================
    -- FPS
    --======================================================

    local frames = 0
    local lastFPS = os.clock()

    RunService.RenderStepped:Connect(function()

        frames += 1

        local now = os.clock()

        if now - lastFPS >= 1 then

            WindowObject.CurrentFPS = frames

            frames = 0
            lastFPS = now

            if InfoLabel.Parent then

                local result = {}

                if Library.Settings.ShowFPS then
                    table.insert(
                        result,
                        "FPS " ..
                        tostring(
                            WindowObject.CurrentFPS
                            or 0
                        )
                    )
                end

                if Library.Settings.ShowClock then
                    table.insert(
                        result,
                        os.date("%H:%M")
                    )
                end

                InfoLabel.Text =
                    table.concat(result, "  ")
            end
        end
    end)

    --======================================================
    -- GLOBAL TOGGLE
    --======================================================

    UserInputService.InputBegan:Connect(
        function(input, processed)

            if processed then
                return
            end

            if input.KeyCode ==
                Library.Settings.ToggleKey then

                if Main.Visible then
                    Main.Visible = false

                    if Library.Settings.FloatingButton then
                        FloatingButton.Visible = true
                    end
                else
                    Main.Visible = true
                    FloatingButton.Visible = false
                end
            end
        end
    )

    --======================================================
    -- REFRESH
    --======================================================

    function WindowObject:Refresh()

        if not Main.Parent then
            return
        end

        -- Main

        Main.BackgroundColor3 =
            Library.Theme.Background

        Main.BackgroundTransparency =
            Library.Theme.Transparency

        MainStroke.Color =
            Library.Theme.Border

        -- Topbar

        Topbar.BackgroundColor3 =
            Library.Theme.Secondary

        Topbar.BackgroundTransparency =
            Library.Theme.Transparency

        -- Sidebar

        Sidebar.BackgroundColor3 =
            Library.Theme.Secondary

        Sidebar.BackgroundTransparency =
            Library.Theme.Transparency

        -- Content

        Content.BackgroundColor3 =
            Library.Theme.Background

        Content.BackgroundTransparency =
            Library.Theme.Transparency

        -- Text

        Title.TextColor3 =
            Library.Theme.Text

        Subtitle.TextColor3 =
            Library.Theme.SubText

        InfoLabel.TextColor3 =
            Library.Theme.SubText

        -- Buttons

        Minimize.BackgroundColor3 =
            Library.Theme.Tertiary

        Minimize.TextColor3 =
            Library.Theme.Text

        Close.BackgroundColor3 =
            Library.Theme.Danger

        -- Search

        Search.BackgroundColor3 =
            Library.Theme.Tertiary

        Search.BackgroundTransparency =
            Library.Theme.Transparency

        Search.TextColor3 =
            Library.Theme.Text

        Search.PlaceholderColor3 =
            Library.Theme.SubText

        Search.PlaceholderText =
            Library:GetText(
                "SearchPlaceholder"
            )

        -- Floating

        FloatingButton.BackgroundColor3 =
            Library.Theme.Accent

        -- Watermark

        Watermark.Text =
            WindowObject.Title

        Watermark.TextColor3 =
            Library.Theme.SubText

        Watermark.Visible =
            Library.Settings.ShowWatermark

        -- Size

        if not minimized then

            Main.Size =
                UDim2.fromOffset(
                    Library.Settings.MenuWidth,
                    Library.Settings.MenuHeight
                )

        else

            Main.Size =
                UDim2.fromOffset(
                    Library.Settings.MenuWidth,
                    58
                )
        end

        Sidebar.Size =
            UDim2.new(
                0,
                Library.Settings.SidebarWidth,
                1,
                -58
            )

        Content.Position =
            UDim2.new(
                0,
                Library.Settings.SidebarWidth,
                0,
                58
            )

        Content.Size =
            UDim2.new(
                1,
                -Library.Settings.SidebarWidth,
                1,
                -58
            )

        Scale.Scale =
            Library.Settings.UIScale / 100

        Search.Visible =
            Library.Settings.TabSearch

        FloatingButton.Visible =
            Library.Settings.FloatingButton
            and not Main.Visible

        -- Corners

        for _, object in ipairs(
            Main:GetDescendants()
        ) do

            if object:IsA("UICorner") then

                object.CornerRadius =
                    UDim.new(
                        0,
                        Library.Settings.CornerRadius
                    )
            end
        end

        -- UI ELEMENTS

        for _, object in ipairs(
            Main:GetDescendants()
        ) do

            if object:IsA("UIStroke") then
                object.Color =
                    Library.Theme.Border
            end
        end

        -- Tabs

        for _, tab in ipairs(
            WindowObject.Tabs
        ) do

            tab.Page.ScrollBarImageColor3 =
                Library.Theme.Accent

            tab.Button.BackgroundColor3 =
                tab.Active
                and Library.Theme.Tertiary
                or Library.Theme.Secondary

            tab.Icon.TextColor3 =
                Library.Theme.Accent

            tab.NameLabel.TextColor3 =
                Library.Theme.Text

            for _, section in ipairs(
                tab.Sections
            ) do

                section.Container.BackgroundColor3 =
                    Library.Theme.Secondary

                section.Container.BackgroundTransparency =
                    Library.Theme.Transparency

                section.Header.TextColor3 =
                    Library.Theme.Text

                for _, control in ipairs(
                    section.Controls:GetDescendants()
                ) do

                    if control:IsA("TextLabel")
                        or control:IsA("TextButton")
                        or control:IsA("TextBox") then

                        if control:GetAttribute(
                            "LONG_Text"
                        ) then

                            control.TextColor3 =
                                Library.Theme.Text
                        end

                        if control:GetAttribute(
                            "LONG_SubText"
                        ) then

                            control.TextColor3 =
                                Library.Theme.SubText
                        end
                    end

                    if control:IsA("Frame")
                        and control:GetAttribute(
                            "LONG_Tertiary"
                        ) then

                        control.BackgroundColor3 =
                            Library.Theme.Tertiary

                        control.BackgroundTransparency =
                            Library.Theme.Transparency
                    end
                end
            end
        end

        -- Settings translation

        for key, object in pairs(
            WindowObject.SettingElements
        ) do

            if object and object.Parent then

                if object:IsA("TextLabel")
                    or object:IsA("TextButton") then

                    object.Text =
                        Library:GetText(key)
                end
            end
        end

        -- Setting tab

        if WindowObject.SettingTab then

            WindowObject.SettingTab.NameLabel.Text =
                Library:GetText("Setting")

            WindowObject.SettingTab.NameLabel.TextColor3 =
                Library.Theme.Text
        end
    end

    --======================================================
    -- CREATE TAB
    --======================================================

    function WindowObject:CreateTab(name, icon)

        local Tab = {}

        Tab.Name = name
        Tab.Active = false
        Tab.Sections = {}
        Tab.IsSetting = false

        icon =
            icon
            or Library:GetTabIcon(name)

        local normalIndex = 0

        for _, existing in ipairs(
            WindowObject.Tabs
        ) do

            if not existing.IsSetting then
                normalIndex += 1
            end
        end

        -- Button

        local Button = New(
            "TextButton",
            {
                Name = name,

                Size =
                    UDim2.new(1, 0, 0, 39),

                BackgroundColor3 =
                    Library.Theme.Secondary,

                Text = "",

                AutoButtonColor = false,

                BorderSizePixel = 0,

                LayoutOrder =
                    normalIndex + 1
            },
            TabList
        )

        Corner(Button, 8)

        local Icon = New(
            "TextLabel",
            {
                Position =
                    UDim2.fromOffset(9, 0),

                Size =
                    UDim2.fromOffset(25, 39),

                BackgroundTransparency = 1,

                Text = icon,

                Font =
                    Enum.Font.GothamBold,

                TextSize = 15,

                TextColor3 =
                    Library.Theme.Accent
            },
            Button
        )

        local NameLabel = New(
            "TextLabel",
            {
                Position =
                    UDim2.fromOffset(39, 0),

                Size =
                    UDim2.new(1, -47, 1, 0),

                BackgroundTransparency = 1,

                Text = name,

                Font =
                    Enum.Font.GothamMedium,

                TextSize = 12,

                TextColor3 =
                    Library.Theme.Text,

                TextXAlignment =
                    Enum.TextXAlignment.Left
            },
            Button
        )

        -- Page

        local Page = New(
            "ScrollingFrame",
            {
                Name =
                    name .. "_Page",

                Size =
                    UDim2.new(1, 0, 1, 0),

                BackgroundTransparency = 1,

                BorderSizePixel = 0,

                ScrollBarThickness = 3,

                ScrollBarImageColor3 =
                    Library.Theme.Accent,

                CanvasSize =
                    UDim2.new(0, 0, 0, 0),

                AutomaticCanvasSize =
                    Enum.AutomaticSize.Y,

                Visible = false
            },
            Content
        )

        New(
            "UIPadding",
            {
                PaddingTop = UDim.new(0, 12),
                PaddingBottom = UDim.new(0, 12),
                PaddingLeft = UDim.new(0, 12),
                PaddingRight = UDim.new(0, 12)
            },
            Page
        )

        New(
            "UIListLayout",
            {
                Padding = UDim.new(0, 10),
                SortOrder =
                    Enum.SortOrder.LayoutOrder
            },
            Page
        )

        Tab.Button = Button
        Tab.Icon = Icon
        Tab.NameLabel = NameLabel
        Tab.Page = Page

        table.insert(
            WindowObject.Tabs,
            Tab
        )

        --==================================================
        -- ACTIVATE
        --==================================================

        function Tab:Activate()

            for _, other in ipairs(
                WindowObject.Tabs
            ) do

                other.Active = false
                other.Page.Visible = false

                other.Button.BackgroundColor3 =
                    Library.Theme.Secondary
            end

            Tab.Active = true
            Tab.Page.Visible = true

            Tab.Button.BackgroundColor3 =
                Library.Theme.Tertiary

            WindowObject.CurrentTab = Tab
        end

        Button.MouseButton1Click:Connect(
            function()
                Tab:Activate()
            end
        )

        --==================================================
        -- ICON
        --==================================================

        function Tab:SetIcon(newIcon)
            Icon.Text = newIcon
        end

        --==================================================
        -- NAME
        --==================================================

        function Tab:SetName(newName)

            Tab.Name = newName
            Button.Name = newName
            NameLabel.Text = newName
        end

        --==================================================
        -- SECTION
        --==================================================

        function Tab:CreateSection(sectionName)

            local Section = {}

            Section.Name = sectionName

            local Container = New(
                "Frame",
                {
                    Name = sectionName,

                    Size =
                        UDim2.new(1, 0, 0, 0),

                    AutomaticSize =
                        Enum.AutomaticSize.Y,

                    BackgroundColor3 =
                        Library.Theme.Secondary,

                    BackgroundTransparency =
                        Library.Theme.Transparency,

                    BorderSizePixel = 0,

                    ClipsDescendants = true
                },
                Page
            )

            Corner(
                Container,
                Library.Settings.CornerRadius
            )

            Stroke(Container)

            local Header = New(
                "TextLabel",
                {
                    Position =
                        UDim2.fromOffset(12, 0),

                    Size =
                        UDim2.new(1, -24, 0, 38),

                    BackgroundTransparency = 1,

                    Text = sectionName,

                    Font =
                        Enum.Font.GothamBold,

                    TextSize = 13,

                    TextColor3 =
                        Library.Theme.Text,

                    TextXAlignment =
                        Enum.TextXAlignment.Left
                },
                Container
            )

            local Controls = New(
                "Frame",
                {
                    Position =
                        UDim2.fromOffset(10, 38),

                    Size =
                        UDim2.new(1, -20, 0, 0),

                    AutomaticSize =
                        Enum.AutomaticSize.Y,

                    BackgroundTransparency = 1
                },
                Container
            )

            New(
                "UIListLayout",
                {
                    Padding =
                        UDim.new(0, 7),

                    SortOrder =
                        Enum.SortOrder.LayoutOrder
                },
                Controls
            )

            New(
                "UIPadding",
                {
                    PaddingBottom =
                        UDim.new(0, 10)
                },
                Controls
            )

            Section.Container = Container
            Section.Header = Header
            Section.Controls = Controls

            table.insert(
                Tab.Sections,
                Section
            )

            --================================================
            -- LABEL
            --================================================

            function Section:CreateLabel(text)

                local Label = New(
                    "TextLabel",
                    {
                        Size =
                            UDim2.new(1, 0, 0, 30),

                        BackgroundTransparency = 1,

                        Text = text,

                        Font =
                            Enum.Font.Gotham,

                        TextSize = 12,

                        TextColor3 =
                            Library.Theme.SubText,

                        TextWrapped = true,

                        TextXAlignment =
                            Enum.TextXAlignment.Left
                    },
                    Controls
                )

                Label:SetAttribute(
                    "LONG_SubText",
                    true
                )

                return Label
            end

            --================================================
            -- PARAGRAPH
            --================================================

            function Section:CreateParagraph(title, text)

                local Frame = New(
                    "Frame",
                    {
                        Size =
                            UDim2.new(1, 0, 0, 68),

                        BackgroundColor3 =
                            Library.Theme.Tertiary,

                        BackgroundTransparency =
                            Library.Theme.Transparency,

                        BorderSizePixel = 0
                    },
                    Controls
                )

                Frame:SetAttribute(
                    "LONG_Tertiary",
                    true
                )

                Corner(Frame, 8)

                local TitleLabel = New(
                    "TextLabel",
                    {
                        Position =
                            UDim2.fromOffset(12, 7),

                        Size =
                            UDim2.new(1, -24, 0, 20),

                        BackgroundTransparency = 1,

                        Text = title,

                        Font =
                            Enum.Font.GothamBold,

                        TextSize = 12,

                        TextColor3 =
                            Library.Theme.Text,

                        TextXAlignment =
                            Enum.TextXAlignment.Left
                    },
                    Frame
                )

                TitleLabel:SetAttribute(
                    "LONG_Text",
                    true
                )

                local Description = New(
                    "TextLabel",
                    {
                        Position =
                            UDim2.fromOffset(12, 28),

                        Size =
                            UDim2.new(1, -24, 0, 34),

                        BackgroundTransparency = 1,

                        Text = text,

                        Font =
                            Enum.Font.Gotham,

                        TextSize = 10,

                        TextColor3 =
                            Library.Theme.SubText,

                        TextWrapped = true,

                        TextXAlignment =
                            Enum.TextXAlignment.Left,

                        TextYAlignment =
                            Enum.TextYAlignment.Top
                    },
                    Frame
                )

                Description:SetAttribute(
                    "LONG_SubText",
                    true
                )

                return Frame
            end

            --================================================
            -- DIVIDER
            --================================================

            function Section:CreateDivider()

                local Divider = New(
                    "Frame",
                    {
                        Size =
                            UDim2.new(1, 0, 0, 1),

                        BackgroundColor3 =
                            Library.Theme.Border,

                        BorderSizePixel = 0
                    },
