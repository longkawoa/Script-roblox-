                local function GetSelected()

                    local result = {}

                    for _, value in ipairs(values) do

                        if selected[value] then
                            table.insert(
                                result,
                                value
                            )
                        end
                    end

                    return result
                end

                local function UpdateText()

                    local result = GetSelected()

                    if #result == 0 then

                        ValueLabel.Text = "None"

                    else

                        local display = {}

                        for i = 1, math.min(#result, 3) do
                            table.insert(
                                display,
                                tostring(result[i])
                            )
                        end

                        if #result > 3 then
                            table.insert(
                                display,
                                "..."
                            )
                        end

                        ValueLabel.Text =
                            table.concat(
                                display,
                                ", "
                            )
                    end
                end

                local function ClearOptions()

                    for _, child in ipairs(
                        Button:GetChildren()
                    ) do

                        if child:GetAttribute(
                            "LONG_DropdownOption"
                        ) then

                            child:Destroy()
                        end
                    end
                end

                Button.MouseButton1Click:Connect(function()

                    Open = not Open

                    ClearOptions()

                    if Open then

                        local count =
                            math.min(#values, 6)

