                Button.MouseButton1Click:Connect(function()

                    listening = true
                    Key.Text = "Press key"
                end)

                UserInputService.InputBegan:Connect(
                    function(input, processed)

                        if processed then
                            return
                        end

                        if listening then

                            if input.UserInputType ==
                                Enum.UserInputType.Keyboard then

                                current =
                                    input.KeyCode

                                Key.Text =
                                    current.Name

                                listening = false

                                if callback then
                                    task.spawn(
                                        callback,
                                        current
                                    )
                                end
                            end

                            return
                        end

                        if input.KeyCode ==
                            current then

                            if callback then
                                task.spawn(
                                    callback,
                                    current
                                )
                            end
                        end
                    end
                )

                local Keybind = {}

                function Keybind:Set(newKey)

                    if typeof(newKey) ==
                        "EnumItem" then

                        current = newKey
                        Key.Text = newKey.Name
                    end
                end

                function Keybind:Get()
                    return current
                end

                return Keybind
