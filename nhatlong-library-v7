            function Section:CreateSlider(
                text,
                min,
                max,
                default,
                callback
            )

                min = min or 0
                max = max or 100

                if max <= min then
                    max = min + 1
                end

                default =
                    math.clamp(
                        tonumber(default) or min,
                        min,
                        max
                    )

                local value = default

                local ContainerSlider = New(
                    "Frame",
                    {
                        Size =
                            UDim2.new(1, 0, 0, 58),

                        BackgroundColor3 =
                            Library.Theme.Tertiary,

                        BackgroundTransparency =
                            Library.Theme.Transparency,

                        BorderSizePixel = 0
