function Library:GetText(key)

    local language =
        Library.Languages[
            Library.Settings.Language
        ]

    if language and language[key] then
        return language[key]
    end

    return
        Library.Languages.English[key]
        or key
end

function Library:SetLanguage(language)

    if not Library.Languages[language] then
        return false
    end

    Library.Settings.Language = language

    Library:RefreshAll()

    return true
end

--==================================================
-- TAB ICON
--==================================================

function Library:GetTabIcon(name)

    if Library.TabIcons[name] then
        return Library.TabIcons[name]
    end

    local clean =
        string.gsub(
            name,
            "%s+",
            ""
        )

    return Library.TabIcons[clean]
        or "●"
end

--==================================================
-- APPLY THEME
--==================================================

function Library:SetTheme(theme)

    if type(theme) == "string" then

        local preset =
            Library.ThemePresets[theme]

        if not preset then
            return false
        end

        Library.Settings.ThemePreset =
            theme

        for key, value in pairs(preset) do
            Library.Theme[key] = value
        end

    elseif type(theme) == "table" then

        Library.Settings.ThemePreset =
            "Custom"

        for key, value in pairs(theme) do

            if Library.Theme[key] ~= nil then
                Library.Theme[key] = value
            end
        end
    end

    Library:RefreshAll()

    return true
end

--==================================================
-- ACCENT
--==================================================

function Library:SetAccent(name)

    local color =
        Library.AccentPresets[name]

    if not color then
        return false
    end

    Library.Theme.Accent = color
    Library.Settings.AccentPreset = name

    Library:RefreshAll()

    return true
end

--==================================================
-- RGB
--==================================================

function Library:SetColor(name, r, g, b)

    if Library.Theme[name] == nil then
        return false
    end

    r = math.clamp(
        tonumber(r) or 0,
        0,
        255
    )

    g = math.clamp(
        tonumber(g) or 0,
        0,
        255
    )

    b = math.clamp(
        tonumber(b) or 0,
        0,
        255
    )

    Library.Theme[name] =
        Color3.fromRGB(r, g, b)

    Library.Settings.ThemePreset =
        "Custom"

    Library:RefreshAll()

    return true
end

--==================================================
-- REFRESH ALL
--==================================================

function Library:RefreshAll()

    for _, window in pairs(Library.Windows) do

        if window.Refresh then

            pcall(function()
                window:Refresh()
            end)
        end
    end
end

