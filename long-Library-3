                            Enum.Font.GothamMedium,

                        TextSize = 12,

                        TextColor3 =
                            Library.Theme.Text,

                        TextXAlignment =
                            Enum.TextXAlignment.Left
                    },
                    Button
                )

                local Key = New(
                    "TextLabel",
                    {
                        Position =
                            UDim2.new(
                                1,
                                -85,
                                0,
                                7
                            ),

                        Size =
                            UDim2.fromOffset(
                                73,
                                28
                            ),

                        BackgroundColor3 =
                            Library.Theme.Secondary,

                        BackgroundTransparency =
                            Library.Theme.Transparency,

                        Text =
                            current.Name,

                        Font =
                            Enum.Font.GothamBold,

                        TextSize = 10,

                        TextColor3 =
                            Library.Theme.Accent,

                        BorderSizePixel = 0
                    },
                    Button
                )

                Corner(Key, 6)

                Button.MouseButton1Click:Connect(
                    function()

                        listening = true

                        Key.Text =
                            "Press key"
                    end
                )

                UserInputService.InputBegan:Connect(
                    function(
                        input,
                        processed
                    )

                        if processed then
                            return
                        end

                        if listening then

                            if input.UserInputType ==
                                Enum.UserInputType.Keyboard then

                                current =
                                    input.KeyCode

                                Key.Text =
                                    current.Name

                                listening = false

                                if callback then
                                    task.spawn(
                                        callback,
                                        current
                                    )
                                end
                            end

                            return
                        end

                        if input.KeyCode ==
                            current then

                            if callback then
                                task.spawn(
                                    callback,
                                    current
                                )
                            end
                        end
                    end
                )

                local Keybind = {}

                function Keybind:Set(
                    newKey
                )

                    current = newKey

                    Key.Text =
                        newKey.Name
                end

                function Keybind:Get()

                    return current
                end

                return Keybind
            end

            return Section
        end

        --==================================================
        -- TAB ORDER FIX
        --==================================================

        local function RefreshTabOrder()

            local normalIndex = 1

            for _, tab in ipairs(
                selfWindow.Tabs
            ) do

                if tab.IsSetting then

                    tab.Button.LayoutOrder =
                        999999

                else

                    tab.Button.LayoutOrder =
                        normalIndex

                    normalIndex += 1
                end
            end
        end

        WindowObject.RefreshTabOrder =
            RefreshTabOrder

        RefreshTabOrder()

        --==================================================
        -- FIRST TAB
        --==================================================

        if #selfWindow.Tabs == 1 then
            Tab:Activate()
        end

        return Tab
    end

