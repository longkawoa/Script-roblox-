                )

                Button:SetAttribute(
                    "LONG_Tertiary",
                    true
                )

                Corner(Button, 8)

                local Label = New(
                    "TextLabel",
                    {
                        Position =
                            UDim2.fromOffset(
                                12,
                                0
                            ),

                        Size =
