    Search:GetPropertyChangedSignal(
        "Text"
    ):Connect(
        function()

            if not Library.Settings.TabSearch then
                return
            end

            local query =
                string.lower(
                    Search.Text
                )

            for _, tab in ipairs(
                WindowObject.Tabs
            ) do

                local visible =
                    query == ""
                    or string.find(
                        string.lower(
                            tab.Name
                        ),
                        query,
                        1,
                        true
                    ) ~= nil

                tab.Button.Visible =
                    visible
            end
        end
    )

