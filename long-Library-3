    --==================================================
    -- RESET
    --==================================================

    local ResetSection =
        SettingTab:CreateSection(
            Library:GetText(
                "Reset"
            )
        )

    E.Reset =
        ResetSection.Header

    ResetSection:CreateButton(
        Library:GetText(
            "ResetUI"
        ),
        function()

            for key, value in pairs(
                Library.DefaultSettings
            ) do

                Library.Settings[key] =
                    value
            end

            for key, value in pairs(
                Library.ThemePresets.Purple
            ) do

                Library.Theme[key] =
                    value
            end

            Library.Theme.Transparency =
                0

            WindowObject:Refresh()

            WindowObject:Notify(
                "Settings",
                Library:GetText(
                    "SettingsReset"
                ),
                3
            )
        end
    )

    ResetSection:CreateButton(
        Library:GetText(
            "Restore"
        ),
        function()

            Main.Visible = true
            FloatingButton.Visible =
                false

            WindowObject:Notify(
                "Window",
                Library:GetText(
                    "WindowRestored"
                ),
                2
            )
        end
    )

    ResetSection:CreateButton(
        Library:GetText(
            "Unload"
        ),
        function()

            Library:Destroy()
        end
    )

    --==================================================
    -- REGISTER WINDOW
    --==================================================

    table.insert(
        Library.Windows,
        WindowObject
    )

    --==================================================
    -- WINDOW API
    --==================================================

    function WindowObject:SetTitle(
        title
    )

        WindowObject.Title =
            title

        Title.Text =
            title
    end

    function WindowObject:SetSubtitle(
        subtitle
    )

        WindowObject.Subtitle =
            subtitle

        Subtitle.Text =
            subtitle
    end

    function WindowObject:SetSize(
        width,
        height
    )

        Library.Settings.MenuWidth =
            math.clamp(
                width,
                400,
                1200
            )

        Library.Settings.MenuHeight =
            math.clamp(
                height,
                280,
                900
            )

        WindowObject:Refresh()
    end

    function WindowObject:SetSidebarWidth(
        width
    )

        Library.Settings.SidebarWidth =
            math.clamp(
                width,
                100,
                300
            )

        WindowObject:Refresh()
    end

    function WindowObject:SetScale(
        scale
    )

        Library.Settings.UIScale =
            math.clamp(
                scale,
                70,
                130
            )

        WindowObject:Refresh()
    end

    function WindowObject:SetTheme(
        theme
    )

        Library:SetTheme(theme)
    end

    function WindowObject:SetLanguage(
        language
    )

        Library:SetLanguage(
            language
        )
    end

    function WindowObject:Show()

        Main.Visible = true

        FloatingButton.Visible =
            false
    end

    function WindowObject:Hide()

        Main.Visible = false

        if Library.Settings.FloatingButton then
            FloatingButton.Visible =
                true
        end
    end

    function WindowObject:Toggle()

        if Main.Visible then

            self:Hide()

        else

            self:Show()
        end
    end

    function WindowObject:GetCurrentTab()

        return WindowObject.CurrentTab
    end

    --==================================================
    -- INITIAL TAB ORDER
    --==================================================

    if WindowObject.RefreshTabOrder then
        WindowObject.RefreshTabOrder()
    end

    --==================================================
    -- INITIAL REFRESH
    --==================================================

    WindowObject:Refresh()

    --==================================================
    -- DEFAULT TAB
    --==================================================

    local firstNormalTab = nil

    for _, tab in ipairs(
        WindowObject.Tabs
    ) do

        if not tab.IsSetting then

            firstNormalTab =
                tab

            break
        end
    end

    if firstNormalTab then

        firstNormalTab:Activate()

    else

        SettingTab:Activate()
    end

    return WindowObject
end

--==================================================
-- GLOBAL VALUE SYSTEM
--==================================================

function Library:SetValue(
    name,
    value
)

    Library.Values[name] =
        value
end

function Library:GetValue(
    name
)

    return Library.Values[name]
end

--==================================================
-- DESTROY
--==================================================

function Library:Destroy()

    if Library.Unloaded then
        return
    end

    Library.Unloaded = true

    for _, window in ipairs(
        Library.Windows
    ) do

        if window.ScreenGui then

            pcall(function()

                window.ScreenGui:Destroy()

            end)
        end
    end

    table.clear(
        Library.Windows
    )
end

--==================================================
-- UNLOAD
--==================================================

Library.Unload =
    function()

        Library:Destroy()
    end

--==================================================
-- RETURN
--==================================================

return Library
