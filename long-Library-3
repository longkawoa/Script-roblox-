                )

                local Open = false

                local function UpdateText()

                    local result = {}

                    for value, enabled in pairs(
                        selected
                    ) do

                        if enabled then
                            table.insert(
                                result,
                                tostring(value)
                            )
                        end
                    end

                    table.sort(result)

                    if #result == 0 then

                        ValueLabel.Text =
                            "None"

                    else

                        ValueLabel.Text =
                            table.concat(
                                result,
                                ", "
                            )
                    end
                end

                local function GetSelected()

                    local result = {}

                    for value, enabled in pairs(
                        selected
                    ) do

                        if enabled then
                            table.insert(
                                result,
                                value
                            )
                        end
                    end

                    return result
                end

                local function ClearOptions()

                    for _, child in ipairs(
                        Button:GetChildren()
                    ) do

                        if child:GetAttribute(
                            "LONG_DropdownOption"
                        ) then

                            child:Destroy()
                        end
                    end
                end

                Button.MouseButton1Click:Connect(
                    function()

                        Open = not Open

                        ClearOptions()

                        if Open then

                            Button.Size =
                                UDim2.new(
                                    1,
                                    0,
                                    0,
                                    46
                                    + (
                                        #values
                                        * 32
                                    )
                                )

                            for i, option in ipairs(
                                values
                            ) do

                                local Option = New(
                                    "TextButton",
                                    {
                                        Position =
                                            UDim2.fromOffset(
                                                8,
                                                46
                                                + (
                                                    (i - 1)
                                                    * 32
                                                )
                                            ),

                                        Size =
                                            UDim2.new(
                                                1,
                                                -16,
                                                0,
                                                28
                                            ),

                                        BackgroundColor3 =
                                            selected[option]
                                            and Library.Theme.Accent
                                            or Library.Theme.Secondary,

                                        Text =
                                            tostring(
                                                option
                                            ),

                                        Font =
                                            Enum.Font.Gotham,

                                        TextSize = 11,

                                        TextColor3 =
                                            Library.Theme.Text,

                                        AutoButtonColor = false,

                                        BorderSizePixel = 0
                                    },
                                    Button
                                )

                                Option:SetAttribute(
                                    "LONG_DropdownOption",
                                    true
                                )

                                Corner(
                                    Option,
                                    6
                                )

                                Option.MouseButton1Click:Connect(
                                    function()

                                        selected[option] =
                                            not selected[option]

                                        Option.BackgroundColor3 =
                                            selected[option]
                                            and Library.Theme.Accent
                                            or Library.Theme.Secondary

                                        UpdateText()

                                        if callback then
                                            task.spawn(
                                                callback,
                                                GetSelected()
                                            )
                                        end
                                    end
                                )
                            end

                        else

                            Button.Size =
                                UDim2.new(
                                    1,
                                    0,
                                    0,
                                    46
                                )
                        end
                    end
                )

                UpdateText()

                local Dropdown = {}

                function Dropdown:Set(
                    newValues
                )

                    selected = {}

                    for _, value in ipairs(
                        newValues or {}
                    ) do

                        selected[value] = true
                    end

                    UpdateText()

                    if callback then
                        task.spawn(
                            callback,
                            GetSelected()
                        )
                    end
                end

                function Dropdown:Get()

                    return GetSelected()
                end

                return Dropdown
            end

