                        20
                    ),

                BackgroundTransparency = 1,

                Text = title,

                Font =
                    Enum.Font.GothamBold,

                TextSize = 13,

                TextColor3 =
                    Library.Theme.Accent,

                TextXAlignment =
                    Enum.TextXAlignment.Left
            },
            Notification
        )

        local MessageLabel = New(
            "TextLabel",
            {
                Position =
                    UDim2.fromOffset(
                        12,
                        29
                    ),

                Size =
                    UDim2.new(
                        1,
                        -24,
