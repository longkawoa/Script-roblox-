    function Window:Refresh()

        if not Main
            or not Main.Parent
        then
            return
        end

        local transparency =
            Library.Settings.GlassMode
            and (
                Library.Settings.Transparency
                / 100
            )
            or 0

        local Theme =
            Library.Theme

        -- MAIN

        Main.BackgroundColor3 =
            Theme.Background

        Main.BackgroundTransparency =
            transparency

        MainStroke.Color =
            Theme.Border

        -- TOPBAR

        Topbar.BackgroundColor3 =
            Theme.Secondary

        Topbar.BackgroundTransparency =
            transparency

        -- SIDEBAR

        Sidebar.BackgroundColor3 =
            Theme.Secondary

        Sidebar.BackgroundTransparency =
            transparency

        -- CONTENT

        Content.BackgroundColor3 =
            Theme.Background

        Content.BackgroundTransparency =
            transparency

        -- TITLE

        Title.TextColor3 =
            Theme.Text

        Subtitle.TextColor3 =
            Theme.SubText

        -- BUTTONS

        Minimize.BackgroundColor3 =
            Theme.Tertiary

        Minimize.TextColor3 =
            Theme.Text

        Close.BackgroundColor3 =
            Theme.Danger

        -- SEARCH

        Search.BackgroundColor3 =
            Theme.Tertiary

        Search.BackgroundTransparency =
            transparency

        Search.TextColor3 =
            Theme.Text

        Search.PlaceholderColor3 =
            Theme.SubText

        Search.PlaceholderText =
            Library:GetText(
                "SearchPlaceholder"
            )

        Search.Visible =
            Library.Settings.TabSearch

        -- FLOATING

        FloatingButton.BackgroundColor3 =
            Theme.Accent

        FloatingButton.Visible =
            Library.Settings.FloatingButton
            and not Main.Visible

        -- SIZE

        if not minimized then

            Main.Size =
                UDim2.fromOffset(
                    Library.Settings.MenuWidth,
                    Library.Settings.MenuHeight
                )

        else

            Main.Size =
                UDim2.fromOffset(
                    Library.Settings.MenuWidth,
                    58
                )

        end

        -- SIDEBAR SIZE

        Sidebar.Size =
            UDim2.new(
                0,
                Library.Settings.SidebarWidth,
                1,
                -58
            )

        Content.Position =
            UDim2.new(
                0,
                Library.Settings.SidebarWidth,
                0,
                58
            )

        Content.Size =
            UDim2.new(
                1,
                -Library.Settings.SidebarWidth,
                1,
                -58
            )

        -- SCALE

        Scale.Scale =
            Library.Settings.UIScale
            / 100

        -- CORNERS

        for _, object in ipairs(
            Main:GetDescendants()
        ) do

            if object:IsA(
                "UICorner"
            ) then

                object.CornerRadius =
                    UDim.new(
                        0,
                        Library.Settings.CornerRadius
                    )

            end

            if object:IsA(
                "UIStroke"
            ) then

                object.Color =
                    Theme.Border

            end

        end

        -- TABS

        for _, tab in ipairs(
            Window.Tabs
        ) do

            local tabName =
                tab.IsSetting
                and Library:GetText(
                    "Setting"
                )
                or tab.OriginalName

            tab.NameLabel.Text =
                tabName

            tab.Button.BackgroundColor3 =
                tab.Active
                and Theme.Tertiary
                or Theme.Secondary

            tab.Button.BackgroundTransparency =
                transparency

            tab.Icon.TextColor3 =
                Theme.Accent

            tab.Page.ScrollBarImageColor3 =
                Theme.Accent

            for _, section in ipairs(
                tab.Sections
            ) do

                section.Container.BackgroundColor3 =
                    Theme.Secondary

                section.Container.BackgroundTransparency =
                    transparency

                section.Header.TextColor3 =
                    Theme.Text

                if section.LangKey then

                    section.Header.Text =
                        Library:GetText(
                            section.LangKey
                        )

                end

                for _, control in ipairs(
                    section.Controls
                ) do

                    local meta =
                        control._LONG

                    if meta then

                        local key =
                            meta.Key

                        if key then

                            if
                                meta.Kind ==
                                    "Label"
                                or
                                meta.Kind ==
                                    "Button"
                            then

                                control.Text =
                                    Library:GetText(
                                        key
                                    )

                            elseif
                                meta.Kind ==
                                    "Toggle"
                            then

                                meta.Label.Text =
                                    Library:GetText(
                                        key
                                    )

                            elseif
                                meta.Kind ==
                                    "Slider"
                            then

                                meta.Label.Text =
                                    Library:GetText(
                                        key
                                    )

                            elseif
                                meta.Kind ==
                                    "Dropdown"
                                or
                                meta.Kind ==
                                    "MultiDropdown"
                            then

                                meta.Label.Text =
                                    Library:GetText(
                                        key
                                    )

                            elseif
                                meta.Kind ==
                                    "Textbox"
                            then

                                meta.Label.Text =
                                    Library:GetText(
                                        key
                                    )

                            elseif
                                meta.Kind ==
                                    "Keybind"
                            then

                                meta.Label.Text =
                                    Library:GetText(
                                        key
                                    )

                            end

                        end

                        if meta.Kind ==
                            "Toggle"
                        then

                            meta.Switch.BackgroundColor3 =
                                meta.Get()
                                and Theme.Accent
                                or Theme.SliderBackground

                        elseif meta.Kind ==
                            "Slider"
                        then

                            meta.ValueLabel.TextColor3 =
                                Theme.Accent

                            meta.Fill.BackgroundColor3 =
                                Theme.Accent

                            meta.Bar.BackgroundColor3 =
                                Theme.SliderBackground

                        elseif
                            meta.Kind ==
                                "Dropdown"
                            or
                            meta.Kind ==
                                "MultiDropdown"
                        then

                            meta.ValueLabel.TextColor3 =
                                Theme.Text

                        elseif
                            meta.Kind ==
                                "Textbox"
                        then

                            meta.Box.BackgroundColor3 =
                                Theme.Secondary

                            meta.Box.TextColor3 =
                                Theme.Text

                            meta.Box.PlaceholderColor3 =
                                Theme.SubText

                        elseif
                            meta.Kind ==
                                "Keybind"
                        then

                            meta.KeyLabel.BackgroundColor3 =
                                Theme.Secondary

                            meta.KeyLabel.TextColor3 =
                                Theme.Accent

                        end

                    end

                end

            end

        end

        -- SETTING TRANSLATION

        for key, object in pairs(E) do

            if
                object
                and object.Parent
                and (
                    object:IsA("TextLabel")
                    or
                    object:IsA("TextButton")
                )
            then

                object.Text =
                    Library:GetText(
                        key
                    )

            end

        end

    end

    --==================================================
    -- FPS + CLOCK
    --==================================================

    local fps = 0
    local frames = 0
    local last = os.clock()

    table.insert(
        Window.Connections,

        RunService.RenderStepped:Connect(
            function()

                frames += 1

                local now =
                    os.clock()

                if
                    now - last >= 0.5
                then

                    fps =
                        math.floor(
                            frames
                            /
                            (
                                now - last
                            )
                            + 0.5
                        )

                    frames = 0

                    last = now

                end

                if Status.Visible then

                    local parts = {}

                    if
                        Library.Settings.FPSCounter
                    then

                        table.insert(
                            parts,
                            tostring(
                                fps
                            )
                            .. " FPS"
                        )

                    end

                    if
                        Library.Settings.Clock
                    then

                        table.insert(
                            parts,
                            os.date(
                                "%H:%M:%S"
                            )
                        )

                    end

                    Status.Text =
                        table.concat(
                            parts,
                            "  •  "
                        )

                end

            end
        )
    )

