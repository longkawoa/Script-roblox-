    --==================================================
    -- REGISTER
    --==================================================

    table.insert(
        Library.Windows,
        Window
    )

    --==================================================
    -- INITIAL REFRESH
    --==================================================

    Window:Refresh()

    --==================================================
    -- DEFAULT TAB
    --==================================================

    local firstTab

    for _, tab in ipairs(
        Window.Tabs
    ) do

        if not tab.IsSetting then

            firstTab =
                tab

            break

        end

    end

    if firstTab then

        firstTab:Activate()

    else

        SettingTab:Activate()

    end

    return Window
end

--==================================================
-- DESTROY
--==================================================

function Library:Destroy()

    if Library.Unloaded then
        return
    end

    Library.Unloaded =
        true

    for _, window in ipairs(
        Library.Windows
    ) do

        if window.Connections then

            for _, connection in ipairs(
                window.Connections
            ) do

                pcall(function()
                    connection:Disconnect()
                end)

            end

        end

        if window.ScreenGui then

            pcall(function()
                window.ScreenGui:Destroy()
            end)

        end

    end

    table.clear(
        Library.Windows
    )

end

--==================================================
-- UNLOAD
--==================================================

Library.Unload =
    function()

        Library:Destroy()

    end

--==================================================
-- RETURN
--==================================================

return Library
