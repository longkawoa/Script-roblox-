            function Section:CreateSlider(
                text,
                min,
                max,
                default,
                callback,
                key
            )

                min =
                    min or 0

                max =
                    max or 100

                if max <= min then
                    max = min + 1
                end

                local value =
                    math.clamp(
                        default or min,
                        min,
                        max
                    )

                local Container =
                    New(
                        "Frame",
                        {
                            Size =
                                UDim2.new(
                                    1,
                                    0,
                                    0,
                                    58
                                ),

                            BackgroundColor3 =
                                Library.Theme.Tertiary,

