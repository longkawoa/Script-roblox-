--==================================================
-- GET TEXT
--==================================================

function Library:GetText(key)

    local language =
        Library.Languages[
            Library.Settings.Language
        ]

    if language and language[key] then
        return language[key]
    end

    return
        Library.Languages.English[key]
        or key
end

--==================================================
-- INSTANCE
--==================================================

local function New(className, properties, parent)

    local object = Instance.new(className)

    for property, value in pairs(properties or {}) do

        pcall(function()
            object[property] = value
        end)

    end

    if parent then
        object.Parent = parent
    end

    return object
end

--==================================================
-- CORNER
--==================================================

local function Corner(object, radius)

    local corner = Instance.new("UICorner")

    corner.CornerRadius =
        UDim.new(
            0,
            radius or Library.Settings.CornerRadius
        )

    corner.Parent = object

    return corner
end

--==================================================
-- STROKE
--==================================================

local function Stroke(object, color, thickness)

    local stroke = Instance.new("UIStroke")

    stroke.Color =
        color or Library.Theme.Border

    stroke.Thickness =
        thickness or 1

    stroke.Transparency = 0.05

    stroke.Parent = object

    return stroke
end

--==================================================
-- TWEEN
--==================================================

local function Tween(object, properties, duration)

    local tween =
        TweenService:Create(
            object,

            TweenInfo.new(
                duration
                    or Library.Settings.AnimationSpeed,

                Enum.EasingStyle.Quart,

                Enum.EasingDirection.Out
            ),

            properties
        )

    tween:Play()

    return tween
end

--==================================================
-- DRAG
--==================================================

local function BindDrag(frame, target)

    local dragging = false
    local dragStart
    local startPosition

    frame.InputBegan:Connect(function(input)

        if not Library.Settings.Dragging then
            return
        end

        if
            input.UserInputType ==
                Enum.UserInputType.MouseButton1
            or
            input.UserInputType ==
                Enum.UserInputType.Touch
        then

            dragging = true

            dragStart =
                input.Position

            startPosition =
                target.Position

            input.Changed:Connect(function()

                if
                    input.UserInputState ==
                        Enum.UserInputState.End
                then

                    dragging = false

                end

            end)

        end

    end)

    UserInputService.InputChanged:Connect(function(input)

        if not dragging then
            return
        end

        if
            input.UserInputType ==
                Enum.UserInputType.MouseMovement
            or
            input.UserInputType ==
                Enum.UserInputType.Touch
        then

            local delta =
                input.Position
                - dragStart

            target.Position =
                UDim2.new(
                    startPosition.X.Scale,
                    startPosition.X.Offset + delta.X,

                    startPosition.Y.Scale,
                    startPosition.Y.Offset + delta.Y
                )

        end

    end)
end

--==================================================
-- SET THEME
--==================================================

function Library:SetTheme(theme)

    local preset =
        Library.ThemePresets[theme]

    if not preset then
        return false
    end

    Library.Settings.ThemePreset =
        theme

    for key, value in pairs(preset) do
        Library.Theme[key] = value
    end

    self:RefreshAll()

    return true
end

--==================================================
-- SET ACCENT
--==================================================

function Library:SetAccent(name)

    local color =
        Library.AccentPresets[name]

    if not color then
        return false
    end

    Library.Settings.AccentPreset =
        name

    Library.Theme.Accent =
        color

    self:RefreshAll()

    return true
end

--==================================================
-- CUSTOM RGB
--==================================================

function Library:SetColor(name, r, g, b)

    if Library.Theme[name] == nil then
        return false
    end

    r = math.clamp(
        tonumber(r) or 0,
        0,
        255
    )

    g = math.clamp(
        tonumber(g) or 0,
        0,
        255
    )

    b = math.clamp(
        tonumber(b) or 0,
        0,
        255
    )

    Library.Theme[name] =
        RGB(r, g, b)

    Library.Settings.ThemePreset =
        "Custom"

    Library:RefreshAll()

    return true
end

--==================================================
-- LANGUAGE
--==================================================

function Library:SetLanguage(language)

    if not Library.Languages[language] then
        return false
    end

    Library.Settings.Language =
        language

    Library:RefreshAll()

    return true
end

--==================================================
-- TAB ICON
--==================================================

function Library:GetTabIcon(name)

    local compact =
        name:gsub("%s+", "")

    return
        Library.TabIcons[name]
        or Library.TabIcons[compact]
        or "●"
end

--==================================================
-- REFRESH
--==================================================

function Library:RefreshAll()

    for _, window in ipairs(Library.Windows) do

        if window.Refresh then

            pcall(function()
                window:Refresh()
            end)

        end

    end
end

--==================================================
-- VALUES
--==================================================

function Library:SetValue(name, value)
    Library.Values[name] = value
end

function Library:GetValue(name)
    return Library.Values[name]
end

