                            TextColor3 =
                                Library.Theme.Text,

                            TextXAlignment =
                                Enum.TextXAlignment.Left
                        },
                        Button
                    )

                local KeyLabel =
                    New(
                        "TextLabel",
                        {
                            Position =
                                UDim2.new(
                                    1,
                                    -85,
                                    0,
                                    7
                                ),

                            Size =
                                UDim2.fromOffset(
                                    73,
                                    28
                                ),

                            BackgroundColor3 =
                                Library.Theme.Secondary,

                            Text =
                                current.Name,

                            Font =
                                Enum.Font.GothamBold,

                            TextSize = 10,

                            TextColor3 =
                                Library.Theme.Accent,

                            BorderSizePixel = 0
                        },
                        Button
                    )

                Corner(
                    KeyLabel,
                    6
                )

                Button.MouseButton1Click:Connect(
                    function()

                        listening = true

                        KeyLabel.Text =
                            Library:GetText(
                                "PressKey"
                            )

                    end
                )

                UserInputService.InputBegan:Connect(
                    function(
                        input,
                        processed
                    )

                        if processed then
                            return
                        end

                        if listening then

                            if
                                input.UserInputType ==
                                    Enum.UserInputType.Keyboard
                            then

                                current =
                                    input.KeyCode

                                KeyLabel.Text =
                                    current.Name

                                listening = false

                                if callback then

                                    task.spawn(
                                        callback,
                                        current
                                    )

                                end

                            end

                            return
                        end

                        if
                            input.KeyCode ==
                                current
                        then

                            if callback then

                                task.spawn(
                                    callback,
                                    current
                                )

                            end

                        end

                    end
                )

                local Keybind = {}

                function Keybind:Set(
                    newKey
                )

                    current =
                        newKey

                    KeyLabel.Text =
                        newKey.Name

                end

                function Keybind:Get()

                    return current

                end

                Register(
                    Button,
                    "Keybind",
                    key,
                    {
                        Label = Label,
                        KeyLabel = KeyLabel
                    }
                )

                return Keybind

            end

            return Section

        end

        return Tab

