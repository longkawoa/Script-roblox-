        self.Size.X,
        self.Size.Y
    )

    self.Minimize.MouseButton1Click:Connect(function()
        self.Minimized = not self.Minimized

        if self.Minimized then

            self.Sidebar.Visible = false
            self.Content.Visible = false
            self.Search.Visible = false

            Tween(
                self.Main,
                nil,
                {
                    Size = UDim2.fromOffset(
                        self.Size.X,
                        46
                    )
                }
            )

        else

            Tween(
                self.Main,
                nil,
                {
                    Size = normalSize
                }
            )

            task.delay(
                0.16,
                function()

                    if self.Destroyed
                        or self.Minimized then
                        return
                    end

                    self.Sidebar.Visible = true
                    self.Content.Visible = true

                    self.Search.Visible =
                        options.TabSearch ~= false

                end
            )
        end
    end)

    --------------------------------------------------------
    -- CLOSE
    --------------------------------------------------------

    self.Close.MouseButton1Click:Connect(function()

        self.Closed = true

        self.Main.Visible = false

        self.OpenButton.Visible = true

    end)

    --------------------------------------------------------
    -- OPEN
    --------------------------------------------------------

    self.OpenButton.MouseButton1Click:Connect(function()

        self.Closed = false

        self.OpenButton.Visible = false

        self.Main.Visible = true

    end)

    self.Main.Visible = true

    return self
end

