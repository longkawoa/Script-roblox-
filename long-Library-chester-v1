        function section:CreateSlider(
            text,
            min,
            max,
            default,
            callback
        )

            min = tonumber(min) or 0
            max = tonumber(max) or 100

            if max <= min then
                max = min + 1
            end

            local value =
                math.clamp(
                    tonumber(default) or min,
                    min,
                    max
                )

            local row = New(
                "Frame",
                {

                    Size = UDim2.new(
                        1,
                        0,
                        0,
                        54
                    ),

                    BackgroundTransparency = 1,

                    Parent =
                        section.Container,
                }
            )

            New(
                "TextLabel",
                {

                    Size = UDim2.new(
                        1,
                        -60,
                        0,
                        22
                    ),

                    BackgroundTransparency = 1,

                    Text = tostring(
                        text or "Slider"
                    ),

                    Font =
                        Enum.Font.Gotham,

                    TextSize = 11,

                    TextColor3 =
                        Library.Theme.Text,

                    TextXAlignment =
                        Enum.TextXAlignment.Left,

                    Parent = row,
                }
            )

            local valueLabel = New(
                "TextLabel",
                {

                    Size = UDim2.fromOffset(
                        55,
                        22
                    ),

                    Position =
                        UDim2.new(
                            1,
                            -55,
                            0,
                            0
                        ),

                    BackgroundTransparency = 1,

                    Text = tostring(
                        value
                    ),

                    Font =
                        Enum.Font.GothamMedium,

                    TextSize = 11,

                    TextColor3 =
                        Library.Theme.SubText,

                    TextXAlignment =
                        Enum.TextXAlignment.Right,

                    Parent = row,
                }
            )

            local bar = New(
                "Frame",
                {

                    Size = UDim2.new(
                        1,
                        0,
                        0,
                        7
                    ),

                    Position =
                        UDim2.new(
                            0,
                            0,
                            1,
                            -13
                        ),

                    BackgroundColor3 =
                        Library.Theme.SliderBackground,

                    BorderSizePixel = 0,

                    Parent = row,
                }
            )

            Corner(bar, 4)

            local fill = New(
                "Frame",
                {

                    Size = UDim2.new(
                        (value - min)
                            / (max - min),
                        0,
                        1,
                        0
                    ),

                    BackgroundColor3 =
                        Library.Theme.Accent,

                    BorderSizePixel = 0,

                    Parent = bar,
                }
            )

            Corner(fill, 4)

            local knob = New(
                "Frame",
                {

                    Size = UDim2.fromOffset(
                        13,
                        13
                    ),

                    AnchorPoint =
                        Vector2.new(
                            0.5,
                            0.5
                        ),

                    Position =
                        UDim2.new(
                            (value - min)
                                / (max - min),
                            0,
                            0.5,
                            0
                        ),

                    BackgroundColor3 =
                        Library.Theme.Text,

                    BorderSizePixel = 0,

                    Parent = bar,
                }
            )

            Corner(knob, 7)

            local dragging = false

            local object = {}

            local function setFromX(
                x,
                fire
            )

                local alpha =
                    math.clamp(
                        (
                            x -
                            bar.AbsolutePosition.X
                        )
                        / math.max(
                            bar.AbsoluteSize.X,
                            1
                        ),
                        0,
                        1
                    )

                value =
                    min +
                    (max - min) * alpha

                value =
                    math.floor(
                        value + 0.5
                    )

                alpha =
                    (value - min)
                    / (max - min)

                valueLabel.Text =
                    tostring(value)

                fill.Size =
                    UDim2.new(
                        alpha,
                        0,
                        1,
                        0
                    )

                knob.Position =
                    UDim2.new(
                        alpha,
                        0,
                        0.5,
                        0
                    )

                if fire ~= false
                    and callback then

                    callback(value)

                end
            end

            function object:SetValue(
                newValue,
                fire
            )

                value =
                    math.clamp(
                        tonumber(newValue)
                            or min,
                        min,
                        max
                    )

                local alpha =
                    (value - min)
                    / (max - min)

                valueLabel.Text =
                    tostring(value)

                fill.Size =
                    UDim2.new(
                        alpha,
                        0,
                        1,
                        0
                    )

                knob.Position =
                    UDim2.new(
                        alpha,
                        0,
                        0.5,
                        0
                    )

                if fire ~= false
                    and callback then

                    callback(value)

                end
            end

            function object:GetValue()
                return value
            end

            function object:Destroy()
                row:Destroy()
            end

            local function begin(input)

                if input.UserInputType ==
                    Enum.UserInputType.MouseButton1

                    or input.UserInputType ==
                    Enum.UserInputType.Touch then

                    dragging = true

                    setFromX(
                        input.Position.X,
                        true
                    )
                end
            end

            bar.InputBegan:Connect(begin)
            knob.InputBegan:Connect(begin)

            UserInputService.InputChanged:Connect(
                function(input)

                    if not dragging then
                        return
                    end

                    if input.UserInputType ==
                        Enum.UserInputType.MouseMovement

                        or input.UserInputType ==
                        Enum.UserInputType.Touch then

                        setFromX(
                            input.Position.X,
                            true
                        )
                    end
                end
            )

            UserInputService.InputEnded:Connect(
                function(input)

                    if input.UserInputType ==
                        Enum.UserInputType.MouseButton1

                        or input.UserInputType ==
                        Enum.UserInputType.Touch then

                        dragging = false

                    end
                end
            )

            return object
        end

