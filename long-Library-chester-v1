    tab.Button = button
    tab.Page = page
    tab.Icon = iconLabel
    tab.NameLabel = nameLabel

    local selfWindow = self

    --------------------------------------------------------
    -- ACTIVATE
    --------------------------------------------------------

    function tab:Activate()

        for _, other in ipairs(
            selfWindow.Tabs
        ) do

            other.Active = false

            other.Page.Visible = false

            Tween(
                other.Button,
                nil,
                {
                    BackgroundTransparency = 1
                }
            )

            Tween(
                other.Icon,
                nil,
                {
                    TextColor3 =
                        Library.Theme.SubText
                }
            )

            Tween(
                other.NameLabel,
                nil,
                {
                    TextColor3 =
                        Library.Theme.SubText
                }
            )

        end

        self.Active = true

        page.Visible = true

        Tween(
            button,
            nil,
            {
                BackgroundTransparency = 0,
                BackgroundColor3 =
                    Library.Theme.Tertiary
            }
        )

        Tween(
            iconLabel,
            nil,
            {
                TextColor3 =
                    Library.Theme.Accent
            }
        )

        Tween(
            nameLabel,
            nil,
            {
                TextColor3 =
                    Library.Theme.Text
            }
        )
    end

    --------------------------------------------------------
    -- SET ICON
    --------------------------------------------------------

    function tab:SetIcon(newIcon)

        icon = tostring(
            newIcon or "◆"
        )

        iconLabel.Text = icon

    end

    --------------------------------------------------------
    -- SET NAME
    --------------------------------------------------------

    function tab:SetName(newName)

        tab.Name = tostring(
            newName or "Tab"
        )

        nameLabel.Text = tab.Name

    end

