    )

    button.MouseButton1Click:Connect(
        function()
            tab:Activate()
        end
    )

    if #self.Tabs == 1 then
        tab:Activate()
    end

    return tab
end

------------------------------------------------------------
-- NOTIFICATION
------------------------------------------------------------

function Library:Notify(
    title,
    message,
    duration
)

    duration =
        tonumber(duration) or 3

    local holder =
        self.Gui:FindFirstChild(
            "Notifications"
        )

    if not holder then

        holder = New(
            "Frame",
            {

                Name = "Notifications",

                Size =
                    UDim2.fromOffset(
                        285,
                        420
                    ),

                Position =
                    UDim2.new(
                        1,
                        -300,
                        0,
                        20
                    ),

                BackgroundTransparency = 1,

                Parent =
                    self.Gui,
            }
        )

        New(
            "UIListLayout",
            {

                Padding =
                    UDim.new(
                        0,
                        8
                    ),

                VerticalAlignment =
                    Enum.VerticalAlignment.Top,

                HorizontalAlignment =
                    Enum.HorizontalAlignment.Right,

                Parent = holder,
            }
        )
    end

    local notification = New(
        "Frame",
        {

            Size =
                UDim2.fromOffset(
                    270,
                    66
                ),

            BackgroundColor3 =
                Library.Theme.Secondary,

            BorderSizePixel = 0,

            Parent = holder,
        }
    )

    Corner(
        notification,
        9
    )

    Stroke(
        notification,
        Library.Theme.Border,
        1
    )

    New(
        "TextLabel",
        {

            Size =
                UDim2.new(
                    1,
                    -20,
                    0,
                    23
                ),

            Position =
                UDim2.fromOffset(
                    10,
                    6
                ),

            BackgroundTransparency = 1,

            Text = tostring(
                title or
                "Notification"
            ),

            Font =
                Enum.Font.GothamBold,

            TextSize = 12,

            TextColor3 =
                Library.Theme.Text,

            TextXAlignment =
                Enum.TextXAlignment.Left,

            Parent = notification,
        }
    )

    New(
        "TextLabel",
        {

            Size =
                UDim2.new(
                    1,
                    -20,
                    0,
                    31
                ),

            Position =
                UDim2.fromOffset(
                    10,
                    29
                ),

            BackgroundTransparency = 1,

            Text = tostring(
                message or ""
            ),

            Font =
                Enum.Font.Gotham,

            TextSize = 10,

            TextColor3 =
                Library.Theme.SubText,

            TextWrapped = true,

            TextXAlignment =
                Enum.TextXAlignment.Left,

            Parent = notification,
        }
    )

    notification.Position =
        UDim2.new(
            1,
            30,
            0,
            0
        )

    Tween(
        notification,
        nil,
        {
            Position =
                UDim2.new(
                    0,
                    0,
                    0,
                    0
                )
        }
    )

    task.delay(
        duration,
        function()

            if notification
                and notification.Parent then

                local tween =
                    Tween(
                        notification,
                        nil,
                        {
                            Position =
                                UDim2.new(
                                    1,
                                    30,
                                    0,
                                    0
                                )
                        }
                    )

                tween.Completed:Wait()

                if notification
                    and notification.Parent then

                    notification:Destroy()

                end
            end
        end
    )
end

------------------------------------------------------------
-- THEME
------------------------------------------------------------

function Library:SetTheme(theme)

    for key, value in pairs(
        theme or {}
    ) do

        if Library.Theme[key] ~= nil then
            Library.Theme[key] = value
        end

    end

    if not self.Gui
        or self.Destroyed then
        return
    end

    if self.Main then
        self.Main.BackgroundColor3 =
            Library.Theme.Background
    end

    if self.MainStroke then
        self.MainStroke.Color =
            Library.Theme.Border
    end

    if self.Topbar then
        self.Topbar.BackgroundColor3 =
            Library.Theme.Secondary
    end

    if self.Sidebar then
        self.Sidebar.BackgroundColor3 =
            Library.Theme.Secondary
    end

    if self.OpenButton then
        self.OpenButton.BackgroundColor3 =
            Library.Theme.Background
    end
end

------------------------------------------------------------
-- VALUES
------------------------------------------------------------

function Library:SetValue(
    name,
    value
)

    self.Values[
        tostring(name)
    ] = value
end

function Library:GetValue(name)

    return self.Values[
        tostring(name)
    ]

end

------------------------------------------------------------
-- DESTROY
------------------------------------------------------------

function Library:Destroy()

    if self.Destroyed then
        return
    end

    self.Destroyed = true

    if self.Gui then
        self.Gui:Destroy()
    end

    table.clear(
        self.Tabs
    )

    table.clear(
        self.Controls
    )

    table.clear(
        self.Values
    )
end

Library.Unload =
    Library.Destroy

return Library
