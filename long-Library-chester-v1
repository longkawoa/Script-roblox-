                    Text = "None",

                    Font =
                        Enum.Font.Gotham,

                    TextSize = 11,

                    TextColor3 =
                        Library.Theme.Text,

                    AutoButtonColor = false,

                    Parent = row,
                }
            )

            Corner(
                selected,
                7
            )

            local list = New(
                "ScrollingFrame",
                {

                    Size =
                        UDim2.new(
                            1,
                            0,
                            0,
                            0
                        ),

                    Position =
                        UDim2.fromOffset(
                            0,
                            59
                        ),

                    BackgroundColor3 =
                        Library.Theme.Tertiary,

                    BorderSizePixel = 0,

                    ScrollBarThickness = 2,

                    CanvasSize =
                        UDim2.new(),

                    AutomaticCanvasSize =
                        Enum.AutomaticSize.Y,

                    Visible = false,

                    ZIndex = 50,

                    Parent = row,
                }
            )

            Corner(
                list,
                7
            )

            New("UIListLayout", {
                Padding =
                    UDim.new(0, 2),

                Parent = list,
            })

            local opened = false
            local object = {}

            local function getList()

                local result = {}

                for _, option in ipairs(
                    options
                ) do

                    if selectedValues[
                        option
                    ] then

                        table.insert(
                            result,
                            option
                        )

                    end
                end

                return result
            end

            local function updateText()

                local result =
                    getList()

                if #result == 0 then

                    selected.Text =
                        "None"

                elseif #result <= 2 then

                    selected.Text =
                        table.concat(
                            result,
                            ", "
                        )

                else

                    selected.Text =
                        tostring(
                            #result
                        )
                        .. " selected"

                end
            end

            local function fire()

                if callback then
                    callback(
                        getList()
                    )
                end

            end

            local function rebuild()

                for _, child in ipairs(
                    list:GetChildren()
                ) do

                    if child:IsA(
                        "TextButton"
                    ) then

                        child:Destroy()

                    end
                end

                for _, option in ipairs(
                    options
                ) do

                    local optionButton =
                        New(
                            "TextButton",
                            {

                                Size =
                                    UDim2.new(
                                        1,
                                        -4,
                                        0,
                                        30
                                    ),

                                BackgroundTransparency = 1,

                                Text =
                                    (
                                        selectedValues[
                                            option
                                        ]
                                        and "✓ "
                                        or "   "
                                    )
                                    .. tostring(
                                        option
                                    ),

                                Font =
                                    Enum.Font.Gotham,

                                TextSize = 10,

                                TextColor3 =
                                    Library.Theme.Text,

                                AutoButtonColor =
                                    false,

                                ZIndex = 51,

                                Parent = list,
                            }
                        )

                    optionButton.MouseButton1Click:Connect(
                        function()

                            selectedValues[
                                option
                            ] =
                                not selectedValues[
                                    option
                                ]

                            optionButton.Text =
                                (
                                    selectedValues[
                                        option
                                    ]
                                    and "✓ "
                                    or "   "
                                )
                                .. tostring(
                                    option
                                )

                            updateText()

                            fire()

                        end
                    )
                end

                updateText()
            end

            function object:SetValue(
                values,
                fireCallback
            )

                selectedValues = {}

                for _, v in ipairs(
                    values or {}
                ) do

                    selectedValues[v] = true

                end

                rebuild()

                if fireCallback ~= false then
                    fire()
                end
            end

            function object:GetValue()
                return getList()
            end

            function object:SetOptions(
                newOptions
            )

                options =
                    newOptions or {}

                rebuild()
            end

            function object:Destroy()
                row:Destroy()
            end

            selected.MouseButton1Click:Connect(
                function()

                    opened = not opened

                    if opened then

                        list.Visible = true

                        local height =
                            math.min(
                                #options * 32 + 4,
                                160
                            )

                        Tween(
                            list,
                            nil,
                            {
                                Size =
                                    UDim2.new(
                                        1,
                                        0,
                                        0,
                                        height
                                    )
                            }
                        )

                    else

                        Tween(
                            list,
                            nil,
                            {
                                Size =
                                    UDim2.new(
                                        1,
                                        0,
                                        0,
                                        0
                                    )
                            }
                        )

                        task.delay(
                            0.18,
                            function()

                                if not opened then
                                    list.Visible = false
                                end

                            end
                        )

                    end
                end
            )

            rebuild()

            return object
        end

