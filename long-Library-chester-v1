            UserInputService.InputBegan:Connect(
                function(
                    input,
                    processed
                )

                    if listening
                        and input.UserInputType
                        == Enum.UserInputType.Keyboard then

                        listening = false

                        key =
                            input.KeyCode

                        keyButton.Text =
                            key.Name

                        return
                    end

                    if not processed
                        and input.UserInputType
                        == Enum.UserInputType.Keyboard
                        and input.KeyCode == key then

                        if callback then
                            callback(key)
                        end
                    end
                end
            )

