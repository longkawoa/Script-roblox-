--==============================================================
-- HELPERS
--==============================================================

local function SafeDestroy(object)

    if object then
        pcall(function()
            object:Destroy()
        end)
    end
end

local function New(className, properties, parent)

    local object

    local success = pcall(function()

        object = Instance.new(className)

        for property, value in pairs(properties or {}) do

            pcall(function()
                object[property] = value
            end)

        end

        if parent then
            object.Parent = parent
        end

    end)

    if not success then
        return nil
    end

    return object
end

local function Corner(object, radius)

    if not object then
        return
    end

    local corner = Instance.new("UICorner")

    corner.CornerRadius =
        UDim.new(
            0,
            radius or Library.Settings.CornerRadius
        )

    corner.Parent = object

    return corner
end

local function Stroke(object, color, thickness)

    if not object then
        return
    end

    local stroke = Instance.new("UIStroke")

    stroke.Color =
        color or Library.Theme.Border

    stroke.Thickness =
        thickness or 1

    stroke.Parent = object

    return stroke
end

local function Tween(object, properties, duration)

    if not object then
        return
    end

    duration =
        tonumber(duration)
        or Library.Settings.AnimationSpeed

    duration =
        math.clamp(
            duration,
            0,
            2
        )

    local success, tween = pcall(function()

        return TweenService:Create(
            object,

            TweenInfo.new(
                duration,
                Enum.EasingStyle.Quart,
                Enum.EasingDirection.Out
            ),

            properties
        )

    end)

    if success and tween then
        tween:Play()
        return tween
    end
end

local function SafeCallback(callback, ...)

    if typeof(callback) ~= "function" then
        return
    end

    local args = table.pack(...)

    task.spawn(function()

        pcall(function()
            callback(table.unpack(args, 1, args.n))
        end)

    end)
end

--==============================================================
-- TRANSLATION
--==============================================================

function Library:GetText(key)

    local language =
        Library.Languages[
            Library.Settings.Language
        ]

    if language and language[key] then
        return language[key]
    end

    if Library.Languages.English[key] then
        return Library.Languages.English[key]
    end

    return tostring(key)
end

function Library:SetLanguage(language)

    if not Library.Languages[language] then
        return false
    end

    Library.Settings.Language = language

    Library:RefreshAll()

    return true
end

--==============================================================
-- THEME
--==============================================================

function Library:SetTheme(theme)

    if type(theme) ~= "string" then
        return false
    end

    local preset =
        Library.ThemePresets[theme]

    if not preset then
        return false
    end

    Library.Settings.ThemePreset =
        theme

    for key, value in pairs(preset) do

        Library.Theme[key] =
            value

    end

    Library:RefreshAll()

    return true
end

--==============================================================
-- ACCENT
--==============================================================

function Library:SetAccent(name)

    if type(name) ~= "string" then
        return false
    end

    local color =
        Library.AccentPresets[name]

    if not color then
        return false
    end

    Library.Theme.Accent =
        color

    Library.Settings.AccentPreset =
        name

    Library:RefreshAll()

    return true
end

--==============================================================
-- TRANSPARENCY
--==============================================================

function Library:SetTransparency(value)

    value =
        tonumber(value)

    if not value then
        return false
    end

    value =
        math.clamp(
            value,
            0,
            100
        )

    Library.Settings.Transparency =
        value

    Library.Theme.Transparency =
        value / 100

    Library:RefreshAll()

    return true
end

--==============================================================
-- RGB
--==============================================================

function Library:SetColor(
    name,
    r,
    g,
    b
)

    if Library.Theme[name] == nil then
        return false
    end

    r = math.clamp(
        tonumber(r) or 0,
        0,
        255
    )

    g = math.clamp(
        tonumber(g) or 0,
        0,
        255
    )

    b = math.clamp(
        tonumber(b) or 0,
        0,
        255
    )

    Library.Theme[name] =
        Color3.fromRGB(
            r,
            g,
            b
        )

    Library.Settings.ThemePreset =
        "Custom"

    Library:RefreshAll()

    return true
end

--==============================================================
-- TAB ICON
--==============================================================

function Library:GetTabIcon(name)

    if Library.TabIcons[name] then
        return Library.TabIcons[name]
    end

    local clean =
        string.gsub(
            tostring(name),
            "%s+",
            ""
        )

    return Library.TabIcons[clean]
        or "●"
end

--==============================================================
-- REFRESH
--==============================================================

function Library:RefreshAll()

    for _, window in ipairs(Library.Windows) do

        if window
            and typeof(window.Refresh) == "function" then

            pcall(function()
                window:Refresh()
            end)

        end

    end
end

--==============================================================
-- DRAG
--==============================================================

local function BindDrag(frame, target)

    if not frame or not target then
        return
    end

    local dragging = false
    local dragStart
    local startPosition

    local connection1 =
        frame.InputBegan:Connect(function(input)

            if not Library.Settings.Dragging then
                return
            end

            if
                input.UserInputType ==
                Enum.UserInputType.MouseButton1
                or
                input.UserInputType ==
                Enum.UserInputType.Touch
            then

                dragging = true

                dragStart =
                    input.Position

                startPosition =
                    target.Position

            end
        end)

    local connection2 =
        UserInputService.InputChanged:Connect(
            function(input)

                if not dragging then
                    return
                end

                if
                    input.UserInputType ==
                    Enum.UserInputType.MouseMovement
                    or
                    input.UserInputType ==
                    Enum.UserInputType.Touch
                then

                    local delta =
                        input.Position
                        - dragStart

                    target.Position =
                        UDim2.new(
                            startPosition.X.Scale,
                            startPosition.X.Offset
                                + delta.X,

                            startPosition.Y.Scale,
                            startPosition.Y.Offset
                                + delta.Y
                        )

                end
            end
        )

    local connection3 =
        UserInputService.InputEnded:Connect(
            function(input)

                if
                    input.UserInputType ==
                    Enum.UserInputType.MouseButton1
                    or
                    input.UserInputType ==
                    Enum.UserInputType.Touch
                then

                    dragging = false

                end

            end
        )

    table.insert(
        Library.Connections,
        connection1
    )

    table.insert(
        Library.Connections,
        connection2
    )

    table.insert(
        Library.Connections,
        connection3
    )
end

