--==============================================================
-- GLOBAL VALUE SYSTEM
--==============================================================

function Library:SetValue(
    name,
    value
)

    if name == nil then
        return
    end

    Library.Values[
        tostring(name)
    ] =
        value

end

function Library:GetValue(
    name
)

    if name == nil then
        return nil
    end

    return Library.Values[
        tostring(name)
    ]

end

function Library:RemoveValue(
    name
)

    if name == nil then
        return
    end

    Library.Values[
        tostring(name)
    ] =
        nil

end

--==============================================================
-- DESTROY LIBRARY
--==============================================================

function Library:Destroy()

    if Library.Unloaded then
        return
    end

    Library.Unloaded =
        true

    -- Disconnect global connections

    for _, connection in ipairs(
        Library.Connections
    ) do

        pcall(function()

            if connection then
                connection:Disconnect()
            end

        end)

    end

    table.clear(
        Library.Connections
    )

    -- Destroy windows

    for _, window in ipairs(
        Library.Windows
    ) do

        if window
            and window.ScreenGui then

            pcall(function()

                window.ScreenGui:Destroy()

            end)

        end

    end

    table.clear(
        Library.Windows
    )

end

--==============================================================
-- UNLOAD
--==============================================================

Library.Unload =
    function()

        Library:Destroy()

    end

