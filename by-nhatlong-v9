                    "LONG_Tertiary",
                    true
                )

                Corner(
                    ContainerSlider,
                    8
                )

                local Label =
                    New(
                        "TextLabel",
                        {
                            Position =
                                UDim2.fromOffset(
                                    12,
                                    5
                                ),

                            Size =
                                UDim2.new(
                                    1,
                                    -80,
                                    0,
                                    20
                                ),

                            BackgroundTransparency = 1,

                            Text =
                                tostring(
                                    text or "Slider"
                                ),

                            Font =
                                Enum.Font.GothamMedium,

                            TextSize = 12,

                            TextColor3 =
                                Library.Theme.Text,

                            TextXAlignment =
                                Enum.TextXAlignment.Left
                        },
                        ContainerSlider
                    )

                Label:SetAttribute(
                    "LONG_Text",
                    true
                )

                local ValueLabel =
                    New(
                        "TextLabel",
                        {
                            Position =
                                UDim2.new(
                                    1,
                                    -65,
                                    0,
                                    5
                                ),

                            Size =
                                UDim2.fromOffset(
                                    55,
                                    20
                                ),

                            BackgroundTransparency = 1,

                            Text =
                                tostring(
                                    value
                                ),

                            Font =
                                Enum.Font.GothamBold,

                            TextSize = 11,

                            TextColor3 =
                                Library.Theme.Accent,

                            TextXAlignment =
                                Enum.TextXAlignment.Right
                        },
                        ContainerSlider
                    )

                ValueLabel:SetAttribute(
                    "LONG_AccentText",
                    true
                )

                local Bar =
                    New(
                        "Frame",
                        {
                            Position =
                                UDim2.fromOffset(
                                    12,
                                    35
                                ),

                            Size =
                                UDim2.new(
                                    1,
                                    -24,
                                    0,
                                    6
                                ),

                            BackgroundColor3 =
                                Library.Theme.SliderBackground,

                            BorderSizePixel = 0
                        },
                        ContainerSlider
                    )

                Corner(
                    Bar,
                    5
                )

                local Fill =
                    New(
                        "Frame",
                        {
                            Size =
                                UDim2.new(
                                    (
                                        value - min
                                    )
                                    /
                                    (
                                        max - min
                                    ),
                                    0,
                                    1,
                                    0
                                ),

                            BackgroundColor3 =
                                Library.Theme.Accent,

                            BorderSizePixel = 0
                        },
                        Bar
                    )

                Corner(
                    Fill,
                    5
                )

                local draggingSlider =
                    false

                local function SetValueFromX(
                    x
                )

                    if Bar.AbsoluteSize.X <= 0 then
                        return
                    end

                    local relative =
                        math.clamp(
                            x
                            - Bar.AbsolutePosition.X,

                            0,

                            Bar.AbsoluteSize.X
                        )

                    local percent =
                        relative
                        /
                        Bar.AbsoluteSize.X

                    value =
                        min
                        +
                        (
                            max - min
                        )
                        *
                        percent

                    value =
                        math.floor(
                            value + 0.5
                        )

                    local ratio =
                        (
                            value - min
                        )
                        /
                        (
                            max - min
                        )

                    Fill.Size =
                        UDim2.new(
                            ratio,
                            0,
                            1,
                            0
                        )

                    ValueLabel.Text =
                        tostring(value)

                    SafeCallback(
                        callback,
                        value
                    )
                end

                Bar.InputBegan:Connect(
                    function(input)

                        if
                            input.UserInputType ==
                            Enum.UserInputType.MouseButton1
                            or
                            input.UserInputType ==
                            Enum.UserInputType.Touch
                        then

                            draggingSlider =
                                true

                            SetValueFromX(
                                input.Position.X
                            )

                        end
                    end
                )

                UserInputService.InputChanged:Connect(
                    function(input)

                        if not draggingSlider then
                            return
                        end

                        if
                            input.UserInputType ==
                            Enum.UserInputType.MouseMovement
                            or
                            input.UserInputType ==
                            Enum.UserInputType.Touch
                        then

                            SetValueFromX(
                                input.Position.X
                            )

                        end
                    end
                )

                UserInputService.InputEnded:Connect(
                    function(input)

                        if
                            input.UserInputType ==
                            Enum.UserInputType.MouseButton1
                            or
                            input.UserInputType ==
                            Enum.UserInputType.Touch
                        then

                            draggingSlider =
                                false

                        end
                    end
                )

                local Slider = {}

                function Slider:Set(
                    newValue
                )

                    value =
                        math.clamp(
                            tonumber(
                                newValue
                            )
                            or min,
                            min,
                            max
                        )

                    local ratio =
                        (
                            value - min
                        )
                        /
                        (
                            max - min
                        )

                    Fill.Size =
                        UDim2.new(
                            ratio,
                            0,
                            1,
                            0
                        )

                    ValueLabel.Text =
                        tostring(value)

                    SafeCallback(
                        callback,
                        value
                    )
                end

                function Slider:Get()

                    return value

                end

                return Slider
            end

