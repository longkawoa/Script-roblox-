                            Font =
                                Enum.Font.GothamBold,

                            TextSize = 10,

                            TextColor3 =
                                Library.Theme.Accent,

                            BorderSizePixel = 0
                        },
                        Button
                    )

                Key:SetAttribute(
                    "LONG_AccentText",
                    true
                )

                Corner(
                    Key,
                    6
                )

                Button.MouseButton1Click:Connect(
                    function()

                        listening =
                            true

                        Key.Text =
                            Library:GetText(
                                "PressKey"
                            )

                    end
                )

                UserInputService.InputBegan:Connect(
                    function(
                        input,
                        processed
                    )

                        if processed then
                            return
                        end

                        if listening then

                            if
                                input.UserInputType ==
                                Enum.UserInputType.Keyboard
                            then

                                current =
                                    input.KeyCode

                                Key.Text =
                                    current.Name

                                listening =
                                    false

                                SafeCallback(
                                    callback,
                                    current
                                )

                            end

                            return
                        end

                        if
                            input.KeyCode ==
                            current
                        then

                            SafeCallback(
                                callback,
                                current
                            )

                        end

                    end
                )

                local Keybind = {}

                function Keybind:Set(
                    newKey
                )

                    if typeof(newKey)
                        ~= "EnumItem" then

                        return

                    end

                    current =
                        newKey

                    Key.Text =
                        newKey.Name

                end

                function Keybind:Get()

                    return current

                end

                return Keybind
            end

            return Section

        end

