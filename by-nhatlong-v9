            function Section:CreateSlider(
                text,
                min,
                max,
                default,
                callback
            )

                min =
                    tonumber(min)
                    or 0

                max =
                    tonumber(max)
                    or 100

                if max <= min then
                    max =
                        min + 1
                end

                default =
                    tonumber(default)
                    or min

                default =
                    math.clamp(
                        default,
                        min,
                        max
                    )

                local value =
                    default

                local ContainerSlider =
                    New(
                        "Frame",
                        {
                            Size =
                                UDim2.new(
                                    1,
                                    0,
                                    0,
                                    58
                                ),

