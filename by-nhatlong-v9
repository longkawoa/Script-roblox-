            local query =
                string.lower(
                    Search.Text
                )

            for _, tab in ipairs(
                WindowObject.Tabs
            ) do

                local tabName =
                    string.lower(
                        tostring(tab.Name)
                    )

                local visible =
                    query == ""
                    or
                    string.find(
                        tabName,
                        query,
                        1,
                        true
                    ) ~= nil

                if tab.Button then
                    tab.Button.Visible =
                        visible
                end
            end
        end
    )

    --==========================================================
    -- REFRESH WINDOW
    --==========================================================

    function WindowObject:Refresh()

        if not Main
            or not Main.Parent then
            return
        end

        -- Main

        Main.BackgroundColor3 =
            Library.Theme.Background

        Main.BackgroundTransparency =
            Library.Theme.Transparency

        MainStroke.Color =
            Library.Theme.Border

        -- Topbar

        Topbar.BackgroundColor3 =
            Library.Theme.Secondary

        Topbar.BackgroundTransparency =
            Library.Theme.Transparency

        -- Sidebar

        Sidebar.BackgroundColor3 =
            Library.Theme.Secondary

        Sidebar.BackgroundTransparency =
            Library.Theme.Transparency

        -- Content

        Content.BackgroundColor3 =
            Library.Theme.Background

        Content.BackgroundTransparency =
            Library.Theme.Transparency

        -- Text

        Title.TextColor3 =
            Library.Theme.Text

        Subtitle.TextColor3 =
            Library.Theme.SubText

        -- Buttons

        Minimize.BackgroundColor3 =
            Library.Theme.Tertiary

        Minimize.TextColor3 =
            Library.Theme.Text

        Close.BackgroundColor3 =
            Library.Theme.Danger

        -- Search

        Search.BackgroundColor3 =
            Library.Theme.Tertiary

        Search.BackgroundTransparency =
            Library.Theme.Transparency

        Search.TextColor3 =
            Library.Theme.Text

        Search.PlaceholderColor3 =
            Library.Theme.SubText

        Search.PlaceholderText =
            Library:GetText(
                "SearchPlaceholder"
            )

        -- Floating

        FloatingButton.BackgroundColor3 =
            Library.Theme.Accent

        -- Size

        if minimized then

            Main.Size =
                UDim2.fromOffset(
                    Library.Settings.MenuWidth,
                    58
                )

        else

            Main.Size =
                UDim2.fromOffset(
                    Library.Settings.MenuWidth,
                    Library.Settings.MenuHeight
                )

        end

        -- Sidebar

        Sidebar.Size =
            UDim2.new(
                0,
                Library.Settings.SidebarWidth,
                1,
                -58
            )

        -- Content

        Content.Position =
            UDim2.new(
                0,
                Library.Settings.SidebarWidth,
                0,
                58
            )

        Content.Size =
            UDim2.new(
                1,
                -Library.Settings.SidebarWidth,
                1,
                -58
            )

        -- Scale

        Scale.Scale =
            Library.Settings.UIScale / 100

        -- Search

        Search.Visible =
            Library.Settings.TabSearch

        -- Floating

        FloatingButton.Visible =
            Library.Settings.FloatingButton
            and not Main.Visible

        -- Corner

        for _, object in ipairs(
            Main:GetDescendants()
        ) do

            if object:IsA("UICorner") then

                object.CornerRadius =
                    UDim.new(
                        0,
                        Library.Settings.CornerRadius
                    )

            end

        end

        -- Border

        for _, object in ipairs(
            Main:GetDescendants()
        ) do

            if object:IsA("UIStroke") then
                object.Color =
                    Library.Theme.Border
            end

        end

        -- Tabs

        for _, tab in ipairs(
            WindowObject.Tabs
        ) do

            if tab.Page then

                tab.Page.ScrollBarImageColor3 =
                    Library.Theme.Accent

            end

            if tab.Button then

                tab.Button.BackgroundColor3 =
                    tab.Active
                    and Library.Theme.Tertiary
                    or Library.Theme.Secondary

            end

            if tab.Icon then

                tab.Icon.TextColor3 =
                    Library.Theme.Accent

            end

            if tab.NameLabel then

                tab.NameLabel.TextColor3 =
                    Library.Theme.Text

            end

            -- Setting tab

            if tab.IsSetting
                and tab.NameLabel then

                tab.NameLabel.Text =
                    Library:GetText(
                        "Setting"
                    )

            end

            -- Sections

            for _, section in ipairs(
                tab.Sections
            ) do

                if section.Container then

                    section.Container.BackgroundColor3 =
                        Library.Theme.Secondary

                    section.Container.BackgroundTransparency =
                        Library.Theme.Transparency

                end

                if section.Header then

                    section.Header.TextColor3 =
                        Library.Theme.Text

                end

                if section.Controls then

                    for _, control in ipairs(
                        section.Controls:GetChildren()
                    ) do

                        if control:GetAttribute(
                            "LONG_Tertiary"
                        ) then

                            control.BackgroundColor3 =
                                Library.Theme.Tertiary

                            control.BackgroundTransparency =
                                Library.Theme.Transparency

                        end

                    end

                end

            end
        end

        --======================================================
        -- SETTING TRANSLATION
        --======================================================

        for key, object in pairs(
            WindowObject.SettingElements
        ) do

            if object
                and object.Parent then

                local text =
                    Library:GetText(key)

                if object:IsA("TextLabel")
                    or object:IsA("TextButton") then

                    object.Text = text

                elseif object:IsA("TextBox") then

                    object.PlaceholderText =
                        text

                end
            end
        end

        --======================================================
        -- REFRESH CONTROL COLORS
        --======================================================

        for _, object in ipairs(
            Main:GetDescendants()
        ) do

            if object:IsA("TextLabel") then

                if object:GetAttribute(
                    "LONG_AccentText"
                ) then

                    object.TextColor3 =
                        Library.Theme.Accent

                elseif object:GetAttribute(
                    "LONG_SubText"
                ) then

                    object.TextColor3 =
                        Library.Theme.SubText

                elseif object:GetAttribute(
                    "LONG_Text"
                ) then

                    object.TextColor3 =
                        Library.Theme.Text

                end

            end

            if object:IsA("TextButton") then

                if object:GetAttribute(
                    "LONG_AccentButton"
                ) then

                    object.BackgroundColor3 =
                        Library.Theme.Accent

                end

            end

        end

    end

