-- Tạo ESP Box
local function HighlightObject(target)
    ClearEffects()
    local highlight = Instance.new("Highlight")
    highlight.Name = "ScriptTarget_ESP"
    highlight.FillColor = Color3.fromRGB(0, 255, 170)
    highlight.FillTransparency = 0.5
    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    highlight.OutlineTransparency = 0
    highlight.Adornee = target
    highlight.Parent = target
    CurrentHighlight = highlight
end

-- Render Mô hình 3D góc bên phải
local function Update3DPreview(target)
    local clone = target:Clone()
    for _, v in pairs(clone:GetDescendants()) do
        if v:IsA("LuaSourceContainer") then v:Destroy() end
    end

    local wrapper = Instance.new("Model")
    wrapper.Parent = Viewport
    clone.Parent = wrapper

    local cf, size = wrapper:GetBoundingBox()
    if size.Magnitude == 0 then
        size = Vector3.new(2, 2, 2)
        cf = target:IsA("BasePart") and target.CFrame or CFrame.new()
    end

    local maxDim = math.max(size.X, size.Y, size.Z)
    local distance = maxDim * 1.8
    
    ViewportCamera.CFrame = CFrame.new(cf.Position + Vector3.new(distance, distance * 0.5, distance), cf.Position)
    PreviewModel = wrapper
end

