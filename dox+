-- Tween Bay Đến Vật Thể
TweenBtn.MouseButton1Click:Connect(function()
    if not currentTargetPos then return end
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end

    local hrp = character.HumanoidRootPart
    local distance = (hrp.Position - currentTargetPos).Magnitude
    local speed = 120
    local tweenTime = distance / speed

    local tweenInfo = TweenInfo.new(math.clamp(tweenTime, 0.5, 10), Enum.EasingStyle.Linear)
    local tween = TweenService:Create(hrp, tweenInfo, {CFrame = CFrame.new(currentTargetPos + Vector3.new(0, 3, 0))})
    
    tween:Play()
end)

-- Bắt sự kiện chạm / click vật thể
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed or not scriptEnabled then return end
    
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        local target = Mouse.Target
        if target then
            local parentModel = target:FindFirstAncestorOfClass("Model")
            local finalTarget = (parentModel and parentModel ~= workspace) and parentModel or target
            
            local cf = target:IsA("BasePart") and target.CFrame or (finalTarget:IsA("Model") and finalTarget:GetPivot() or CFrame.new())
            currentTargetPos = cf.Position
            
            local rawVec3 = string.format("%.2f, %.2f, %.2f", currentTargetPos.X, currentTargetPos.Y, currentTargetPos.Z)
            local rawCFrame = tostring(cf)

            -- Cập nhật Textbox hiển thị
            InfoBox.Text = string.format(
                "• Tên: %s\n\n• Code Path:\n%s\n\n• Vector3:\n%s\n\n• CFrame:\n%s",
                finalTarget.Name,
                finalTarget:GetFullName(),
                rawVec3,
                rawCFrame
            )
            
            HighlightObject(finalTarget)
            pcall(function() Update3DPreview(finalTarget) end)
        end
    end
end)
