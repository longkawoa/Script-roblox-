    local function AddRGB(
        themeKey,
        translationKey
    )

        ColorSection:CreateTextbox(
            Library:GetText(
                translationKey
            ),
            Library:GetText(
                "RGBPlaceholder"
            ),
            function(text)

                local r, g, b =
                    string.match(
                        text,
                        "(%d+)%s*,%s*(%d+)%s*,%s*(%d+)"
                    )

                if r and g and b then

                    Library:SetColor(
                        themeKey,
                        tonumber(r),
                        tonumber(g),
                        tonumber(b)
                    )

                end

            end
        )

        -- tìm label mới nhất

        for _, child in ipairs(
            ColorSection.Controls:GetChildren()
        ) do

            if child:IsA("Frame") then

                local label =
                    child:FindFirstChildWhichIsA(
                        "TextLabel"
                    )

                if label
                    and label.Text ==
                        Library:GetText(
                            translationKey
                        ) then

                    label:SetAttribute(
                        "LONG_Translation",
                        translationKey
                    )

                    RegisterSetting(
                        label,
                        translationKey
                    )

                end

            end

        end

    end

