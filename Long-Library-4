    local fpsConnection

    fpsConnection =
        RunService.RenderStepped:Connect(
            function(dt)

                if not FPSLabel
                    or not FPSLabel.Parent then
                    return
                end

                if Library.Settings.ShowFPS then

                    local fps =
                        math.floor(
                            1
                            / math.max(
                                dt,
                                0.001
                            )
                        )

                    FPSLabel.Text =
                        "FPS: "
                        .. tostring(fps)

                end

            end
        )

    table.insert(
        WindowObject.Connections,
        fpsConnection
    )

