    --==================================================
    -- FIT SCREEN
    --==================================================

    function WindowObject:FitToScreen()

        local camera =
            workspace.CurrentCamera

        if not camera then
            return
        end

        local viewport =
            camera.ViewportSize

        local scale =
            Library.Settings.UIScale / 100

        if scale <= 0 then
            scale = 1
        end

        local width =
            Library.Settings.MenuWidth

        local height =
            Library.Settings.MenuHeight

        if Library.Settings.AutoFit then

            width =
                math.min(
                    width,
                    math.max(
                        300,
                        math.floor(
                            viewport.X / scale
                        ) - 24
                    )
                )

            height =
                math.min(
                    height,
                    math.max(
                        240,
                        math.floor(
                            viewport.Y / scale
                        ) - 24
                    )
                )

        end

        if minimized then
            height = 58
        end

        Main.Size =
            UDim2.fromOffset(
                width,
                height
            )

        self:ClampPosition()

    end

    --==================================================
    -- CLAMP POSITION
    --==================================================

    function WindowObject:ClampPosition()

        local camera =
            workspace.CurrentCamera

        if not camera then
            return
        end

        local viewport =
            camera.ViewportSize

        local scale =
            Library.Settings.UIScale / 100

        local absoluteWidth =
            Main.AbsoluteSize.X / math.max(scale, 0.01)

        local absoluteHeight =
            Main.AbsoluteSize.Y / math.max(scale, 0.01)

        local pos =
            Main.Position

        local x =
            pos.X.Offset

        local y =
            pos.Y.Offset

        if pos.X.Scale ~= 0 then
            x = viewport.X / 2
        end

        if pos.Y.Scale ~= 0 then
            y = viewport.Y / 2
        end

        local halfW =
            absoluteWidth / 2

        local halfH =
            absoluteHeight / 2

        local minX =
            -viewport.X / 2
            + halfW
            - viewport.X / 2

        local maxX =
            viewport.X / 2
            - halfW

        local minY =
            -viewport.Y / 2
            + halfH
            - viewport.Y / 2

        local maxY =
            viewport.Y / 2
            - halfH

        if absoluteWidth < viewport.X then

            Main.AnchorPoint =
                Vector2.new(
                    0.5,
                    0.5
                )

            Main.Position =
                UDim2.fromOffset(
                    math.clamp(
                        viewport.X / 2,
                        halfW + 10,
                        viewport.X - halfW - 10
                    ),
                    math.clamp(
                        viewport.Y / 2,
                        halfH + 10,
                        viewport.Y - halfH - 10
                    )
                )

        else

            Main.Position =
                UDim2.fromScale(
                    0.5,
                    0.5
                )

        end

    end

