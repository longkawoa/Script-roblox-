                    )

                Mark(
                    ValueLabel,
                    "Text"
                )

                local Open =
                    false

                local function GetSelected()

                    local result = {}

                    for value, enabled in pairs(
                        selected
                    ) do

                        if enabled then

                            table.insert(
                                result,
                                value
                            )

                        end

                    end

                    table.sort(
                        result,
                        function(a, b)
                            return tostring(a)
                                < tostring(b)
                        end
                    )

                    return result

                end

                local function UpdateText()

                    local result =
                        GetSelected()

                    if #result == 0 then

                        ValueLabel.Text =
                            "None"

                    else

                        ValueLabel.Text =
                            table.concat(
                                result,
                                ", "
                            )

                    end

                end

                local function ClearOptions()

                    for _, child in ipairs(
                        Button:GetChildren()
                    ) do

                        if child:GetAttribute(
                            "LONG_DropdownOption"
                        ) then

                            child:Destroy()

                        end

