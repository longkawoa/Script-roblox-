    local cameraConnection

    local function ConnectCamera()

        local camera =
            workspace.CurrentCamera

        if not camera then
            return
        end

        cameraConnection =
            camera:GetPropertyChangedSignal(
                "ViewportSize"
            ):Connect(
                function()

                    if Library.Settings.AutoFit then
                        WindowObject:FitToScreen()
                    end

                end
            )

        table.insert(
            WindowObject.Connections,
            cameraConnection
        )

    end

    ConnectCamera()

