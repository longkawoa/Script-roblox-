    --==================================================

    function WindowObject:GetTab(
        name
    )

        for _, tab in ipairs(
            self.Tabs
        ) do

            if tab.Name ==
                name then

                return tab

            end

        end

        return nil

    end

    --==================================================
    -- DESTROY WINDOW
    --==================================================

    function WindowObject:Destroy()

        for _, connection in ipairs(
            self.Connections
        ) do

            pcall(function()
                connection:Disconnect()
            end)

        end

        table.clear(
            self.Connections
        )

        if self.ScreenGui then

            pcall(function()
                self.ScreenGui:Destroy()
            end)

        end

    end

    --==================================================
    -- REGISTER WINDOW
    --==================================================

    table.insert(
        Library.Windows,
        WindowObject
    )

    --==================================================
    -- INITIAL
    --==================================================

    ForceSettingLast()

    WindowObject:Refresh()

    --==================================================
    -- DEFAULT TAB
    --==================================================

    local firstNormalTab

    for _, tab in ipairs(
        WindowObject.Tabs
    ) do

        if not tab.IsSetting then

            firstNormalTab =
                tab

            break

        end

    end

    if firstNormalTab then

        firstNormalTab:Activate()

    else

        SettingTab:Activate()

    end

    return WindowObject

end

--==================================================
-- GLOBAL VALUE SYSTEM
--==================================================

function Library:SetValue(
    name,
    value
)

    Library.Values[name] =
        value

end

function Library:GetValue(
    name
)

    return Library.Values[name]

end

--==================================================
-- DESTROY LIBRARY
--==================================================

function Library:Destroy()

    if Library.Unloaded then
        return
    end

    Library.Unloaded =
        true

    for _, window in ipairs(
        Library.Windows
    ) do

        if window.Destroy then

            pcall(function()
                window:Destroy()
            end)

        elseif window.ScreenGui then

            pcall(function()
                window.ScreenGui:Destroy()
            end)

        end

    end

    table.clear(
        Library.Windows
    )

end

--==================================================
-- UNLOAD
--==================================================

Library.Unload =
    function()

        Library:Destroy()

    end

--==================================================
-- RETURN
--==================================================

return Library
