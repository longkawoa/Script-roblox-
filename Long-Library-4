    local function ForceSettingLast()

        SettingTab.IsSetting =
            true

        SettingTab.Button.LayoutOrder =
            999999999

        local normalIndex =
            1

        for _, tab in ipairs(
            WindowObject.Tabs
        ) do

            if tab ~= SettingTab then

                tab.IsSetting =
                    false

                tab.Button.LayoutOrder =
                    normalIndex

                normalIndex += 1

            end

        end

    end

