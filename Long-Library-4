                                            8,
                                            46
                                            + (
                                                (i - 1)
                                                * 32
                                            )
                                        ),

                                    Size =
                                        UDim2.new(
                                            1,
                                            -16,
                                            0,
                                            28
                                        ),

                                    BackgroundColor3 =
                                        selected[option]
                                        and Library.Theme.Accent
                                        or Library.Theme.Secondary,

                                    Text =
                                        tostring(
                                            option
                                        ),

                                    Font =
                                        Enum.Font.Gotham,

                                    TextSize = 11,

                                    TextColor3 =
                                        selected[option]
                                        and GetAccentText()
                                        or Library.Theme.Text,

                                    AutoButtonColor = false,

                                    BorderSizePixel = 0
                                },
                                Button
                            )

                        Option:SetAttribute(
                            "LONG_DropdownOption",
                            true
                        )

                        Corner(
                            Option,
                            6
                        )

                        Option.MouseButton1Click:Connect(
                            function()

                                selected[option] =
                                    not selected[option]

                                Option.BackgroundColor3 =
                                    selected[option]
                                    and Library.Theme.Accent
                                    or Library.Theme.Secondary

                                Option.TextColor3 =
                                    selected[option]
                                    and GetAccentText()
                                    or Library.Theme.Text

                                UpdateText()

                                if callback then

                                    task.spawn(
                                        callback,
                                        GetSelected()
                                    )

                                end

                            end
                        )

                    end

                end

                Button.MouseButton1Click:Connect(
                    function()

                        if Library.Settings.LockUI then
                            return
                        end

                        if Open then
                            Close()
                        else
                            OpenDropdown()
                        end

                    end
                )

                UpdateText()

                local Dropdown = {}

                Dropdown.Label =
                    Label

                function Dropdown:Set(
                    newValues,
                    fire
                )

                    selected = {}

                    for _, value in ipairs(
                        newValues or {}
                    ) do

                        selected[value] =
                            true

                    end

                    UpdateText()

                    if fire ~= false
                        and callback then

                        task.spawn(
                            callback,
                            GetSelected()
                        )

                    end

                end

                function Dropdown:Get()

                    return GetSelected()

                end

                return Dropdown
            end

