-- DRAG
--==================================================

local function BindDrag(window, frame, target)

    local dragging = false
    local dragStart
    local startPosition

    local connection

    connection =
        frame.InputBegan:Connect(
            function(input)

                if Library.Settings.LockUI then
                    return
                end

                if not Library.Settings.Dragging then
                    return
                end

                if input.UserInputType ==
                    Enum.UserInputType.MouseButton1
                    or input.UserInputType ==
                    Enum.UserInputType.Touch then

                    dragging = true

                    dragStart =
                        input.Position

                    startPosition =
                        target.Position

                    local changed

                    changed =
                        input.Changed:Connect(
                            function()

                                if input.UserInputState ==
                                    Enum.UserInputState.End then

                                    dragging = false

                                    if changed then
                                        changed:Disconnect()
                                    end
                                end

                            end
                        )

                end

            end
        )

    table.insert(
        window.Connections,
        connection
    )

    connection =
        UserInputService.InputChanged:Connect(
            function(input)

                if not dragging then
                    return
                end

                if input.UserInputType ==
                    Enum.UserInputType.MouseMovement
                    or input.UserInputType ==
                    Enum.UserInputType.Touch then

                    local delta =
                        input.Position
                        - dragStart

                    target.Position =
                        UDim2.new(
                            startPosition.X.Scale,
                            startPosition.X.Offset + delta.X,

                            startPosition.Y.Scale,
                            startPosition.Y.Offset + delta.Y
                        )

                end

            end
        )

    table.insert(
        window.Connections,
        connection
    )
end

--==================================================
-- TRANSLATION
--==================================================

function Library:GetText(key)

    local current =
        Library.Languages[
            Library.Settings.Language
        ]

    if current and current[key] then
        return current[key]
    end

    local english =
        Library.Languages.English

    return english[key] or key
end

function Library:SetLanguage(language)

    if not Library.Languages[language] then
        return false
    end

    Library.Settings.Language =
        language

    Library:RefreshAll()

    return true
end

--==================================================
-- ICON
--==================================================

function Library:GetTabIcon(name)

    if Library.TabIcons[name] then
        return Library.TabIcons[name]
    end

    local clean =
        string.gsub(
            tostring(name),
            "%s+",
            ""
        )

    return Library.TabIcons[clean]
        or "●"
end

--==================================================
-- THEME
--==================================================

function Library:SetTheme(theme)

    if type(theme) == "string" then

        local preset =
            Library.ThemePresets[theme]

        if not preset then
            return false
        end

        Library.Settings.ThemePreset =
            theme

        for key, value in pairs(preset) do
            Library.Theme[key] = value
        end

    elseif type(theme) == "table" then

        Library.Settings.ThemePreset =
            "Custom"

        for key, value in pairs(theme) do

            if Library.Theme[key] ~= nil then
                Library.Theme[key] = value
            end

        end

    else
        return false
    end

    Library.Theme.AccentText =
        GetAccentText()

    Library:RefreshAll()

    return true
end

--==================================================
-- ACCENT
--==================================================

function Library:SetAccent(name)

    local color =
        Library.AccentPresets[name]

    if not color then
        return false
    end

    Library.Theme.Accent =
        color

    Library.Theme.AccentText =
        GetAccentText()

    Library.Settings.AccentPreset =
        name

    Library:RefreshAll()

    return true
end

--==================================================
-- CUSTOM COLOR
--==================================================

function Library:SetColor(name, r, g, b)

    if Library.Theme[name] == nil then
        return false
    end

    r =
        math.clamp(
            tonumber(r) or 0,
            0,
            255
        )

    g =
        math.clamp(
            tonumber(g) or 0,
            0,
            255
        )

    b =
        math.clamp(
            tonumber(b) or 0,
            0,
            255
        )

    Library.Theme[name] =
        Color3.fromRGB(
            r,
            g,
            b
        )

    Library.Settings.ThemePreset =
        "Custom"

    if name == "Accent" then

        Library.Theme.AccentText =
            GetAccentText()

    end

    Library:RefreshAll()

    return true
end

--==================================================
-- REFRESH
--==================================================

function Library:RefreshAll()

    for _, window in ipairs(
        Library.Windows
    ) do

        if window.Refresh then

            pcall(function()
                window:Refresh()
            end)

        end

    end
end

