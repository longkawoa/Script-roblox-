        --==================================================

        function WindowObject:RefreshTabOrder()

            local normalIndex =
                1

            for _, tab in ipairs(
                self.Tabs
            ) do

                if tab.IsSetting then

                    tab.Button.LayoutOrder =
                        999999

                else

                    tab.Button.LayoutOrder =
                        normalIndex

                    normalIndex += 1

                end

            end

        end

        WindowObject.RefreshTabOrder =
            WindowObject.RefreshTabOrder

        selfWindow = nil

        --==================================================
        -- AUTOMATIC DEFAULT
        --==================================================

        if not WindowObject.CurrentTab
            and not Tab.IsSetting then

            Tab:Activate()

        end

        return Tab

    end

