                end

            elseif role == "SliderBackground" then

                if object:IsA("Frame") then

                    object.BackgroundColor3 =
                        Library.Theme.SliderBackground

                end

            end

        end

        -- TABS

        for _, tab in ipairs(
            WindowObject.Tabs
        ) do

            tab.Button.BackgroundColor3 =
                tab.Active
                and Library.Theme.Tertiary
                or Library.Theme.Secondary

            tab.Icon.TextColor3 =
                Library.Theme.Accent

            tab.NameLabel.TextColor3 =
                Library.Theme.Text

            tab.Page.ScrollBarImageColor3 =
                Library.Theme.Accent

            for _, section in ipairs(
                tab.Sections
            ) do

                if section.Container then

                    section.Container.BackgroundColor3 =
                        Library.Theme.Secondary

                    section.Container.BackgroundTransparency =
                        GetTransparency(
                            "Secondary"
                        )

                end

                if section.Header then

                    section.Header.TextColor3 =
                        Library.Theme.Text

                end

            end

        end

        -- TRANSLATION

        for _, item in ipairs(
            WindowObject.SettingElements
        ) do

            if item.Object
                and item.Object.Parent
                and item.Key then

                if item.Type == "Header"
                    or item.Type == "Text" then

                    item.Object.Text =
                        Library:GetText(
                            item.Key
                        )

                end

            end

        end

        -- SIZE

        self:FitToScreen()

    end

