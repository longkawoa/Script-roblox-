                                    73,
                                    28
                                ),

                            BackgroundColor3 =
                                Library.Theme.Secondary,

                            BackgroundTransparency =
                                GetTransparency(
                                    "Secondary"
                                ),

                            Text =
                                current.Name,

                            Font =
                                Enum.Font.GothamBold,

                            TextSize = 10,

                            TextColor3 =
                                Library.Theme.Accent,

                            BorderSizePixel = 0
                        },
                        Button
                    )

                Mark(
                    Key,
                    "AccentText"
                )

                Corner(
                    Key,
                    6
                )

                Button.MouseButton1Click:Connect(
                    function()

                        if Library.Settings.LockUI then
                            return
                        end

                        listening =
                            true

                        Key.Text =
                            "Press key"

                    end
                )

                local connection =
                    UserInputService.InputBegan:Connect(
                        function(
                            input,
                            processed
                        )

                            if processed then
                                return
                            end

                            if listening then

                                if input.UserInputType ==
                                    Enum.UserInputType.Keyboard then

                                    current =
                                        input.KeyCode

                                    Key.Text =
                                        current.Name

                                    listening =
                                        false

                                    if callback then

                                        task.spawn(
                                            callback,
                                            current
                                        )

                                    end

                                end

                                return

                            end

                            if input.KeyCode ==
                                current then

                                if callback then

                                    task.spawn(
                                        callback,
                                        current
                                    )

                                end

                            end

                        end
                    )

                table.insert(
                    WindowObject.Connections,
                    connection
                )

                local Keybind = {}

                function Keybind:Set(
                    newKey,
                    fire
                )

                    if typeof(newKey) ~=
                        "EnumItem" then
                        return
                    end

                    current =
                        newKey

                    Key.Text =
                        current.Name

                    if fire ~= false
                        and callback then

                        task.spawn(
                            callback,
                            current
                        )

                    end

                end

                function Keybind:Get()

                    return current

                end

                return Keybind
            end

        end

