            function Section:CreateSlider(text, min, max, default, callback)

                min = min or 0
                max = max or 100
                default = math.clamp(default or min, min, max)

                local value = default

                local ContainerSlider = New(
                    "Frame",
                    {
                        Size = UDim2.new(1, 0, 0, 58),

                        BackgroundColor3 = Library.Theme.Tertiary,

                        BorderSizePixel = 0
                    },
                    Controls
                )

                Corner(ContainerSlider, 8)

                local Label = New(
                    "TextLabel",
                    {
                        Position = UDim2.fromOffset(12, 5),

                        Size = UDim2.new(1, -80, 0, 20),

                        BackgroundTransparency = 1,

                        Text = text,

                        Font = Enum.Font.GothamMedium,

                        TextSize = 12,

                        TextColor3 = Library.Theme.Text,

                        TextXAlignment = Enum.TextXAlignment.Left
                    },
                    ContainerSlider
                )

                local ValueLabel = New(
                    "TextLabel",
                    {
                        Position = UDim2.new(1, -65, 5, 0),

                        Size = UDim2.fromOffset(55, 20),

                        BackgroundTransparency = 1,

                        Text = tostring(value),

                        Font = Enum.Font.GothamBold,

                        TextSize = 11,

                        TextColor3 = Library.Theme.Accent,

                        TextXAlignment = Enum.TextXAlignment.Right
                    },
                    ContainerSlider
                )

                local Bar = New(
                    "Frame",
                    {
                        Position = UDim2.new(0, 12, 0, 35),

                        Size = UDim2.new(1, -24, 0, 6),

                        BackgroundColor3 = Library.Theme.SliderBackground,

                        BorderSizePixel = 0
                    },
                    ContainerSlider
                )

                Corner(Bar, 5)

                local Fill = New(
                    "Frame",
                    {
                        Size = UDim2.new(
                            (value - min) / (max - min),
                            0,
                            1,
                            0
                        ),

                        BackgroundColor3 = Library.Theme.Accent,

                        BorderSizePixel = 0
                    },
                    Bar
                )

                Corner(Fill, 5)

                local dragging = false

                local function SetValueFromX(x)

                    local relative =
                        math.clamp(
                            x - Bar.AbsolutePosition.X,
                            0,
                            Bar.AbsoluteSize.X
                        )

                    local percent =
                        relative / Bar.AbsoluteSize.X

                    value =
                        min
                        + (max - min) * percent

                    value = math.floor(value + 0.5)

                    Fill.Size = UDim2.new(
                        (value - min) / (max - min),
                        0,
                        1,
                        0
                    )

                    ValueLabel.Text = tostring(value)

                    if callback then
                        task.spawn(callback, value)
                    end
                end

                Bar.InputBegan:Connect(function(input)

                    if input.UserInputType == Enum.UserInputType.MouseButton1
                        or input.UserInputType == Enum.UserInputType.Touch then

                        dragging = true

                        SetValueFromX(input.Position.X)
                    end
                end)

                UserInputService.InputChanged:Connect(function(input)

                    if dragging then

                        if input.UserInputType == Enum.UserInputType.MouseMovement
                            or input.UserInputType == Enum.UserInputType.Touch then

                            SetValueFromX(input.Position.X)
                        end
                    end
                end)

                UserInputService.InputEnded:Connect(function(input)

                    if input.UserInputType == Enum.UserInputType.MouseButton1
                        or input.UserInputType == Enum.UserInputType.Touch then

                        dragging = false
                    end
                end)

                local Slider = {}

                function Slider:Set(newValue)

                    value = math.clamp(newValue, min, max)

                    Fill.Size = UDim2.new(
                        (value - min) / (max - min),
                        0,
                        1,
                        0
                    )

                    ValueLabel.Text = tostring(value)

                    if callback then
                        task.spawn(callback, value)
                    end
                end

                function Slider:Get()

                    return value
                end

                return Slider
            end

