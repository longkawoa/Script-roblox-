    function WindowObject:Notify(title, message, duration)

        if not Library.Settings.Notifications then
            return
        end

        duration = duration or 3

        local Holder = ScreenGui:FindFirstChild("Notifications")

        if not Holder then

            Holder = New(
                "Frame",
                {
                    Name = "Notifications",

                    Position = UDim2.new(
                        1,
                        -20,
                        0,
                        20
                    ),

                    AnchorPoint = Vector2.new(1, 0),

                    Size = UDim2.fromOffset(320, 400),

                    BackgroundTransparency = 1
                },
                ScreenGui
            )

            local Layout = New(
                "UIListLayout",
                {
                    Padding = UDim.new(0, 8),

                    HorizontalAlignment =
                        Enum.HorizontalAlignment.Right,

                    VerticalAlignment =
                        Enum.VerticalAlignment.Top
                },
                Holder
            )
        end

        local Notification = New(
            "Frame",
            {
                Size = UDim2.fromOffset(300, 72),

                BackgroundColor3 = Library.Theme.Secondary,

                BorderSizePixel = 0
            },
            Holder
        )

        Corner(Notification, 9)
        Stroke(Notification)

        local TitleLabel = New(
            "TextLabel",
            {
                Position = UDim2.fromOffset(12, 8),

                Size = UDim2.new(1, -24, 0, 20),

                BackgroundTransparency = 1,

                Text = title,

                Font = Enum.Font.GothamBold,

                TextSize = 13,

                TextColor3 = Library.Theme.Accent,

                TextXAlignment = Enum.TextXAlignment.Left
            },
            Notification
        )

        local MessageLabel = New(
            "TextLabel",
            {
                Position = UDim2.fromOffset(12, 29),

                Size = UDim2.new(1, -24, 0, 35),

                BackgroundTransparency = 1,

                Text = message,

                Font = Enum.Font.Gotham,

                TextSize = 11,

                TextColor3 = Library.Theme.Text,

                TextWrapped = true,

                TextXAlignment = Enum.TextXAlignment.Left,

                TextYAlignment = Enum.TextYAlignment.Top
            },
            Notification
        )

        task.delay(duration, function()

            if Notification then

                Tween(
                    Notification,
                    {
                        BackgroundTransparency = 1
                    },
                    0.2
                )

                task.wait(0.22)

                Notification:Destroy()
            end
        end)
    end

