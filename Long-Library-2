            function Section:CreateMultiDropdown(text, values, default, callback)

                values = values or {}
                default = default or {}

                local selected = {}

                for _, value in ipairs(default) do
                    selected[value] = true
                end

                local Button = New(
                    "TextButton",
                    {
                        Size = UDim2.new(1, 0, 0, 46),

                        BackgroundColor3 = Library.Theme.Tertiary,

                        Text = "",

                        AutoButtonColor = false,

                        BorderSizePixel = 0
                    },
                    Controls
                )

                Corner(Button, 8)

                local Label = New(
                    "TextLabel",
                    {
                        Position = UDim2.fromOffset(12, 3),

                        Size = UDim2.new(1, -24, 0, 18),

                        BackgroundTransparency = 1,

                        Text = text,

                        Font = Enum.Font.GothamMedium,

                        TextSize = 11,

                        TextColor3 = Library.Theme.SubText,

                        TextXAlignment = Enum.TextXAlignment.Left
                    },
                    Button
                )

                local ValueLabel = New(
                    "TextLabel",
                    {
                        Position = UDim2.fromOffset(12, 20),

                        Size = UDim2.new(1, -24, 0, 20),

                        BackgroundTransparency = 1,

                        Text = "None",

                        Font = Enum.Font.GothamMedium,

                        TextSize = 12,

                        TextColor3 = Library.Theme.Text,

                        TextXAlignment = Enum.TextXAlignment.Left
                    },
                    Button
                )

                local Open = false

                local function UpdateText()

                    local result = {}

                    for value, enabled in pairs(selected) do

                        if enabled then
                            table.insert(result, tostring(value))
                        end
                    end

                    if #result == 0 then
                        ValueLabel.Text = "None"
                    else
                        ValueLabel.Text = table.concat(result, ", ")
                    end
                end

                Button.MouseButton1Click:Connect(function()

                    Open = not Open

                    if Open then

                        Button.Size = UDim2.new(
                            1,
                            0,
                            0,
                            46 + (#values * 32)
                        )

                        for i, option in ipairs(values) do

                            local Option = New(
                                "TextButton",
                                {
                                    Position = UDim2.fromOffset(
                                        8,
                                        46 + ((i - 1) * 32)
                                    ),

                                    Size = UDim2.new(1, -16, 0, 28),

                                    BackgroundColor3 =
                                        selected[option]
                                        and Library.Theme.Accent
                                        or Library.Theme.Secondary,

                                    Text = tostring(option),

                                    Font = Enum.Font.Gotham,

                                    TextSize = 11,

                                    TextColor3 = Library.Theme.Text,

                                    AutoButtonColor = false
                                },
                                Button
                            )

                            Corner(Option, 6)

                            Option.MouseButton1Click:Connect(function()

                                selected[option] =
                                    not selected[option]

                                Option.BackgroundColor3 =
                                    selected[option]
                                    and Library.Theme.Accent
                                    or Library.Theme.Secondary

                                UpdateText()

                                if callback then

                                    local result = {}

                                    for value, enabled in pairs(selected) do

                                        if enabled then
                                            table.insert(result, value)
                                        end
                                    end

                                    task.spawn(callback, result)
                                end
                            end)
                        end

                    else

                        Button.Size = UDim2.new(
                            1,
                            0,
                            0,
                            46
                        )

                        for _, child in ipairs(Button:GetChildren()) do

                            if child:IsA("TextButton")
                                and child ~= Button then

                                child:Destroy()
                            end
                        end
                    end
                end)

                UpdateText()

                local Dropdown = {}

                function Dropdown:Set(newValues)

                    selected = {}

                    for _, value in ipairs(newValues or {}) do
                        selected[value] = true
                    end

                    UpdateText()
                end

                function Dropdown:Get()

                    local result = {}

                    for value, enabled in pairs(selected) do

                        if enabled then
                            table.insert(result, value)
                        end
                    end

                    return result
                end

                return Dropdown
            end

