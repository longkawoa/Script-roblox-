    ColorSection:CreateTextbox(
        "SubText",
        "R,G,B",
        function(text)

            local r, g, b =
                string.match(
                    text,
                    "(%d+)%s*,%s*(%d+)%s*,%s*(%d+)"
                )

            if r and g and b then

                Library.Theme.SubText =
                    Color3.fromRGB(
                        tonumber(r),
                        tonumber(g),
                        tonumber(b)
                    )

                Library.Settings.ThemePreset = "Custom"

                Library:RefreshAll()
            end
        end
    )

    ColorSection:CreateTextbox(
        "Border",
        "R,G,B",
        function(text)

            local r, g, b =
                string.match(
                    text,
                    "(%d+)%s*,%s*(%d+)%s*,%s*(%d+)"
                )

            if r and g and b then

                Library.Theme.Border =
                    Color3.fromRGB(
                        tonumber(r),
                        tonumber(g),
                        tonumber(b)
                    )

                Library.Settings.ThemePreset = "Custom"

                Library:RefreshAll()
            end
        end
    )

    --==================================================
    -- RESET
    --==================================================

    local ResetSection =
        SettingTab:CreateSection("Reset / Library")

    ResetSection:CreateButton(
        "Reset UI Settings",
        function()

            for key, value in pairs(Library.DefaultSettings) do
                Library.Settings[key] = value
            end

            Library:SetTheme("Purple")

            WindowObject:Refresh()

            WindowObject:Notify(
                "Settings",
                "All UI settings have been reset.",
                3
            )
        end
    )

    ResetSection:CreateButton(
        "Restore Window",
        function()

            Main.Visible = true
            FloatingButton.Visible = false

            WindowObject:Notify(
                "Window",
                "Window restored.",
                2
            )
        end
    )

    ResetSection:CreateButton(
        "Unload Library",
        function()

            Library:Destroy()
        end
    )

    --==================================================
    -- REGISTER WINDOW
    --==================================================

    table.insert(
        Library.Windows,
        WindowObject
    )

    --==================================================
    -- DEFAULT TAB
    --==================================================

    local firstNormalTab

    for _, tab in ipairs(WindowObject.Tabs) do

        if tab ~= SettingTab then
            firstNormalTab = tab
            break
        end
    end

    -- Setting exists automatically.
    -- If user creates another tab later, it can become active normally.

    if not firstNormalTab then
        SettingTab:Activate()
    end

    --==================================================
    -- WINDOW API
    --==================================================

    function WindowObject:SetTitle(title)

        WindowObject.Title = title
        Title.Text = title
    end

    function WindowObject:SetSubtitle(subtitle)

        WindowObject.Subtitle = subtitle
        Subtitle.Text = subtitle
    end

    function WindowObject:SetSize(width, height)

        Library.Settings.MenuWidth = width
        Library.Settings.MenuHeight = height

        WindowObject:Refresh()
    end

    function WindowObject:SetSidebarWidth(width)

        Library.Settings.SidebarWidth = width

        WindowObject:Refresh()
    end

    function WindowObject:SetScale(scale)

        Library.Settings.UIScale =
            math.clamp(scale, 70, 130)

        WindowObject:Refresh()
    end

    function WindowObject:Show()

        Main.Visible = true
        FloatingButton.Visible = false
    end

    function WindowObject:Hide()

        Main.Visible = false

        if Library.Settings.FloatingButton then
            FloatingButton.Visible = true
        end
    end

    function WindowObject:Toggle()

        if Main.Visible then
            self:Hide()
        else
            self:Show()
        end
    end

    --==================================================
    -- INITIAL REFRESH
    --==================================================

    WindowObject:Refresh()

    return WindowObject
end

--==================================================
-- GLOBAL VALUE SYSTEM
--==================================================

Library.Values = {}

function Library:SetValue(name, value)

    Library.Values[name] = value
end

function Library:GetValue(name)

    return Library.Values[name]
end

--==================================================
-- DESTROY
--==================================================

function Library:Destroy()

    for _, window in pairs(Library.Windows) do

        if window.ScreenGui then
            pcall(function()
                window.ScreenGui:Destroy()
            end)
        end
    end

    table.clear(Library.Windows)

    Library.Unloaded = true
end

Library.Unload = function()

    Library:Destroy()
end

--==================================================
-- RETURN
--==================================================

return Library
