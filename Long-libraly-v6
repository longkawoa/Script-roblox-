    Corner(Close, 7)

    -- SIDEBAR & SEARCH
    local Sidebar = New("Frame", { Name = "Sidebar", Position = UDim2.fromOffset(0, 58), Size = UDim2.new(0, Library.Settings.SidebarWidth, 1, -58), BackgroundColor3 = Library.Theme.Secondary, BackgroundTransparency = Library.Theme.Transparency, BorderSizePixel = 0, ClipsDescendants = true }, Main)
    local Search = New("TextBox", { Name = "TabSearch", Position = UDim2.fromOffset(9, 9), Size = UDim2.new(1, -18, 0, 34), BackgroundColor3 = Library.Theme.Tertiary, BackgroundTransparency = Library.Theme.Transparency, PlaceholderColor3 = Library.Theme.SubText, Text = "", Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = Library.Theme.Text, ClearTextOnFocus = false, BorderSizePixel = 0 }, Sidebar)
    Corner(Search, 8)
    Library:RegisterText(Search, "SearchPlaceholder")

    local TabList = New("ScrollingFrame", { Name = "TabList", Position = UDim2.fromOffset(8, 51), Size = UDim2.new(1, -16, 1, -59), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 2, ScrollBarImageColor3 = Library.Theme.Accent, CanvasSize = UDim2.new(0, 0, 0, 0), AutomaticCanvasSize = Enum.AutomaticSize.Y, ClipsDescendants = true }, Sidebar)
    New("UIListLayout", { Padding = UDim.new(0, 5), SortOrder = Enum.SortOrder.LayoutOrder }, TabList)

    -- CONTENT
    local Content = New("Frame", { Name = "Content", Position = UDim2.new(0, Library.Settings.SidebarWidth, 0, 58), Size = UDim2.new(1, -Library.Settings.SidebarWidth, 1, -58), BackgroundColor3 = Library.Theme.Background, BackgroundTransparency = Library.Theme.Transparency, BorderSizePixel = 0, ClipsDescendants = true }, Main)

    -- FLOATING BUTTON
    local FloatingButton = New("TextButton", { Name = "OpenButton", Size = UDim2.fromOffset(46, 46), Position = UDim2.new(0, 20, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), BackgroundColor3 = Library.Theme.Accent, Text = "L", Font = Enum.Font.GothamBold, TextSize = 18, TextColor3 = Color3.new(1, 1, 1), Visible = false, AutoButtonColor = false, BorderSizePixel = 0 }, ScreenGui)
    Corner(FloatingButton, 12)

    BindDrag(Topbar, Main)
    BindDrag(FloatingButton, FloatingButton)

    -- MINIMIZE / CLOSE LOGIC
    local minimized = false
    Minimize.MouseButton1Click:Connect(function()
        PlaySFX()
        minimized = not minimized
        Tween(Main, { Size = minimized and UDim2.fromOffset(Library.Settings.MenuWidth, 58) or UDim2.fromOffset(Library.Settings.MenuWidth, Library.Settings.MenuHeight) })
        Minimize.Text = minimized and "+" or "—"
        Sidebar.Visible = not minimized
        Content.Visible = not minimized
    end)

    Close.MouseButton1Click:Connect(function()
        PlaySFX()
        Main.Visible = false
        if Library.Settings.FloatingButton then FloatingButton.Visible = true end
    end)

    FloatingButton.MouseButton1Click:Connect(function()
        PlaySFX()
        Main.Visible = true
        FloatingButton.Visible = false
    end)

    -- SEARCH LOGIC
    Search:GetPropertyChangedSignal("Text"):Connect(function()
        if not Library.Settings.TabSearch then return end
        local query = string.lower(Search.Text)
        for _, tab in ipairs(WindowObject.Tabs) do
            tab.Button.Visible = (query == "" or string.find(string.lower(tab.Name), query, 1, true) ~= nil)
        end
    end)

    -- WINDOW REFRESH METHOD
    function WindowObject:Refresh()
        Main.BackgroundColor3 = Library.Theme.Background
        Main.BackgroundTransparency = Library.Theme.Transparency
        MainStroke.Color = Library.Theme.Border
        Topbar.BackgroundColor3 = Library.Theme.Secondary
        Sidebar.BackgroundColor3 = Library.Theme.Secondary
        Content.BackgroundColor3 = Library.Theme.Background
        Title.TextColor3 = Library.Theme.Text
        Subtitle.TextColor3 = Library.Theme.SubText
        Search.BackgroundColor3 = Library.Theme.Tertiary
        Search.TextColor3 = Library.Theme.Text
        FloatingButton.BackgroundColor3 = Library.Theme.Accent
        Watermark.Visible = Library.Settings.Watermark

        Main.Size = UDim2.fromOffset(Library.Settings.MenuWidth, minimized and 58 or Library.Settings.MenuHeight)
        Sidebar.Size = UDim2.new(0, Library.Settings.SidebarWidth, 1, -58)
        Content.Position = UDim2.new(0, Library.Settings.SidebarWidth, 0, 58)
        Content.Size = UDim2.new(1, -Library.Settings.SidebarWidth, 1, -58)
        Scale.Scale = Library.Settings.UIScale / 100

        for _, tab in ipairs(WindowObject.Tabs) do
            tab.Button.BackgroundColor3 = tab.Active and Library.Theme.Tertiary or Library.Theme.Secondary
            tab.Icon.TextColor3 = Library.Theme.Accent
            tab.NameLabel.TextColor3 = Library.Theme.Text
        end
    end

    --==================================================
    -- CREATE TAB
    --==================================================

    function WindowObject:CreateTab(name, icon)
        local Tab = { Name = name, Active = false, Sections = {}, IsSetting = false }
        icon = icon or "●"

        local Button = New("TextButton", { Size = UDim2.new(1, 0, 0, 39), BackgroundColor3 = Library.Theme.Secondary, Text = "", AutoButtonColor = false, BorderSizePixel = 0, LayoutOrder = #WindowObject.Tabs + 1 }, TabList)
        Corner(Button, 8)

        local Icon = New("TextLabel", { Position = UDim2.fromOffset(9, 0), Size = UDim2.fromOffset(25, 39), BackgroundTransparency = 1, Text = icon, Font = Enum.Font.GothamBold, TextSize = 14, TextColor3 = Library.Theme.Accent }, Button)
        local NameLabel = New("TextLabel", { Position = UDim2.fromOffset(39, 0), Size = UDim2.new(1, -47, 1, 0), BackgroundTransparency = 1, Text = name, Font = Enum.Font.GothamMedium, TextSize = 12, TextColor3 = Library.Theme.Text, TextXAlignment = Enum.TextXAlignment.Left }, Button)

        local Page = New("ScrollingFrame", { Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 3, ScrollBarImageColor3 = Library.Theme.Accent, AutomaticCanvasSize = Enum.AutomaticSize.Y, Visible = false, ClipsDescendants = true }, Content)
        New("UIPadding", { PaddingTop = UDim.new(0, 12), PaddingBottom = UDim.new(0, 12), PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12) }, Page)
        New("UIListLayout", { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder }, Page)

        Tab.Button = Button
        Tab.Icon = Icon
        Tab.NameLabel = NameLabel
        Tab.Page = Page
        table.insert(WindowObject.Tabs, Tab)

        function Tab:Activate()
            PlaySFX()
            for _, other in ipairs(WindowObject.Tabs) do
                other.Active = false
                other.Page.Visible = false
                other.Button.BackgroundColor3 = Library.Theme.Secondary
            end
            Tab.Active = true
            Tab.Page.Visible = true
            Tab.Button.BackgroundColor3 = Library.Theme.Tertiary
            WindowObject.CurrentTab = Tab
        end

        Button.MouseButton1Click:Connect(function() Tab:Activate() end)

        -- CREATE SECTION
        function Tab:CreateSection(sectionName)
            local Section = { Name = sectionName }
            local Container = New("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = Library.Theme.Secondary, BackgroundTransparency = Library.Theme.Transparency, BorderSizePixel = 0, ClipsDescendants = true }, Page)
            Corner(Container, Library.Settings.CornerRadius)
            Stroke(Container, Library.Theme.Border)

            local Header = New("TextLabel", { Size = UDim2.new(1, -24, 0, 36), Position = UDim2.fromOffset(12, 0), BackgroundTransparency = 1, Text = sectionName, Font = Enum.Font.GothamBold, TextSize = 13, TextColor3 = Library.Theme.Text, TextXAlignment = Enum.TextXAlignment.Left }, Container)
            local Controls = New("Frame", { Position = UDim2.fromOffset(10, 36), Size = UDim2.new(1, -20, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1 }, Container)
            New("UIListLayout", { Padding = UDim.new(0, 7), SortOrder = Enum.SortOrder.LayoutOrder }, Controls)
            New("UIPadding", { PaddingBottom = UDim.new(0, 10) }, Controls)

            Section.Container = Container
            Section.Header = Header
            Section.Controls = Controls

            -- BUTTON
            function Section:CreateButton(text, callback)
                local Btn = New("TextButton", { Size = UDim2.new(1, 0, 0, 38), BackgroundColor3 = Library.Theme.Tertiary, Text = text, Font = Enum.Font.GothamMedium, TextSize = 12, TextColor3 = Library.Theme.Text, AutoButtonColor = false, BorderSizePixel = 0 }, Controls)
                Corner(Btn, 7)
                Btn.MouseEnter:Connect(function() Tween(Btn, { BackgroundColor3 = Library.Theme.Accent }) end)
                Btn.MouseLeave:Connect(function() Tween(Btn, { BackgroundColor3 = Library.Theme.Tertiary }) end)
                Btn.MouseButton1Click:Connect(function() PlaySFX(); if callback then task.spawn(callback) end end)
                return Btn
            end

            -- TOGGLE
            function Section:CreateToggle(text, default, callback)
                local value = default == true
                local Btn = New("TextButton", { Size = UDim2.new(1, 0, 0, 42), BackgroundColor3 = Library.Theme.Tertiary, Text = "", AutoButtonColor = false, BorderSizePixel = 0 }, Controls)
                Corner(Btn, 8)
                New("TextLabel", { Position = UDim2.fromOffset(12, 0), Size = UDim2.new(1, -70, 1, 0), BackgroundTransparency = 1, Text = text, Font = Enum.Font.GothamMedium, TextSize = 12, TextColor3 = Library.Theme.Text, TextXAlignment = Enum.TextXAlignment.Left }, Btn)

                local Switch = New("Frame", { Position = UDim2.new(1, -50, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), Size = UDim2.fromOffset(38, 20), BackgroundColor3 = value and Library.Theme.On or Library.Theme.SliderBackground, BorderSizePixel = 0 }, Btn)
                Corner(Switch, 10)
                local Circle = New("Frame", { Position = value and UDim2.new(1, -10, 0.5, 0) or UDim2.new(0, 10, 0.5, 0), AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(14, 14), BackgroundColor3 = Color3.new(1,1,1), BorderSizePixel = 0 }, Switch)
                Corner(Circle, 10)

                local function Update()
                    Tween(Switch, { BackgroundColor3 = value and Library.Theme.On or Library.Theme.SliderBackground })
                    Tween(Circle, { Position = value and UDim2.new(1, -10, 0.5, 0) or UDim2.new(0, 10, 0.5, 0) })
                    if callback then task.spawn(callback, value) end
                end

                Btn.MouseButton1Click:Connect(function() PlaySFX(); value = not value; Update() end)
                return { Set = function(_, v) value = v; Update() end, Get = function() return value end }
            end

            -- SLIDER
            function Section:CreateSlider(text, min, max, default, callback)
                min, max = min or 0, max or 100
                local value = math.clamp(default or min, min, max)

                local Frame = New("Frame", { Size = UDim2.new(1, 0, 0, 58), BackgroundColor3 = Library.Theme.Tertiary, BorderSizePixel = 0 }, Controls)
                Corner(Frame, 8)
                New("TextLabel", { Position = UDim2.fromOffset(12, 5), Size = UDim2.new(1, -80, 0, 20), BackgroundTransparency = 1, Text = text, Font = Enum.Font.GothamMedium, TextSize = 12, TextColor3 = Library.Theme.Text, TextXAlignment = Enum.TextXAlignment.Left }, Frame)
                local ValLabel = New("TextLabel", { Position = UDim2.new(1, -65, 0, 5), Size = UDim2.fromOffset(55, 20), BackgroundTransparency = 1, Text = tostring(value), Font = Enum.Font.GothamBold, TextSize = 11, TextColor3 = Library.Theme.Accent, TextXAlignment = Enum.TextXAlignment.Right }, Frame)

                local Bar = New("Frame", { Position = UDim2.fromOffset(12, 35), Size = UDim2.new(1, -24, 0, 6), BackgroundColor3 = Library.Theme.SliderBackground, BorderSizePixel = 0 }, Frame)
                Corner(Bar, 5)
                local Fill = New("Frame", { Size = UDim2.new((value - min)/(max - min), 0, 1, 0), BackgroundColor3 = Library.Theme.Accent, BorderSizePixel = 0 }, Bar)
                Corner(Fill, 5)

                local dragging = false
                local function SetVal(x)
                    if Bar.AbsoluteSize.X <= 0 then return end
                    local pct = math.clamp((x - Bar.AbsolutePosition.X) / Bar.AbsoluteSize.X, 0, 1)
                    value = math.floor(min + (max - min) * pct + 0.5)
                    Fill.Size = UDim2.new((value - min)/(max - min), 0, 1, 0)
                    ValLabel.Text = tostring(value)
                    if callback then task.spawn(callback, value) end
                end

                Bar.InputBegan:Connect(function(inp)
                    if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
                        dragging = true; SetVal(inp.Position.X)
                    end
                end)
                UserInputService.InputChanged:Connect(function(inp) if dragging then SetVal(inp.Position.X) end end)
                UserInputService.InputEnded:Connect(function(inp) dragging = false end)

                return { Set = function(_, v) value = math.clamp(v, min, max); Fill.Size = UDim2.new((value - min)/(max - min), 0, 1, 0); ValLabel.Text = tostring(value); if callback then callback(value) end end }
            end

            -- DROPDOWN
            function Section:CreateDropdown(text, values, default, callback)
                values = values or {}
                local current = default or values[1]
                local Open = false

                local Btn = New("TextButton", { Size = UDim2.new(1, 0, 0, 46), BackgroundColor3 = Library.Theme.Tertiary, Text = "", AutoButtonColor = false, BorderSizePixel = 0 }, Controls)
                Corner(Btn, 8)
                New("TextLabel", { Position = UDim2.fromOffset(12, 3), Size = UDim2.new(1, -24, 0, 18), BackgroundTransparency = 1, Text = text, Font = Enum.Font.GothamMedium, TextSize = 11, TextColor3 = Library.Theme.SubText, TextXAlignment = Enum.TextXAlignment.Left }, Btn)
                local ValText = New("TextLabel", { Position = UDim2.fromOffset(12, 20), Size = UDim2.new(1, -24, 0, 20), BackgroundTransparency = 1, Text = tostring(current or "Select"), Font = Enum.Font.GothamMedium, TextSize = 12, TextColor3 = Library.Theme.Text, TextXAlignment = Enum.TextXAlignment.Left }, Btn)

                local function Clear()
                    for _, c in ipairs(Btn:GetChildren()) do if c:GetAttribute("Option") then c:Destroy() end end
                end

                Btn.MouseButton1Click:Connect(function()
                    PlaySFX()
                    Open = not Open
                    Clear()
                    if Open then
                        Btn.Size = UDim2.new(1, 0, 0, 46 + (#values * 30))
                        for i, opt in ipairs(values) do
                            local OptBtn = New("TextButton", { Position = UDim2.fromOffset(8, 44 + ((i - 1) * 30)), Size = UDim2.new(1, -16, 0, 26), BackgroundColor3 = Library.Theme.Secondary, Text = tostring(opt), Font = Enum.Font.Gotham, TextSize = 11, TextColor3 = Library.Theme.Text, AutoButtonColor = false, BorderSizePixel = 0 }, Btn)
                            OptBtn:SetAttribute("Option", true)
                            Corner(OptBtn, 6)
                            OptBtn.MouseButton1Click:Connect(function()
                                current = opt
                                ValText.Text = tostring(opt)
                                Open = false
                                Btn.Size = UDim2.new(1, 0, 0, 46)
                                Clear()
                                if callback then task.spawn(callback, current) end
                            end)
                        end
                    else
                        Btn.Size = UDim2.new(1, 0, 0, 46)
                    end
                end)

                return { Set = function(_, v) current = v; ValText.Text = tostring(v); if callback then callback(v) end end }
            end

            -- COLOR PICKER
            function Section:CreateColorPicker(text, default, callback)
                local color = default or Color3.fromRGB(255, 255, 255)
                local Frame = New("Frame", { Size = UDim2.new(1, 0, 0, 42), BackgroundColor3 = Library.Theme.Tertiary, BorderSizePixel = 0 }, Controls)
                Corner(Frame, 8)
                New("TextLabel", { Position = UDim2.fromOffset(12, 0), Size = UDim2.new(1, -60, 1, 0), BackgroundTransparency = 1, Text = text, Font = Enum.Font.GothamMedium, TextSize = 12, TextColor3 = Library.Theme.Text, TextXAlignment = Enum.TextXAlignment.Left }, Frame)

                local ColorBox = New("TextButton", { Position = UDim2.new(1, -45, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), Size = UDim2.fromOffset(32, 20), BackgroundColor3 = color, Text = "", AutoButtonColor = false, BorderSizePixel = 0 }, Frame)
                Corner(ColorBox, 6)

                ColorBox.MouseButton1Click:Connect(function()
                    PlaySFX()
                    color = Color3.fromHSV(math.random(), 0.8, 1)
                    ColorBox.BackgroundColor3 = color
                    if callback then task.spawn(callback, color) end
                end)

                return { Set = function(_, c) color = c; ColorBox.BackgroundColor3 = c; if callback then callback(c) end end }
            end

            return Section
        end

        return Tab
    end

    --==================================================
    -- NOTIFICATION SYSTEM
    --==================================================

    function WindowObject:Notify(title, message, duration)
        if not Library.Settings.Notifications then return end
        local Holder = ScreenGui:FindFirstChild("Notifications") or New("Frame", { Name = "Notifications", Position = UDim2.new(1, -20, 0, 20), AnchorPoint = Vector2.new(1, 0), Size = UDim2.fromOffset(300, 400), BackgroundTransparency = 1 }, ScreenGui)
        if not Holder:FindFirstChild("UIListLayout") then New("UIListLayout", { Padding = UDim.new(0, 8), HorizontalAlignment = Enum.HorizontalAlignment.Right }, Holder) end

        local Notif = New("Frame", { Size = UDim2.fromOffset(280, 68), BackgroundColor3 = Library.Theme.Secondary, BorderSizePixel = 0, ClipsDescendants = true }, Holder)
        Corner(Notif, 8)
        Stroke(Notif, Library.Theme.Border)

        New("TextLabel", { Position = UDim2.fromOffset(12, 6), Size = UDim2.new(1, -24, 0, 20), BackgroundTransparency = 1, Text = title, Font = Enum.Font.GothamBold, TextSize = 13, TextColor3 = Library.Theme.Accent, TextXAlignment = Enum.TextXAlignment.Left }, Notif)
        New("TextLabel", { Position = UDim2.fromOffset(12, 26), Size = UDim2.new(1, -24, 0, 35), BackgroundTransparency = 1, Text = message, Font = Enum.Font.Gotham, TextSize = 11, TextColor3 = Library.Theme.Text, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left }, Notif)

        task.delay(duration or 3, function()
            if Notif and Notif.Parent then
                Tween(Notif, { BackgroundTransparency = 1 }, 0.2)
                task.wait(0.22)
                Notif:Destroy()
            end
        end)
    end

    --==================================================
    -- AUTOMATIC SETTING TAB
    --==================================================

    local SettingTab = WindowObject:CreateTab(Library:GetText("Setting"), "⚙")
    SettingTab.IsSetting = true
    SettingTab.Button.LayoutOrder = 999999

    local ThemeSec = SettingTab:CreateSection(Library:GetText("Theme"))
    ThemeSec:CreateDropdown(Library:GetText("ThemePreset"), { "Purple", "Blue", "Red", "Green", "Dark", "Light" }, Library.Settings.ThemePreset, function(v)
        Library:SetTheme(v)
        WindowObject:Notify("Theme", Library:GetText("ThemeChanged") .. v, 2)
    end)

    -- ACCENT COLOR SELECTION (ENGLISH / VIETNAMESE PRESETS)
    local AccentList = {}
    for name, _ in pairs(Library.AccentPresets) do table.insert(AccentList, name) end
    table.sort(AccentList)

    ThemeSec:CreateDropdown(Library:GetText("AccentTheme"), AccentList, Library.Settings.AccentPreset, function(v)
        Library:SetAccent(v)
    end)

    ThemeSec:CreateToggle(Library:GetText("GlassMode"), Library.Settings.GlassMode, function(v)
        Library.Settings.GlassMode = v
        Library.Theme.Transparency = v and (Library.Settings.GlassTransparency / 100) or 0
        Library:RefreshAll()
    end)

    ThemeSec:CreateSlider(Library:GetText("GlassTransparency"), 0, 75, Library.Settings.GlassTransparency, function(v)
        Library.Settings.GlassTransparency = v
        if Library.Settings.GlassMode then
            Library.Theme.Transparency = v / 100
            Library:RefreshAll()
        end
    end)

    local SizeSec = SettingTab:CreateSection(Library:GetText("MenuSize"))
    SizeSec:CreateSlider(Library:GetText("MenuWidth"), 400, 900, Library.Settings.MenuWidth, function(v) Library.Settings.MenuWidth = v; WindowObject:Refresh() end)
    SizeSec:CreateSlider(Library:GetText("MenuHeight"), 280, 700, Library.Settings.MenuHeight, function(v) Library.Settings.MenuHeight = v; WindowObject:Refresh() end)
    SizeSec:CreateSlider(Library:GetText("SidebarWidth"), 110, 250, Library.Settings.SidebarWidth, function(v) Library.Settings.SidebarWidth = v; WindowObject:Refresh() end)

    local BehaviorSec = SettingTab:CreateSection(Library:GetText("Behavior"))
    BehaviorSec:CreateToggle(Library:GetText("SoundEffects"), Library.Settings.SoundEffects, function(v) Library.Settings.SoundEffects = v end)
    BehaviorSec:CreateToggle(Library:GetText("Watermark"), Library.Settings.Watermark, function(v) Library.Settings.Watermark = v; WindowObject:Refresh() end)
    BehaviorSec:CreateToggle(Library:GetText("TabSearch"), Library.Settings.TabSearch, function(v) Library.Settings.TabSearch = v; Search.Visible = v end)
    BehaviorSec:CreateToggle(Library:GetText("Notifications"), Library.Settings.Notifications, function(v) Library.Settings.Notifications = v end)

    -- LANGUAGE SWITCHER (SUPPORTING ALL 7 LANGUAGES)
    local LangSec = SettingTab:CreateSection(Library:GetText("Language"))
    LangSec:CreateDropdown(Library:GetText("Language"), { "Vietnamese", "English", "Spanish", "French", "German", "Chinese", "Japanese" }, Library.Settings.Language, function(v)
        Library:SetLanguage(v)
        WindowObject:Notify("Language", Library:GetText("LanguageChanged") .. v, 2)
    end)

    -- CONFIGS & RESET
    local ConfigSec = SettingTab:CreateSection(Library:GetText("Configs"))
    ConfigSec:CreateButton(Library:GetText("ResetUI"), function()
        for k, v in pairs(Library.DefaultSettings) do Library.Settings[k] = v end
        Library:SetTheme("Purple")
        Library:SetAccent("Purple / Tím")
        WindowObject:Refresh()
        WindowObject:Notify("Settings", Library:GetText("SettingsReset"), 2)
    end)

    ConfigSec:CreateButton(Library:GetText("Unload"), function() Library:Destroy() end)

    table.insert(Library.Windows, WindowObject)
    WindowObject:Refresh()

    return WindowObject
end

--==================================================
-- DESTROY
--==================================================

function Library:Destroy()
    if Library.Unloaded then return end
    Library.Unloaded = true
    for _, win in ipairs(Library.Windows) do
        if win.ScreenGui then pcall(function() win.ScreenGui:Destroy() end) end
    end
    table.clear(Library.Windows)
end

return Library
