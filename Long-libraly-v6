--==================================================
-- HELPERS
--==================================================

local function New(className, properties, parent)
    local object = Instance.new(className)
    for k, v in pairs(properties or {}) do
        pcall(function() object[k] = v end)
    end
    if parent then object.Parent = parent end
    return object
end

local function Corner(object, radius)
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, radius or Library.Settings.CornerRadius)
    corner.Parent = object
    return corner
end

local function Stroke(object, color, thickness)
    local stroke = Instance.new("UIStroke")
    stroke.Color = color or Library.Theme.Border
    stroke.Thickness = thickness or 1
    stroke.Parent = object
    return stroke
end

local function Tween(object, properties, duration)
    duration = duration or Library.Settings.AnimationSpeed
    local tween = TweenService:Create(object, TweenInfo.new(duration, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), properties)
    tween:Play()
    return tween
end

local function PlaySFX(id)
    if not Library.Settings.SoundEffects then return end
    local sound = Instance.new("Sound")
    sound.SoundId = "rbxassetid://" .. tostring(id or 6895079853)
    sound.Volume = 0.5
    sound.Parent = SoundService
    sound:Play()
    sound.Ended:Connect(function() sound:Destroy() end)
end

local function BindDrag(frame, target)
    local dragging, dragStart, startPosition
    local function update(input)
        if not dragStart or not startPosition then return end
        local delta = input.Position - dragStart
        target.Position = UDim2.new(startPosition.X.Scale, startPosition.X.Offset + delta.X, startPosition.Y.Scale, startPosition.Y.Offset + delta.Y)
    end
    frame.InputBegan:Connect(function(input)
        if not Library.Settings.Dragging then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPosition = target.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            update(input)
        end
    end)
end

--==================================================
-- TRANSLATION ENGINE
--==================================================

function Library:GetText(key)
    local lang = Library.Languages[Library.Settings.Language]
    if lang and lang[key] then return lang[key] end
    return Library.Languages.English[key] or key
end

function Library:RegisterText(object, key)
    Library.RegisteredTexts[object] = key
    object.Text = Library:GetText(key)
end

function Library:SetLanguage(language)
    if not Library.Languages[language] then return false end
    Library.Settings.Language = language
    for obj, key in pairs(Library.RegisteredTexts) do
        if obj and obj.Parent then
            pcall(function() obj.Text = Library:GetText(key) end)
        else
            Library.RegisteredTexts[obj] = nil
        end
    end
    Library:RefreshAll()
    return true
end

--==================================================
-- THEME & ACCENT SETTERS
--==================================================

function Library:SetTheme(theme)
    if type(theme) == "string" then
        local preset = Library.ThemePresets[theme]
        if not preset then return false end
        Library.Settings.ThemePreset = theme
        for k, v in pairs(preset) do Library.Theme[k] = v end
    elseif type(theme) == "table" then
        Library.Settings.ThemePreset = "Custom"
        for k, v in pairs(theme) do
            if Library.Theme[k] ~= nil then Library.Theme[k] = v end
        end
    end
    Library:RefreshAll()
    return true
end

function Library:SetAccent(name)
    local color = Library.AccentPresets[name]
    if not color then return false end
    Library.Theme.Accent = color
    Library.Settings.AccentPreset = name
    Library:RefreshAll()
    return true
end

function Library:SetColor(name, r, g, b)
    if Library.Theme[name] == nil then return false end
    Library.Theme[name] = Color3.fromRGB(math.clamp(tonumber(r) or 0, 0, 255), math.clamp(tonumber(g) or 0, 0, 255), math.clamp(tonumber(b) or 0, 0, 255))
    Library.Settings.ThemePreset = "Custom"
    Library:RefreshAll()
    return true
end

function Library:RefreshAll()
    for _, window in pairs(Library.Windows) do
        if window.Refresh then pcall(function() window:Refresh() end) end
    end
end

